<?xml version="1.0" encoding="utf-8"?><Database>
    <GameDBStringTable ID="LOC_PTBR_CAMPAIGN_BEASTMASTERS_LVL1">

        <LanguageRef>LANG_PTBR</LanguageRef>

        <Contributors>
            <Name>Felipe Augusto "DeltaCadimus" Godoy de Souza</Name>
        </Contributors>

        <LocalizedStrings>
            <!--OBJECTIVES MAIN QUESTS-->
            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_BEASTMASTERS_LVL1_START</LocID>                   <Text>Começe a ofensiva</Text>  </GameDBLocalizedString>
          
            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_BEASTMASTERS_LVL1_SECOND_BASE_1</LocID>           <Text>Ataque as posições dos Filhos da Fonte 0/2</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_BEASTMASTERS_LVL1_SECOND_BASE_2</LocID>           <Text>Ataque as posições dos Filhos da Fonte 1/2</Text>  </GameDBLocalizedString>
            
            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_BEASTMASTERS_LVL1_GET_SETRI_TO_ELEVATOR</LocID>   <Text>Alcançe o transportador orbital</Text>  </GameDBLocalizedString>

            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_BEASTMASTERS_LVL1_RETAKE_X_BASE</LocID>           <Text>Capture a base Xenauri </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_BEASTMASTERS_LVL1_RETAKE_X_BASE_DONE</LocID>      <Text><![CDATA[<color=SOTS_COLOR_MOVEMENT>Capture a base Xenauri - CONCLUIDO</color>]]></Text>  </GameDBLocalizedString>

            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_BEASTMASTERS_LVL1_FIND_WAY_SURFACE</LocID>        <Text>Saia do subterrâneo</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_BEASTMASTERS_LVL1_FIND_WAY_SURFACE_DONE</LocID>   <Text><![CDATA[<color=SOTS_COLOR_MOVEMENT>Saia do subterrâneo - CONCLUIDO</color>]]></Text>  </GameDBLocalizedString>

            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_BEASTMASTERS_LVL1_INBARK_1</LocID>                <Text>Traga seus Comandantes a bordo 0/2</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_BEASTMASTERS_LVL1_INBARK_2</LocID>                <Text>Traga seus Comandantes a bordo 1/2</Text>  </GameDBLocalizedString>
          
            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_BEASTMASTERS_LVL1_FOS_BASE_1</LocID>                <Text>Conquiste as Bases Fossorianas 0/3</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_BEASTMASTERS_LVL1_FOS_BASE_2</LocID>                <Text>Conquiste as Bases Fossorianas 1/3</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_BEASTMASTERS_LVL1_FOS_BASE_3</LocID>                <Text>Conquiste as Bases Fossorianas 2/3</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_BEASTMASTERS_LVL1_FOS_BASE_4</LocID>                <Text><![CDATA[<color=SOTS_COLOR_MOVEMENT>Conquiste as Bases Fossorianas 3/3 - CONCLUIDO</color>]]> </Text>  </GameDBLocalizedString>
            
            <!--DIALOGUES-->
            <!--Se-Wari and Se-Tri are standing near their base.   -->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_START_NARRATOR_0</LocID>          <Text>AVISO - A DLC "Nômades Xenauri" se coloca após os eventos de "Silence of the Siren", a campanha do jogo original.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_START_NARRATOR_1</LocID>          <Text>Planeta Scylla, próxima a recem-estabelecida base dianteira da força de pouso Xenauri.   </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_START_T_1</LocID>                 <Text>Guardem as ferramentas! Vamos partir na ofensiva! A tempestade começou! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_START_W_1</LocID>                 <Text>Isso é loucura, nós mal começamos a construir esse campo! Não estamos prontos!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_START_T_2</LocID>                 <Text>Silêncio! Está se dirigindo a uma Guarda Altari do Trilhador! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_START_W_2</LocID>                 <Text>Difícil esquecer, irmã... </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_START_T_3</LocID>                 <Text>Como é que é? </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_START_W_3</LocID>                 <Text>Nada, Ó Poderosa.  </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_START_T_4</LocID>                 <Text>Fomos confiados com capturar as posições dos Insetos-de-Ferro aqui...</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_START_T_5</LocID>                 <Text>... e aqui. Eu liderarei o ataque. Você cuida da logística! Fracassar será uma traição ao Trilhador! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_START_W_4</LocID>                 <Text>[PRA SÍ MESMA] ...uma legítima fanática. </Text>  </GameDBLocalizedString>
            
            <!--First encounter with the Iron Insect warrior (Children of the Source) hero.-->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_CHILDREN_ENC_RH_1</LocID>         <Text>É um guerreiro Inseto-de-Ferro!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_CHILDREN_ENC_KNIGHT_1</LocID>     <Text>[FALANDO LINGUA ESTRANHA, LEVEMENTE DISTORCIDA POR SONS DE METAL] </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_CHILDREN_ENC_W_1</LocID>          <Text>Ele está tentando negociar? Talvez haja alguma forma de nos comunicarmos! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_CHILDREN_ENC_T_2</LocID>          <Text>São só robôs sem alma! O Trilhador ordenou o extermínio deles! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_CHILDREN_ENC_W_2</LocID>          <Text>E desde o dia que se juntou a Guarda Dele, sua palavra virou lei. [PRA SÍ MESMA] Com ou sem bom senso... </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_CHILDREN_ENC_KNIGHT_2</LocID>     <Text>[SONS METÁLICOS FORTES] </Text>  </GameDBLocalizedString>
           
            <!--Iron Insect warrior is defeated.-->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_ARTAR_DEFEATED_W_1</LocID>        <Text>Descanse agora, Inseto-de-Ferro. Que você encontre a paz.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_ARTAR_DEFEATED_T_1</LocID>        <Text>Os Insetos-de-Ferro não são páreos a Guarda Altari do Trilhador!</Text>  </GameDBLocalizedString>

            <!--First base of the Children of the Source is conquered.  -->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_FIRST_FORTRESS_IS_CONQUERED_RH_1</LocID>   <Text>A primeira posição é nossa!  </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_FIRST_FORTRESS_IS_CONQUERED_T_2</LocID>    <Text>A primeira posição foi tomada em nome do Trilhador. Assim que tivermos a segunda, a costa será nossa!    </Text>  </GameDBLocalizedString>

            <!--At the start of the next game turn, Se-Wari notise a bright flash in the sky. -->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_EXPLOSION_FORESHADOWED_W_1</LocID>         <Text>Vejo clarões fortes nas núvens acima! Mas nunca vi uma tempestade dessas!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_EXPLOSION_FORESHADOWED_T_1</LocID>         <Text>Não é tempestade, sua tola. É a Nave-Mãe! Está bombardeando o setor vizinho!   </Text>  </GameDBLocalizedString>

            <!--At the start of the next game turn, flashes intensifies. -->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SETRI_SUMMONED_W_</LocID>         <Text>Os clarões ficaram mais fortes!   </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SETRI_SUMMONED_T_1</LocID>        <Text>A Nave-Mãe está sendo atacada! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SETRI_SUMMONED_W_2</LocID>        <Text>Como consegue ver isso daqui?! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SETRI_SUMMONED_T_3</LocID>        <Text>A conexão... Preciso voltar a nave.  Para o Altar de Cristal! </Text>  </GameDBLocalizedString>
            
            <!--Se-Tri arrives to the teleport but befor she can enter and debris from the Mothership struck the place. She teleports Se-Wari out of harms way just in time.  -->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_TELEPORT_CRASH_RH_1</LocID>       <Text>Estamos quase lá... QÛE?! ESSE CLARÃO FOI MUITO FORTE PRA UMA ARMA QUALQUER! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_TELEPORT_CRASH_T_1</LocID>        <Text>A Nave-Mãe! A conexão com o Altar de Cristal! ... Não me sinto bem.   </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_TELEPORT_CRASH_W_1</LocID>        <Text>Se-Tri?... Você está bem?  </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_TELEPORT_CRASH_T_3</LocID>        <Text>Não... Não estou... Onde estou?! Não se aproxime!    </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_TELEPORT_CRASH_W_3</LocID>        <Text>Se-Tri, eu... que som é esse?! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_TELEPORT_CRASH_W_4</LocID>        <Text>Tem algo caindo em nossa direção! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_TELEPORT_CRASH_T_4</LocID>        <Text>NÃO!</Text>  </GameDBLocalizedString>

            <!--Se-Wari appears in the underground and is immediately surrounded by Fossorians.-->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEWARI_CAPTURED_W_1</LocID>           <Text>...ela me transportou pra me salvar?</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEWARI_CAPTURED_FOSSORIAN_2</LocID>   <Text>[FALANDO EM LÍNGUA ESTRANHA, DISTORCIDA LEVEMENTE PELO FORMATO NÃO-HUMANO DA BOCA]</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEWARI_CAPTURED_W_2</LocID>           <Text>Ou talvez me mandou em outro tipo de encrenca.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEWARI_CAPTURED_W_3</LocID>           <Text>Grande encrenca! </Text>  </GameDBLocalizedString>
            
            <!--In a small cave Se-Wari chat with Captain Pick (the only Sovereign fleet hero of Fossorain descend). In the middle of the conversation the Fossorian hero Bokas arrives. -->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PICK_AND_SEWARI_NARRATOR_1</LocID>       <Text>Alguns dias depois. Subsolo.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PICK_AND_SEWARI_P_1.5</LocID>            <Text>...aprende bem rápido, mocinha, porém...  </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PICK_AND_SEWARI_BOKAS_1</LocID>          <Text>Não tô te pagando pra bater papo, Pick! É pra você interrogar ela sobre os Artefatos!  </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PICK_AND_SEWARI_W_2</LocID>              <Text>Artefatos?        </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PICK_AND_SEWARI_P_3</LocID>              <Text>Tecnologia Xenauri que achamos nos detritos de sua Nave-Mãe...  </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PICK_AND_SEWARI_W_5</LocID>              <Text>Detritos!? A NAVE-MÃE FOI DESTRUIDA?!       </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PICK_AND_SEWARI_BOKAS_2</LocID>          <Text>Cala a boca, vocês dois! Só os Artefatos me interessam! Ninguém sabe como usá-los! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PICK_AND_SEWARI_W_6</LocID>              <Text>Não vou poder ajudar vocês... </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PICK_AND_SEWARI_BOKAS_3</LocID>          <Text>A dor vai desenrolar sua lingua...</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PICK_AND_SEWARI_W_7</LocID>              <Text>PARA! ISSO DÓI!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PICK_AND_SEWARI_BOKAS_4</LocID>          <Text>Você provocou isso!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PICK_AND_SEWARI_P_9</LocID>              <Text>Já chega, Bokas! Pare!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PICK_AND_SEWARI_P_10</LocID>             <Text>MANDEI PARAR!  </Text>  </GameDBLocalizedString>
            
            <!--Pick decide to help Se-Wari and they defeat Bokas.  -->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEWARI_LIBERATED_BOKAS_1</LocID>     <Text>[TO THE RADIO] Amigos, me ajudem! Os prisioneiros estão fugindo!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEWARI_LIBERATED_TOTT_1</LocID>      <Text>Tá chamando quem de amigo, seu canalha?!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEWARI_LIBERATED_MOLTAIR_1</LocID>   <Text>É, sua pilha de bosta-de-verme ambulante!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEWARI_LIBERATED_BENI_1</LocID>      <Text>Eu irei te ajudar, Bokas, meu querido amigo!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEWARI_LIBERATED_BOKAS_3</LocID>     <Text>Ah não, você não! Prefiro morrer do que ser salvo por um mestiço imundo! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEWARI_LIBERATED_P_1</LocID>         <Text>[COMUNICADOR DESLIGADO] ...Bem melhor.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEWARI_LIBERATED_W_1</LocID>         <Text>Pick, eu...  </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEWARI_LIBERATED_P_2</LocID>         <Text>Poupe seus elogios, garota. Gosto de você, mas não quer dizer que sejamos amigos... também estou atrás dos artefatos Xenauri. Se eu te tirar daqui, você me ensina a usá-los. De acordo?    </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEWARI_LIBERATED_W_2</LocID>         <Text>Vou lhe contar tudo o que eu sei... com uma condição: me ajude a achar a minha irmã. Ela é uma Altari, então ela irá estar bem... mas preciso ter certeza.  </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEWARI_LIBERATED_P_3</LocID>         <Text>Altari? </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEWARI_LIBERATED_W_3</LocID>         <Text>Quer dizer algo como um psíquico. E ela é uma da Guarda Altari do Trilhador, então ela é exceptionalmente dotada. </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEWARI_LIBERATED_P_4</LocID>         <Text>Psíquica, você diz? Pois bem! Temos um acordo. Agora, meus irmãos peludos tiraram tantos destroços de sua Nave-Mãe que dá pra começar a construir uma base aqui em baixo! </Text>  </GameDBLocalizedString>

            <!--At the start of the next game turn, Se-Wari asks Pick how he joined Fossorians. -->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PICK_REASONING_W_1</LocID>        <Text>Antes, você tinha dito que foi contratado pra me ensinar?  </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PICK_REASONING_P_1</LocID>        <Text>Me pegaram bisbilhotando perto dos destroços. Então eu disse que queria me juntar a eles, e esperei a chance sair de fininho.  </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PICK_REASONING_W_2</LocID>        <Text>Acho que "de fininho" já não é mais opção.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PICK_REASONING_P_2</LocID>        <Text>Não me diga, mas fique tranquila. O Velho Pick aqui ainda sabe qual parte do Martelo se segura.   </Text>  </GameDBLocalizedString>

            <!--First Fossorian hero defeated -->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_ELEVATOR_INFO_P_1</LocID>         <Text>Agora que temos a base, temos uma chance de alcançar o elevador que leva a superfície. </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_ELEVATOR_INFO_W_1</LocID>         <Text>E assim que chegarmos lá?  </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_ELEVATOR_INFO_P_2</LocID>         <Text>Não vai ficar mais fácil, menina, mas tenho alguns tripulantes e uma nave rápida escondida nas rochas.  </Text>  </GameDBLocalizedString>
            
            <!-- After they escape the underground, Se-Wari disscus with Pick their nex move.-->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SURFACE_RH_1</LocID>              <Text>Superfície! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SURFACE_W_1</LocID>               <Text>Maldição, estamos bem longe do lugar onde a minha irmã e eu nos separamos... </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SURFACE_P_1</LocID>               <Text>Não é tão longe assim, mas conheço a área, e a minha nave é a única forma de chegar até lá.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SURFACE_P_2</LocID>               <Text>Então, hora de chamar a tripulação. Só espero que não tenham corrido enquanto eu estava entalado lá embaixo.  </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SURFACE_P_3</LocID>               <Text>Freddie, Alfa!  Cambada de preguiçosos!  Estão me ouvindo!? </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SURFACE_FREDDIE_1</LocID>         <Text>Te ouvimos sim, chefe! A gente nunca iria sair sem você! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SURFACE_ALFA_1</LocID>            <Text>Então, devo deletar as gravações de toda a semana de você choramingando de querer voar pra longe, Freddie?   </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SURFACE_FREDDIE_2</LocID>         <Text>Aê, Alfa, vai tomar no seu- </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SURFACE_P_4</LocID>               <Text>Calem a boca, idiotas! Estamos indo até vocês. </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SURFACE_ALFA_2</LocID>            <Text>"Estamos"?  </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SURFACE_P_5</LocID>               <Text>É, tô com companhia aqui. Uma Xenauri.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SURFACE_FREDDIE_3</LocID>         <Text>Xenauri?   </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SURFACE_ALFA_3</LocID>            <Text>Os alienígenas, Freddie! A Rede Soberana não fala mais nada além disso faz uma semana. Talvez se não ficasse só no Tetris o dia todo...  </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SURFACE_FREDDIE_4</LocID>         <Text>Você vive de causar vergonha, não é, Alfa? </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SURFACE_P_6</LocID>               <Text>[CLICK OF COMMUNICATOR BEING SHUT DOWN]... Pensar que paguei desconto por esses dois... Lição aprendida. </Text>  </GameDBLocalizedString>
            
            <!--Our heroes discover a second Xenauri base. -->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SURFACE_BASE_RH_1</LocID>         <Text>Outro lugar onde os Fossorianos juntaram destroços. Um lugar ideal pra começar outra base.</Text>  </GameDBLocalizedString>

            <!--Suddenly, a radio transmission starts. The Pathfinder briefly appears on screen.-->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PATH_CALL_PATHFINDER_1</LocID>    <Text>[SINAL DISTORCIDO]... Minha Guarda Altari ... [SINAL DISTORCIDO] ... confusos ... [SINAL DISTORCIDO] ... sétimo planeta deste sistema ... [SINAL DISTORCIDO] ... coordenadas 0-6-0-3... </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PATH_CALL_P_1</LocID>             <Text>O sétimo planeta... Ele está falando de Chimera! Mas quem essa esse? </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PATH_CALL_W_1</LocID>             <Text>O Trilhador. Guardião do Altar de Cristal. Ele e a sua Guarda Altari unificaram os Clãs do meu mundo-natal.    </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PATH_CALL_P_2</LocID>             <Text>Então ele é tipo o mais forte dos Altari?</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PATH_CALL_W_3</LocID>             <Text>Não, não é. Mas a Guarda Altari é fanaticamente leal a ele. </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PATH_CALL_P_3</LocID>             <Text>Que interessante.</Text>  </GameDBLocalizedString>


            <!--Suddenly, a radio transmission starts. The Se-Tri briefly appears on screen.-->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SETRI_CALL_SETRI_1</LocID>        <Text>...[SINAL DISTORCIDO]...</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SETRI_CALL_W_1</LocID>            <Text>Se-Tri?!... Maldição! Caiu no silêncio de novo! Ela ainda deve estar presa em algum lugar ao norte da costa! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SETRI_CALL_P_1</LocID>            <Text>Parece preocupada. Você não disse que ela é uma Altari? </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SETRI_CALL_W_2</LocID>            <Text>Sim, mas algo mudou nela depois que a Nave-Mãe foi destruida.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SETRI_CALL_P_2</LocID>            <Text>Quer dizer que ela perdeu os poderes, é? </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SETRI_CALL_W_3</LocID>            <Text>Não, mas ela parecia confusa, até assustada... Desde que ela entrou pra Guarda, quase me esqueci que ela podia ainda se assustar... Ela tinha mudado tanto... Por que todas essas perguntas sobre ela?</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SETRI_CALL_P_4</LocID>            <Text>Curiosidade, só isso. </Text>  </GameDBLocalizedString>

            <!--Se-Wari approach a crystal biom part of the map.-->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_CRYSTALS_W_1</LocID>              <Text>Esses cristais me lembram do meu planeta. Montanhas de cristais, desertos de cristais, cavernas de cristais... basicamente só isso. Cristais e lagartos Ssaari.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_CRYSTALS_P_2</LocID>              <Text>Seu mundo parece ser um lugar difícil de viver...  </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_CRYSTALS_W_2</LocID>              <Text>Sim, está praticamente morto. Mas as velhas pinturas registram o que estou vendo aqui. Árvores, grama, rochas, água... até os estranhos monolitos que estamos vendo, agora.        </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_CRYSTALS_P_3</LocID>              <Text>Ruinas dos Primais antigos? No seu planeta?</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_CRYSTALS_W_3</LocID>              <Text>Mas somente naquelas pinturas. Fora isso, cristais até onde posso ver... esse é o único mundo que conheço. </Text>  </GameDBLocalizedString>

            <!--Near the Pick's ship.-->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEW_CONFESSION_P_1</LocID>        <Text>A nave! Não está muito longe! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEW_CONFESSION_W_1</LocID>        <Text>Pick, não fui totalmente sincera com você. Os artefatos da Nave-Mãe Xenauri-</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEW_CONFESSION_P_2</LocID>        <Text>Não vão funcionar.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEW_CONFESSION_W_2</LocID>        <Text>...como você sabe?</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEW_CONFESSION_P_3</LocID>        <Text>Se não dá pra ver uma interface, não quer dizer que não exista uma. E um psíquico... Quer dizer, um Altari pode ver o que os outros não podem, não é? </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEW_CONFESSION_W_3</LocID>        <Text>Sim... Então por que está me ajudando? </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEW_CONFESSION_P_4</LocID>        <Text>Garota esperta. Gosto de você, mas não quer dizer que sejamos amigos... existe outro motivo, também. Irei explicar assim que estivermos seguros na nave.</Text>  </GameDBLocalizedString>
            
            <!--At the surface, our heroes encounter Long Molly a Fossorian main commander of the area.  -->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SHIP_FOSS_BASES_MOLLY_1</LocID>   <Text>Seus dois idiotas, vocês estragaram tudo! Minha base subterrânea está em chamas! Os artefatos que meus Fossorianos pegaram não valem nada, e agora estou com relatórios de naves NUSS em órbita geo-estacionária sobre nós! Aposto meu martelo que isso também foi obra de vocês!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SHIP_FOSS_BASES_P_1</LocID>       <Text>A NUSS?! Acorda pra vida, nunca trabalharia pra eles!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SHIP_FOSS_BASES_MOLLY_2</LocID>   <Text>Essa mentira é do tamanho do meu martelo! E não tá escrito "tonta" na minha cara! Sei que estão com alguma nave escondida em algum lugar! Mesmo que decolem, minha artilharia anti-aérea vai derrubar vocês!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SHIP_FOSS_BASES_P_2</LocID>       <Text>Essa artilharia vai ser um problema, assim como essas naves da NUSS.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SHIP_FOSS_BASES_W_2</LocID>       <Text>NUSS? </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SHIP_FOSS_BASES_P_3</LocID>       <Text>O maior bando de cuzões daqui, que acham que mandam em tudo. Mas a Princesa os mantem em uma coleira curta. Ao menos por ora. </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SHIP_FOSS_BASES_W_3</LocID>       <Text>Quem é essa Princesa? </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SHIP_FOSS_BASES_P_4</LocID>       <Text>Uma psíquica alienígena poderosa... tipo a sua Altari! Mas fique tranquila, a gente é peixe pequeno pra ela. Ok, chega de papo. Essa artilharia anti-aérea não vai se desativar sozinha. </Text>  </GameDBLocalizedString>

            <!--Both Fossorian bases are conquered.  -->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SHIP_FLY_RH_1</LocID>             <Text>As bases são nossas! As armas anti-aéreas foram desativadas! Agora podemos fugir! </Text>  </GameDBLocalizedString>

            <!--Long Molly is defeated. -->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_MOLLY_AF_MOLLY_1</LocID>          <Text>Toda vez que construo algo pra mim, algum idiota aparece e estraga tudo!</Text>  </GameDBLocalizedString>

            <!--The first Fossorian base is conquered. -->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_LAST_BASE_RH_1</LocID>            <Text>Apenas uma base faltando.</Text>  </GameDBLocalizedString>

            <!--Molly spawns before the remaining Fossorian base to face our heroes. -->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_MOLLY_SPAWN_RH_1</LocID>          <Text>A última base! Assim que as armas anti-aéreas forem desativadas, poderemos voar! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_MOLLY_SPAWN_MOLLY_1</LocID>       <Text>Não se o meu martelo tiver algo a dizer! </Text>  </GameDBLocalizedString>
            
            <!--The Pick's ship was reached by one of the heroes before the both Fossorian bases were conquered.  -->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_CANNOT_BOARD_RH_1</LocID>         <Text>Ainda não dá pra decolar. As armas anti-aéreas nas bases Fossorianas ainda estão ligadas. </Text>  </GameDBLocalizedString>
            
            <!--The Pick's ship was reached by one of the heroes after the both Fossorian bases were conquered.  -->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_NEAR_SHIP_RH_1</LocID>            <Text>Cheguei até a nave. </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_NEAR_SHIP_RH_2</LocID>            <Text>Certo, vá pra dentro e me aguarde.</Text>  </GameDBLocalizedString>

            <!--End, our heroes speaks on board of the Pick's ship. Freddi and Alfa are also present on board. -->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_P_1</LocID>                   <Text>Olá, crianças, Titio Pick chegou- TIRA ESSE PÉ IMUNDO DO MEU PAINEL, FREDDIE!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_FREDDIE_1</LocID>             <Text>Sim, meu capitão, almirante, meu chefe Todo Poderoso!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_ALFA_1</LocID>                <Text>Que bom, vocês dois chegaram. Enquanto aguardávamos, recolhemos um monte de artefatos dos destroços da nave Xenauri. Porém... </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_FREDDIE_2</LocID>             <Text>...droga, não tem botão nenhum pra gente mexer, chefia!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_ALFA_2</LocID>                <Text>Mas foi pra isso que trouxe a Xenauri, não é?</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_P_2</LocID>                   <Text>Esqueça essa tralha Xenauri por ora! Primeiro, a gente precisa descobrir o que houve com a irmã dela. Temos que ir ao norte...  </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_FREDDIE_3</LocID>             <Text>Bem, sobre isso... NÃO. Nem ferrando, chefia! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_P_3</LocID>                   <Text>Sério, Freddie, explique-me por que!?</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_ALFA_3</LocID>                <Text>As forças da NUSS ocuparam toda a costa norte...</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_FREDDIE_4</LocID>             <Text>E a Chiquita! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_P_4</LocID>                   <Text>Que Chiquita?! Que papo é esse?! Para de falar coisa sem noção e finja que saiu do jardim de infância! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_FREDDIE_5</LocID>             <Text>A Chiquita pousou com eles. E advinha quem tava pilotando? A PRINCESA, cacete! Três metros de altua, carapaça, poderes psíquicos! Já dei de cara com ela certa vez e...</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_ALFA_4</LocID>                <Text>...suas calças nunca mais foram as mesmas. Sabemos disso, Freddie. Mas a Princesa partiu pouco depois. </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_W_2</LocID>                   <Text>A Princesa deve ter sentido os poderes de Se-Tri e pegou ela!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_P_5</LocID>                   <Text>Primeiro temos que ter certeza. Mas receio que tenha acertado essa na mosca, garota. Temos que descobrir onde a Princesa levou ela. </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_FREDDIE_6</LocID>             <Text>QUÊ?! Por que?!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_P_6</LocID>                   <Text>Cala boca, Freddie!  A irmã dela é Altari, que quer dizer "psíquica poderosa"! Até agora, a Princesinha manteve um monopólio na “magia”. Isso tem que mudar!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_W_3</LocID>                   <Text>Então ESSE é o motivo! Por isso ficou perguntando sem parar dos Altari e da minha irmã!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_P_7</LocID>                   <Text>Graças aos poderes dela, a Princesa tem um controle absoluto nas viagens espaciais a longa-distância. Então, ela mantem o poder sobre cada facção majoritária no sistema. </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_ALFA_5</LocID>                <Text>Também não gosto dela, mas as facções pararam com as lutas desde que ela assumiu.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_P_8</LocID>                   <Text>Mas por quanto tempo essa "paz" durar depende só DELA! Imagine, todo mundo poder viajar pra onde quiser! Novos mundos estão lá, esperando pra serem descobertos! Isso seria...  </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_FREDDIE_7</LocID>            <Text>O maior sonho de um Soberano se realizando!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_ALFA_6</LocID>                <Text>E os psíquicos Xenauri são a chave. </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_W_4</LocID>                   <Text>Pick, eu...   </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_P_9</LocID>                   <Text>Poupe sua gratidão, garota. Acabamos de decidir encarar o ser mais perigoso do Sistema Siren. Talvez a gente se arrependa disso antes que acabe.   </Text>  </GameDBLocalizedString>

            <!--Enemy FOSSORIAN COMMANDERS - QOUTES-->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_BENNI_BF_BENNI_1</LocID>          <Text>Vou destruir vocês pelo meu amigo, Bokas!</Text>  </GameDBLocalizedString>
            
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_MOLTAIR_BF_MOLTAIR_1</LocID>      <Text>Eu sou Moltair! Ex-Comandante da Divisão de Libertadores! Vencedor de inúmeras batalhas... </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_MOLTAIR_BF_P_1</LocID>            <Text>...das quais ninguém ouviu falar.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_MOLTAIR_BF_X_1</LocID>            <Text>Você é tão barulhento pra uma criatura tão pequena! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_MOLTAIR_BF_MOLTAIR_2</LocID>      <Text>Arrgh!!! Vocês nunca verão o sol de novo! </Text>  </GameDBLocalizedString>

            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_TOTT_BF_QUETIN_1</LocID>          <Text>Ola, sou Quetin, de Moletargis! </Text>  </GameDBLocalizedString>
 
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_TOTT_BF_TOTT_1</LocID>            <Text>Sua pequena fuga de prisão termina aqui!    </Text>  </GameDBLocalizedString>
            
        </LocalizedStrings>
    </GameDBStringTable>
</Database>
