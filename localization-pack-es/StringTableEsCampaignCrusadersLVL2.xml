<?xml version="1.0" encoding="utf-8"?><Database>
    <GameDBStringTable ID="LOC_ES_CAMPAIGN_CRUSADERS_LVL2">

        <LanguageRef>LANG_ES</LanguageRef>

        <Contributors>
            <Name>Oxymoron Games</Name>
        </Contributors>

        <LocalizedStrings>
            <!--OBJECTIVES MAIN QUESTS-->
            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_CRUSADERS_STARTIN_LVL2</LocID>                    <Text>Habla con el gran Zieregal</Text>  </GameDBLocalizedString>

            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_CRUSADERS_LVL2_BASE_GATE</LocID>                  <Text>Visita la base cercana</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_CRUSADERS_LVL2_BASE_GATE_DONE</LocID>             <Text><![CDATA[<color=SOTS_COLOR_MOVEMENT>Visita la base cercana - Terminada</color>]]></Text>  </GameDBLocalizedString>


            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_CRUSADERS_LVL2_GET_TO_FORTRESS</LocID>            <Text>Llega a la fortaleza de los Zieregales</Text>  </GameDBLocalizedString>
           
            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_CRUSADERS_LVL2_DEFEAT_PIRATES</LocID>             <Text>Derrota a los piratas</Text>  </GameDBLocalizedString>
            
            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_CRUSADERS_LVL2_SAVE_TIN</LocID>                   <Text>Salva a Lata en la órbita</Text>  </GameDBLocalizedString>
            
            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_CRUSADERS_LVL2_RAM_GATE</LocID>                   <Text><![CDATA[Derriba la puerta <color=SOTS_COLOR_RED>con la Princesa</color> ]]></Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_CRUSADERS_LVL2_RAM_GATE_DONE</LocID>              <Text><![CDATA[<color=SOTS_COLOR_MOVEMENT>Derriba la puerta con la Princesa - Terminada</color>]]></Text>  </GameDBLocalizedString>


            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_CRUSADERS_LVL2_GET_TO_FORTRESS_TELEP</LocID>      <Text>Usa el teletransporte de la fortaleza de los Zieregales</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_CRUSADERS_LVL2_GET_TO_FORTRESS_TELEP_DONE</LocID> <Text><![CDATA[<color=SOTS_COLOR_MOVEMENT>Usa el teletransporte de la fortaleza de los Zieregales - Terminada</color>]]></Text>  </GameDBLocalizedString>

            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_CRUSADERS_LVL2_CAPTURE_BASES_01</LocID>           <Text>Captura bases enemigas 0/2</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_CRUSADERS_LVL2_CAPTURE_BASES_02</LocID>           <Text>Captura bases enemigas 1/2</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_CRUSADERS_LVL2_CAPTURE_BASES_DONE</LocID>         <Text><![CDATA[<color=SOTS_COLOR_MOVEMENT>Captura bases enemigas 2/2 - Terminada</color>]]></Text>  </GameDBLocalizedString>

            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_CRUSADERS_LVL2_DEFEAT_ZIEREGAL</LocID>            <Text>Derrota al gran Zieregal</Text>  </GameDBLocalizedString>


            <!--DIALOGUES-->
            <!--Tin(Hierarch) and Arthur arrived near the area controlled by the Children of the Source order. -->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_START_NARRATOR_1</LocID>             <Text>Unos días más tarde, Lata y el mensajero de los Vástagos del Origen llegan a las inmediaciones de la fortaleza del gran Zieregal. </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_START_GILEAS_1</LocID>               <Text>Dime, mi señor, ¿por qué hemos dejado atrás la nave? </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_START_GILEAS_2</LocID>               <Text>Imagino que tus patas carnosas están cansadas, pero la Chiquita se queda con la Princesa. </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_START_GILEAS_3</LocID>               <Text>Debo confesar que admiro esos pies a prueba de ampollas, pero el primer puesto avanzado está a la vuelta de la esquina. </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_START_TIN_1</LocID>                  <Text>Este camino no parece muy vigilado... ni transitado.   </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_START_GILEAS_4</LocID>               <Text>Así es, mi señor, pero hay un puente a escasos kilómetros. Cuando lo crucemos, estaremos en el terreno de los Vástagos. </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_START_GILEAS_5</LocID>               <Text>De ahí a la fortaleza del gran Zieregal no hay mucha distancia.   </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_START_TIN_2</LocID>                  <Text>Genial. Tengo muchas cosas que preguntarle. </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_START_GILEAS_6</LocID>               <Text>Si buscas información sobre la «Flota Perdida», te espera una decepción. Todo el mundo sabe que las naves fueron destruidas hace mucho. </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_START_TIN_3</LocID>                  <Text>¡¿Todo el mundo?! ¡Se instalaron sellos de memoria en los cerebros cibernéticos de los Vástagos! ¡Nadie recuerda lo que pasó! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_START_GILEAS_7</LocID>               <Text>Si a ti te quitaron los sellos, ¿cómo es que no recuerdas nada? </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_START_TIN_4</LocID>                  <Text>Estaba en la superficie el día en el que perdimos la flota. </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_START_GILEAS_8</LocID>               <Text>Vaya, qué coincidencia. </Text>  </GameDBLocalizedString>

            <!--Tin and Arthur arrived in the empty base.   -->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_BASE_EMPTY_RH_1</LocID>              <Text>¡¿No hay nadie?!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_BASE_EMPTY_GILEAS_1</LocID>          <Text>Es extraño. Conozco bien la zona, y debería haber una guarnición. Algo no encaja.</Text>  </GameDBLocalizedString>



            <!--Tin and Arthur spotted a mercenary. Mercenary will fall back to FOW once he broadcast the message to his boss.   -->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_MERCENARY_MERCENARY_1</LocID>        <Text>Jefe, ya están aquí. Todo va según lo previsto. Cuando acabemos, enviaré a mis muchachos a recoger el pago. </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_MERCENARY_GILEAS_1</LocID>           <Text>¡Piratas! Están usando la encriptación de la flota soberana. ¿Cómo eres capaz de descifrar la señal?      </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_MERCENARY_TIN_1</LocID>              <Text>Los soberanos y yo tenemos un pasado común... Me pregunto quién será ese «jefe»...    </Text>  </GameDBLocalizedString>
            
            
            <!-- Tin and Arthur are approaching the mercenary base. The mercenary is escaping to the orbit via nearby orbital teleport   -->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_BRIDGE_TIN_1</LocID>                 <Text>No es que hayan desactivado el puente, ¡el emisor está destrozado! Esto requiere una explicación... </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_BRIDGE_GILEAS_1</LocID>              <Text>Contactaré de inmediato con el gran Zieregal.   </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_BRIDGE_TIN_2</LocID>                 <Text>¡Eso puede esperar! ¡TRAS ÉL!    </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_BRIDGE_GILEAS_2</LocID>              <Text>¡Eso no es buena idea!    </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_BRIDGE_TIN_3</LocID>                 <Text>¿Por qué? ¿Te tiemblan esas piernecitas humanas? Annika no se echaría atrás.  </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_BRIDGE_GILEAS_3</LocID>              <Text>Es que... ¡ir a la órbita local está prohibido! ¡La región es inestable!   </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_BRIDGE_TIN_4</LocID>                 <Text>Si el mercenario ha ido, no puede ser tan peligroso... aunque solo hay una forma de averiguarlo.    </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_BRIDGE_TIN_5</LocID>                 <Text>¡¿Quién te ha contratado, escoria?!   </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_BRIDGE_MERCENARY_1</LocID>           <Text>Alguien que está muy cerca, ¡pero me pagan por luchar, no por hablar!   </Text>  </GameDBLocalizedString>

            <!-- Orbit, Mercenary was defeated, Tin (Hierarch is heading onwards to discover identity of merchs boss but is trapped by the will of the Ship wreck nearby -->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_MERCENARY_AF_MERCENARY_1</LocID>     <Text>¡Piernas peludas! ¡Sí que sois duros los ciberinsectos!   </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_MERCENARY_AF_TIN_1</LocID>           <Text>Y ahora me ocuparé de tu jefe.   </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_MERCENARY_AF_SHIP_1</LocID>          <Text>¡YA ERES MÍO!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_MERCENARY_AF_TIN_2</LocID>           <Text>¿Qué? ¡No puedo moverme! ¡¿Los indicadores de presión se salen de las escalas?! ¿Qué está pasando?    </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_MERCENARY_AF_GILEAS_1</LocID>        <Text>Ah, ahí estás... ¡¿Qué ha pasado?! ¿Una avería?   </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_MERCENARY_AF_ZIEREGAL_1</LocID>      <Text>¡Arthur! ¡No te acerques o tú también quedarás aplastado!   </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_MERCENARY_AF_ZIEREGAL_2</LocID>      <Text>La nave no está muerta, Arthur. Ha atrapado a ese hereje con sus poderes psiónicos.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_MERCENARY_AF_TIN_3</LocID>           <Text>¡Suéltame, nave! ¡Soy uno de los Vástagos del Origen!  </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_MERCENARY_AF_ZIEREGAL_3</LocID>      <Text>¡Eso no te servirá! La colisión que destrozó su cuerpo la privó de todos sus sentidos. Su nombre es Furia Ciega, ¡y es muy apropiado! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_MERCENARY_AF_GILEAS_2</LocID>        <Text>¡Gran Zieregal, no lo entiendo! ¡Le prometiste un salvoconducto! ¡Estaba actuando según esas instrucciones!   </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_MERCENARY_AF_ZIEREGAL_4</LocID>      <Text>¡Si hubieras sabido el plan, se habría dado cuenta, Arthur! Por tu parte, recibirás honores que ningún humano había recibido antes.  </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_MERCENARY_AF_GILEAS_3</LocID>        <Text>... Te... ¡Te lo agradezco, mi señor! Si no necesitas nada más, me retiro.   </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_MERCENARY_AF_TIN_4</LocID>           <Text>¿Por qué?   </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_MERCENARY_AF_ZIEREGAL_5</LocID>      <Text>Buena pregunta. Complicada. ¡Quiero que lo sepas!... ¡Pero solo te diré una cosa! A tu Princesa le espera el mismo destino que a ti.   </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_MERCENARY_AF_TIN_5</LocID>           <Text>¡Está lejos, en un lugar seguro!  </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_MERCENARY_AF_ZIEREGAL_6</LocID>      <Text>El bueno de Arthur la traerá.    </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_MERCENARY_AF_TIN_6</LocID>           <Text>¡La Princesa no se dejará engañar!    </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_MERCENARY_AF_ZIEREGAL_7</LocID>      <Text>Ya has visto lo mal que miente. Ha nacido en la era equivocada de la humanidad. Pero su corazón caballeroso le impulsará a advertir a tu Princesa. Vendrá a ayudarte y caerá en la misma trampa que tú.</Text>  </GameDBLocalizedString>
            
            <!--Princess and Viktar start-->                                                                                       
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_PRINCESS_START_NARRATOR_1</LocID>    <Text>Un tiempo después, Viktar y la Princesa han «aterrizado» cerca de la zona.  </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_PRINCESS_START_VIKTAR_1</LocID>      <Text>¡Qué gran trabajo! La Chiquita está atascada en un cenagal, con los motores llenos de barro. ¡Justo el sitio donde más puede estorbar el barro!   </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_PRINCESS_START_PRINCESS_1</LocID>    <Text>¡Venga, dilo de una vez!   </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_PRINCESS_START_VIKTAR_2</LocID>      <Text>No sirve de nada culparnos entre nosotros. ¡Ha sido todo cosa de la Princesa!  </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_PRINCESS_START_PRINCESS_2</LocID>    <Text>¡Y QUÉ... MÁS... DA! Dejaremos a la tripulación atrás para que preparen la Chiquita mientras buscamos a Arthur, el humano que envió el mensaje.   </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_PRINCESS_START_VIKTAR_3</LocID>      <Text>¡Y esa es otra! La Princesa se mete directamente en otra trampa. ¡De cabeza! ¡Y me hace ir con ella! Arthur es humano...   </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_PRINCESS_START_PRINCESS_3</LocID>    <Text>GERGIE-LARH, ¡ANNIKA TAMBIÉN ERA HUMANA!... ¡TEMA SUFICIENTEMENTE DEBATIDO, LACAYO!  </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_PRINCESS_START_PRINCESS_4</LocID>    <Text>... ¡Perdón, Viki! Mierda, ¡yo no soy así! ¡Es como si fuese la Madre Absoluta la que hablara! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_PRINCESS_START_VIKTAR_4</LocID>      <Text>Tal vez deberías ser más como ella. Según las leyendas, la Madre Absoluta podía hacer caer las naves del cielo con una palabra. Podrías ordenar a la Chiquita que saliera del barro.   </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_PRINCESS_START_PRINCESS_5</LocID>    <Text>No sabes de lo que hablas. Vamos, Arthur espera en la base que vimos antes de aterrizar.   </Text>  </GameDBLocalizedString>

            <!--Message that is tied to event that stops Princess or Viky if they venture in wrong direction --> 
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_FAR_ENOUGH_RH_1</LocID>              <Text>Hasta que tenga una base cubriéndome las espaldas, sería insensato avanzar.    </Text>  </GameDBLocalizedString>

            <!--Princess meets Gileas near her starting point   -->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_FAR_MEETING_GILEAS_GILEAS_1</LocID>  <Text>Me llamo Arthur. Soy... Era el mensajero del gran Zieregal. Acompañaba al señor Jerarca cuando la nave lo encerró en la órbita.  </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_FAR_MEETING_GILEAS_RH_1</LocID>      <Text>Un humano convertido en guerrero de los Vástagos. ¡Qué curioso! Pero mis preguntas pueden esperar. ¿Cómo llegamos a la órbita?   </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_FAR_MEETING_GILEAS_GILEAS_2</LocID>       <Text>El teletransportador que usamos está al otro lado de las montañas. Hablando de llegar a órbita, ¿y vuestra nave?   </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_FAR_MEETING_GILEAS_VIKTAR_1</LocID>       <Text>La Princesa ha «aterrizado» en...    </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_FAR_MEETING_GILEAS_PRINCESS_1</LocID>       <Text>¡No importa!   </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_FAR_MEETING_GILEAS_VIKTAR_2</LocID>       <Text>¿Ah, no?   </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_FAR_MEETING_GILEAS_PRINCESS_2</LocID>       <Text>¡No, así que calla!   </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_FAR_MEETING_GILEAS_PRINCESS_3</LocID>       <Text>La Chiquita... no está disponible en este momento. </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_FAR_MEETING_GILEAS_GILEAS_3</LocID>       <Text>Ya veo... Hay otro teletransportador, pero tiene un problema. Está en la fortaleza del gran Zieregal.    </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_FAR_MEETING_GILEAS_PRINCESS_4</LocID>       <Text>¡Podemos abrirnos paso luchando!   </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_FAR_MEETING_GILEAS_GILEAS_4</LocID>       <Text>Es posible, pero la fortaleza no solo está protegida por armas. Hay una puerta primordial, y solo el gran Zieregal...    </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_FAR_MEETING_GILEAS_PRINCESS_5</LocID>       <Text>... tiene la llave. Sí, veo la puerta en la psicosfera. Recibe energía de diferentes recursos. El primero es inaccesible, está en el corazón de la base del gran Zieregal...  </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_FAR_MEETING_GILEAS_PRINCESS_6</LocID>       <Text>... pero el segundo está fuera...   </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_FAR_MEETING_GILEAS_PRINCESS_7</LocID>       <Text>... y el tercero también.   </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_FAR_MEETING_GILEAS_VIKTAR_3</LocID>       <Text>¿A qué se refiere la Princesa? Todo el mundo sabe que los campos de fuerza de los primordiales son indestructibles.     </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_FAR_MEETING_GILEAS_PRINCESS_8</LocID>       <Text>Si la puerta está alimentada por tres fuentes, sería imposible, pero si desconectamos las dos que hay fuera de la fortaleza, puedo «embestir» la puerta con un estallido psiónico.     </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_FAR_MEETING_GILEAS_GILEAS_5</LocID>       <Text>¿Psicosfera? ¿Estallido psiónico?   </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_FAR_MEETING_GILEAS_VIKTAR_4</LocID>       <Text>La Princesa es una caja de sorpresas. Ya te acostumbrarás con el tiempo.    </Text>  </GameDBLocalizedString>
            
            
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_FAR_PLAN_GILEAS_1</LocID>            <Text>Perdona que lo pregunte, pero ¿tienes algún plan? ¡No esperaba tener que enfrentarnos a una nave! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_FAR_PLAN_PRINCESS_1</LocID>          <Text>¿Qué sabes de la Letanía, Arthur?</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_FAR_PLAN_VIKTAR_1</LocID>            <Text>¿Va la Princesa a probar los versos con el pecio que retiene al señor Jerarca?</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_FAR_PLAN_GILEAS_3</LocID>            <Text>¿Los versos? Eso no funcionará, perdió su sensorium durante la colisión. </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_FAR_PLAN_PRINCESS_3</LocID>          <Text>Entonces, lamentablemente, ¡tendremos que atizarle bien fuerte!  </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_FAR_PLAN_VIKTAR_2</LocID>            <Text>[SUSPIRA] ¡Que la Madre Absoluta nos proteja!  </Text>  </GameDBLocalizedString>
  
            <!-- Princess and Viktar advancing towards lands controlled by Grand Zieregal  -->                                         
           
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_MESSAGE_TO_ZIEREGAL_BALINOR_1</LocID>    <Text>Gran Zieregal, avanzan por el lado oeste de la colina... ¡con Arthur como guía!   </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_MESSAGE_TO_ZIEREGAL_ZIEREGAL_1</LocID>    <Text>¡Matadlos a todos!     </Text>  </GameDBLocalizedString>

            <!--Princess managed to conquere the enemy bases set on power source of the gate of the Grand Zieregal fortress and weakened the gates force field.  -->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_GATE_WEAKENED_PRINCESS_1</LocID>     <Text>Una más y podré derribar la puerta.    </Text>  </GameDBLocalizedString>

            
            <!--Princess managed to conquere the enemy bases set on power source of the gate of the Grand Zieregal fortress and weakened the gates force field.  -->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_GATE_WEAK_PRINCESS_1</LocID>         <Text>La puerta está debilitada. Podré abrirme paso.     </Text>  </GameDBLocalizedString>
           
           
            <!--princess and Grand Zieregal meats near the gate. Princess will successfully open the gate by her psionic abilities  -->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_PRINCESS_AT_GATE_ZIEREGAL_1</LocID>  <Text>¡Execrable impostora de la Madre Absoluta! Tanto corretear, ¡y la puerta sigue cerrada! Palideces en comparación con tu ideal.    </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_PRINCESS_AT_GATE_PRINCESS_1</LocID>  <Text>¡Bla, bla, bla! Seguro que era fenomenal. Pero si siguiera su ejemplo, lo lamentaríais todos. Por suerte para ti, hoy no me hace falta.    </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_PRINCESS_AT_GATE_ZIEREGAL_2</LocID>  <Text>¡Por las lágrimas de la Madre Absoluta!  </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_PRINCESS_AT_GATE_PRINCESS_2</LocID>  <Text>Suelta a Lata... \n... ¡o te aplastaré como a un gusano! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_PRINCESS_AT_GATE_ZIEREGAL_3</LocID>  <Text>¡No es aquí donde me llegará la hora! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_PRINCESS_AT_GATE_GILEAS_1</LocID>    <Text>¡Has dejado que se fuera para enfrentarte a él en el campo del honor en vez de aplastarlo con tus poderes! ¡Has elegido un camino honorable! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_PRINCESS_AT_GATE_PRINCESS_4</LocID>  <Text>[JADEA] ¿Estás de broma? Me encantaría hacerlo papilla, pero... me tiemblan las piernas... por el esfuerzo... de la embestida...   </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_PRINCESS_AT_GATE_VIKTAR_3</LocID>    <Text>Cada vez que la Princesa va a ganarse un nuevo seguidor, ¡abre la boca y echa por tierra la magia!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_PRINCESS_AT_GATE_PRINCESS_5</LocID>  <Text>[SE ENCOGE DE HOMBROS] Qué le vamos a hacer, soy así.</Text>  </GameDBLocalizedString>


            <!--One of the commanders managed to get to orbit - Arthur points the way   -->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_SENSE_TIN_RH_1</LocID>               <Text>No falta mucho.</Text>  </GameDBLocalizedString>
           
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_SENSE_TIN_PRINCESS_1</LocID>         <Text>Será mejor guardar las distancias, no sé hasta donde «llega» la nave. </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_SENSE_TIN_GILEAS_1</LocID>           <Text>Ese lugar debería ser seguro. El gran Zieregal estaba ahí y no le afectó. </Text>  </GameDBLocalizedString>


            <!--End - Princess and her Friends arrives to Ancient shipwreck that is holding and slowly crushing Tin (Hierarch) by the power of her will   -->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_SHIP_TWO_PRINCESS_1</LocID>          <Text>¡Toma esto!  </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_SHIP_TWO_SHIP_1</LocID>              <Text>UNA IMITACIÓN RUDIMENTARIA DE MIS PODERES. ACÉRCATE PARA QUE TE ATRAPE TAMBIÉN.  </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_SHIP_TWO_VIKTAR_1</LocID>            <Text>Pues lo de «atizarle fuerte» no ha funcionado... </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_SHIP_TWO_PRINCESS_2</LocID>          <Text>Si tienes algún plan mejor, ¡soy toda oídos, cerebrito!  </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_SHIP_TWO_VIKTAR_2</LocID>            <Text>No. Pero si no hacemos nada, ¡aplastará al señor Jerarca! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_SHIP_TWO_PRINCESS_3</LocID>          <Text>¡Suéltalo, pecio estúpido!    </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_SHIP_TWO_VIKTAR_3</LocID>            <Text>¡No funciona! ¡No puedo mirar! Mi señor, ¡te ayudaré o moriré en el intento!    </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_SHIP_TWO_PRINCESS_4</LocID>          <Text>¡Alto! ¡Viktar, no fuiste creado para ser guerrero! ¡Tu cuerpo no aguantará la presión!  </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_SHIP_TWO_SHIP_2</LocID>              <Text>¡LA PRIMERA ERA FUERTE, PERO ESTE LO TRITURARÉ COMO UN CRISTAL FINO!   </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_SHIP_TWO_PRINCESS_5</LocID>          <Text>¡No hay otra opción! ¡Tengo que cederle el control a la Madre Absoluta que llevo dentro!     </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_SHIP_TWO_PRINCESS_6</LocID>          <Text>¡SUÉLTALOS, ZORRA!    </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_SHIP_TWO_TIN_1</LocID>               <Text>¿Qué ha pasado? ¡Ya no siento la presa de la nave!   </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_SHIP_TWO_PRINCESS_7</LocID>          <Text>Creo que he usado demasiado poder... Tenía miedo...    </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_SHIP_TWO_SHIP_3</LocID>              <Text>SOLO HABÍA SENTIDO ESE PODER UNA VEZ... MADRE ABSOLUTA... HAS VUELTO... PARA LIBERARME... DE ESTE CUERPO QUEBRANTADO.   </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_SHIP_TWO_PRINCESS_8</LocID>          <Text>¡Lo siento! Lo...  </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_SHIP_TWO_SHIP_4</LocID>              <Text>ME ALEGRO... DE HABERTE VISTO POR ÚLTIMA VEZ... MADRE ABSOLUTA... AHORA PUEDO IR... CON MIS HERMANAS CAÍDAS. </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_SHIP_TWO_PRINCESS_9</LocID>          <Text>No, no, no... Cre... Creo que... ¡La he matado!   </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_SHIP_TWO_ZIEREGAL_1</LocID>          <Text>La nave ha muerto, pero mientras siga teniendo mi espada, no habré perdido. Veo que ese último ataque ha debilitado tus poderes. Por una vez, será un combate justo. </Text>  </GameDBLocalizedString>


              <!--The Grand Zieregal enters a scene, attacks and is defeated-->   
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_ZIEREGAL_AF_ZIEREGAL_1</LocID>       <Text>¡Basta! Afrontaré las consecuencias de mi derrota con la cabeza en alto.   </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_ZIEREGAL_AF_TIN_1</LocID>            <Text>Te lo pregunto otra vez, gran Zieregal. ¿Por qué?  </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_ZIEREGAL_AF_ZIEREGAL_3</LocID>       <Text>¡Porque tu Princesa conoce la Letanía!  </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_ZIEREGAL_AF_TIN_3</LocID>            <Text>¿A qué te refieres, gran Zieregal? ¡Contesta!   </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_ZIEREGAL_AF_ZIEREGAL_5</LocID>       <Text>El día que conquistamos el sistema, ¡casi toda la flota fue aniquilada por la transmisión de la Letanía! ¡Por eso los Vástagos han pasado siglos buscando y exterminando a las impostoras de la Madre Absoluta!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_ZIEREGAL_AF_TIN_4</LocID>            <Text>Quiere volverte contra mí, ¡¿es que no lo ves?!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_ZIEREGAL_AF_ZIEREGAL_6</LocID>       <Text>Solo los clones de la Madre Absoluta conocen los versos que obligan a las naves a hacer cualquier cosa. ¡Hasta aplastarse a sí mismas!  </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_ZIEREGAL_AF_PRINCESS_2</LocID>       <Text>¡YO ESTABA HIBERNANDO!   </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_ZIEREGAL_AF_ZIEREGAL_7</LocID>       <Text>¡Es la sirena que atrajo nuestra flota a su perdición!   </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_ZIEREGAL_AF_PRINCESS_3</LocID>       <Text>¡ESO ES MENTIRA!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_ZIEREGAL_AF_ZIEREGAL_8</LocID>       <Text>¡La Madre Absoluta esclavizó sistemas estelares enteros! ¡Y tú quieres lo mismo! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_ZIEREGAL_AF_PRINCESS_4</LocID>       <Text>¡CÁLLATE! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_ZIEREGAL_AF_ZIEREGAL_9</LocID>       <Text>¡Especies enteras, obligadas a ser parte de su ejército de cíborgs! ¡Planetas reducidos a cenizas en nombre de la Madre Absoluta! ¡EN TU NOMBRE! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_ZIEREGAL_AF_PRINCESS_5</LocID>       <Text>¡SILENCIO! </Text>  </GameDBLocalizedString>
                    <!--An this moment Princes strikes the Grand Zieregal so hard he dies.  -->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_ZIEREGAL_AF_TIN_5</LocID>            <Text>Está muerto. </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_ZIEREGAL_AF_PRINCESS_6</LocID>       <Text>... Yo... ¡No quería matarlo! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_ZIEREGAL_AF_GILEAS_1</LocID>         <Text>Mi honor exige que informe a los otros Vástagos de lo que he presenciado... ¿Vas a silenciarme a mí también?  </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_ZIEREGAL_AF_PRINCESS_7</LocID>       <Text>Claro que no, ¡no voy a hacerte daño, Arthur! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_ZIEREGAL_AF_GILEAS_2</LocID>         <Text>Adiós... por ahora.   </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_ZIEREGAL_AF_PRINCESS_8</LocID>       <Text>Vosotros dos me creéis, ¿verdad? Es posible que la Madre Absoluta fuese un monstruo, ¡pero yo no soy ella!  </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_ZIEREGAL_AF_VIKTAR_1</LocID>         <Text>Siempre he creído en ti. Siempre.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_ZIEREGAL_AF_TIN_6</LocID>            <Text>Y yo, pero hay algo de verdad en las palabras del Zieregal...    </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_ZIEREGAL_AF_PRINCESS_9</LocID>       <Text>Así que crees que soy responsable de...   </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_ZIEREGAL_AF_TIN_7</LocID>            <Text>¡No! ¡Me refiero a que no ha negado la existencia de la Flota Perdida! Todos los otros Vástagos lo hacen.  </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_ZIEREGAL_AF_TIN_8</LocID>            <Text>Hay un lugar que siempre he considerado demasiado peligroso para explorarlo. Pero ahora tenemos pruebas.   </Text>  </GameDBLocalizedString>
            
            <!--      BEFORE/AFTER FIGHT QOUTES-->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_CRUSADER_AF_RH_1</LocID>             <Text>¡Acompáñanos! No somos enemigos de los Vástagos, ¡solo del gran Zieregal! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_CRUSADER_AF_CRUSADER_1</LocID>       <Text>¡Mi juramento al gran Zieregal es inquebrantable!</Text>  </GameDBLocalizedString>
                                                                           
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_CRUSADER_AF_RH_2</LocID>             <Text>¡Esta pelea no tiene sentido!     </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_CRUSADER_AF_CRUSADER_2</LocID>       <Text>Estoy de acuerdo, pero pese a ello lucharé.        </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_CRUSADER_AF_RH_3</LocID>             <Text>Déjame que lo adivine. ¿Juramento?       </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_CRUSADER_AF_CRUSADER_3</LocID>       <Text>Efectivamente.       </Text>  </GameDBLocalizedString>
            
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_CRUSADER_AF_CRUSADER_4</LocID>       <Text>Yo...  </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_CRUSADER_AF_RH_4</LocID>             <Text>Sí, ya, juramento al gran Zieregal. ¿Verdad?  </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_CRUSADER_AF_CRUSADER_5</LocID>       <Text>[SE ENCOGE DE HOMBROS] Somos los Vástagos del Origen, ¿no? </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_CRUSADER_AF_RH_5</LocID>             <Text>[SUSPIRA] Supongo que tengo la respuesta.</Text>  </GameDBLocalizedString>
            


        </LocalizedStrings>
    </GameDBStringTable>
