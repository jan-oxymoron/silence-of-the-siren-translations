<Database>
    <GameDBStringTable ID="LOC_ES_CAMPAIGN_PIRATES_LVL_2">

        <LanguageRef>LANG_ES</LanguageRef>

        <Contributors>
            <Name>Oxymoron Games</Name>
        </Contributors>

        <LocalizedStrings>
            <!--OBJECTIVES MAIN QUESTS-->
            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_PIRATES_LVL2_CUTSCENE_OBJECTIVE_1</LocID>         <Text>Únete a los amigos soberanos de Annika</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_PIRATES_LVL2_CUTSCENE_OBJECTIVE_2</LocID>         <Text>Asalta la instalación de la UNSS</Text>  </GameDBLocalizedString>
            
            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_PIRATES_LVL2_FIRST_BASE</LocID>                   <Text>Explora la base soberana cercana</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_PIRATES_LVL2_FIRST_BASE_DONE</LocID>              <Text><![CDATA[<color=SOTS_COLOR_MOVEMENT>Explora la base soberana cercana - Terminada</color>]]></Text>  </GameDBLocalizedString>
            
            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_PIRATES_LVL2_SECOND_BASE</LocID>                  <Text>Busca a los soberanos en el oeste</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_PIRATES_LVL2_SECOND_BASE_DONE</LocID>             <Text><![CDATA[<color=SOTS_COLOR_MOVEMENT>Busca a los soberanos en el oeste - Terminada</color>]]></Text>  </GameDBLocalizedString>
          
            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_PIRATES_LVL2_WEST_BRIDGE</LocID>                  <Text>Encuentra cómo llegar a la isla oeste</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_PIRATES_LVL2_WEST_BRIDGE_HIERARCH</LocID>         <Text>Activa el puente con Lata</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_PIRATES_LVL2_WEST_BRIDGE_HIERARCH_DONE</LocID>    <Text><![CDATA[<color=SOTS_COLOR_MOVEMENT>Activa el puente con Lata- Terminada</color>]]></Text>  </GameDBLocalizedString>

            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_PIRATES_LVL2_NORTH_BRIDGE_1</LocID>               <Text>Encuentra cómo llegar a la isla norte 0/2</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_PIRATES_LVL2_NORTH_BRIDGE_2</LocID>               <Text>Encuentra cómo llegar a la isla norte 1/2</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_PIRATES_LVL2_NORTH_BRIDGE_DONE</LocID>            <Text><![CDATA[<color=SOTS_COLOR_MOVEMENT>Encuentra cómo llegar a la isla norte 2/2 - Terminada</color>]]></Text>  </GameDBLocalizedString>


            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_PIRATES_LVL2_PATH_TO_CHICA</LocID>                <Text>Despeja una ruta a la nave</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_PIRATES_LVL2_PATH_TO_CHICA_DONE</LocID>           <Text><![CDATA[<color=SOTS_COLOR_MOVEMENT>Despeja una ruta a la nave - Terminada</color>]]></Text>  </GameDBLocalizedString>

            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_PIRATES_LVL2_NORTHERN_BRIDGE</LocID>              <Text>[Opcional] Cierra el puente norte. Turno(s) restante(s):</Text></GameDBLocalizedString>

            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_PIRATES_LVL2_RED_COUNTDOWN_DONE</LocID>           <Text><![CDATA[<color=SOTS_COLOR_MOVEMENT>Cierra el puente norte - Terminada</color>]]></Text>  </GameDBLocalizedString>
            
            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_PIRATES_LVL2_EVACUATE_1</LocID>                   <Text>Evacúa a tus comandantes 0/2</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_PIRATES_LVL2_EVACUATE_2</LocID>                   <Text>Evacúa a tus comandantes 1/2</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_PIRATES_LVL2_EVACUATE_DONE</LocID>                <Text><![CDATA[<color=SOTS_COLOR_MOVEMENT>Evacúa a tus comandantes 2/2 - Terminada</color>]]></Text>  </GameDBLocalizedString>

            <!--DIALOGUES-->

            <!--starting dialog-->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_START_NARRRATOR_1</LocID>              <Text>Nos encontramos en el planeta Quimera, cuya rotación es más lenta. Cada ciclo cuenta con 6 fases en lugar de 4.  </Text>  </GameDBLocalizedString>
          
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_START_H_1</LocID>                      <Text>Estrellita, ¡llevamos horas caminando! ¿Ese montón de chatarra de ahí es la base de tus amigos soberanos? </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_START_A_1</LocID>                      <Text>¡Deja de quejarte! ¡Solo llevamos 20 minutos! Pero sí, las coordenadas son estas... Aunque no veo su nave, la Chiquita. </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_START_H_2</LocID>                      <Text>Qué raro que no se oiga nada. ¿Siguen sin responder?  </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_START_A_2</LocID>                      <Text>Pues sí, Lata, siguen sin responder. Según su último mensaje, vieron la nave del hesperidiano aterrizar cerca de esta instalación de la división de investigación. </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_START_H_3</LocID>                      <Text>¡¿La división de investigación de la UNSS?! ¿La que hace experimentos crueles y eso? ¡Capaz de que esos cabrones fueran quienes secuestraron a los capitanes soberanos! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_START_A_3</LocID>                      <Text>No me extrañaría. </Text>  </GameDBLocalizedString>
            
            <!--first base-->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_FIRST_BASE_RH_1</LocID>                <Text>No hay nadie en casa... Pero mira: he encontrado un mensaje encriptado. </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_FIRST_BASE_A_1</LocID>                 <Text>Por suerte, mis amigos me dieron los códigos de seguridad por si el plan se iba por el desagüe... </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_FIRST_BASE_DOUG_1</LocID>              <Text>[MENSAJE GRABADO] Annika, amor, soy Doug. Que nos vamos de la base antigua y tiramos para el oeste; así estamos más cerca de la instalación de la UNSS. Es que este sitio está muy lejos para explorar en condiciones. </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_FIRST_BASE_DOUG_2</LocID>              <Text>[MENSAJE GRABADO] Mejor no llames, amor, que igual llamas la atención de los capullos de la UNSS. Solo si la cosa se tuerce de verdad, llama a Número 925.  </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_FIRST_BASE_DOUG_3</LocID>              <Text>[MENSAJE GRABADO] ¿A que estás buscando dónde está aterrizada la Chiquita?   </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_FIRST_BASE_DOUG_4</LocID>              <Text>[MENSAJE GRABADO] Está escondida al norte, bajo la atenta vigilancia del bueno de Número 925. ¿Dónde exactamente? Ah, se siente. Es que, sin ella, nos quedamos sin cómo volver a casa. </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_FIRST_BASE_A_2</LocID>                 <Text>Bueno, así queda un poco más claro. </Text>  </GameDBLocalizedString>
     
            <!--second base-->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_SECOND_BASE_RH_1</LocID>               <Text>¡Otro mensaje! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_SECOND_BASE_DOUG_1</LocID>             <Text>[MENSAJE GRABADO] Annika, amor, ¡deséame suerte! Voy a cruzar el puente, en dirección a la instalación de la UNSS. </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_SECOND_BASE_DOUG_2</LocID>             <Text>[MENSAJE GRABADO] Si me quieres seguir, aquí tienes los controles, pero ¡hay un pero! Alguien tiene que asegurarse de que estén activos personalmente. </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_SECOND_BASE_H_1</LocID>                <Text>¿Tu amigo Doug ha cruzado el puente él solo? ¡Tiene que ser igual de valiente que yo! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_SECOND_BASE_A_2</LocID>                <Text>Él no es mucho de pegar tiros, pero tiene una labia que no veas. Una vez, aterrizamos en la colonia Campo Libre y...  </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_SECOND_BASE_H_2</LocID>                <Text>Si la historia no va de pegar tiros, me quedo dormido, así que no, ¡gracias! Pero, hablando de violencia..., de nosotros dos, claramente yo soy mejor guerrero. ¡Es mi deber cruzar ese puente! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_SECOND_BASE_A_3</LocID>                <Text>Eso te lo compro, Lata, pero por eso mismo deberías quedarte aquí. Llegaré más lejos tirando de sigilo. ¿Te recuerdo que tu cuerpo está hecho de metal reflectante y que pesa como una camioneta? </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_SECOND_BASE_H_3</LocID>                <Text>¡Que me sacas los colores, Estrellita! Pero vale... ¡Es que me gusta ser de metal brillante! ¡El camuflaje es de cobardes! </Text>  </GameDBLocalizedString>
            
            <!--Commander spots that bridge is still off-->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_SPOT_CLOSED_BRIDGE_RH1</LocID>         <Text>Los controles de este puente de luz están al sur.</Text>  </GameDBLocalizedString>
            
            <!--Hierarch activates the bridge-->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_H_BRIDGE_ON_H_1</LocID>                <Text>¡Que se haga la luz!</Text>  </GameDBLocalizedString>
         
            <!--Hierarch deactivates the bridge-->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_H_BRIDGE_OFF_H_1</LocID>               <Text>¡Uy, perdón! Enseguida vuelvo, lo prometo. </Text>  </GameDBLocalizedString>
            
            <!--the f**kup on the bridge-->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_BRIDGE_FUP_DOUG_1</LocID>              <Text>¡Annika, amor! ¡Es una trampa! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_BRIDGE_FUP_BROWN_1</LocID>             <Text>¡No tan rápido! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_BRIDGE_FUP_ADELA_1</LocID>             <Text>¡Te quedas sin vía de escape! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_BRIDGE_FUP_TAKESHI_1</LocID>           <Text>¡Te tenemos rodeado! ¡Suelta las armas! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_BRIDGE_FUP_TAKESHI_2</LocID>           <Text>¡Esperad! ¡Que viene! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_BRIDGE_FUP_RELIC_1</LocID>             <Text>DOUG PORTER... OTRO CAPITÁN SOBERANO PARA MI COLECCIÓN. </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_BRIDGE_FUP_DOUG_2</LocID>              <Text>¡Annika! ¡Socorro! ANNI... [ESTRUENDO DE ESTÁTICA RADIOFÓNICA]  </Text>  </GameDBLocalizedString>
            
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_BRIDGE_FUP_A_1</LocID>                 <Text>Cierra el puente, Lata.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_BRIDGE_FUP_H_1</LocID>                 <Text>¡¿Qué?! ¡Hay que ayudar a tu amigo! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_BRIDGE_FUP_A_2</LocID>                 <Text>¡Que cierres el puente YA!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_BRIDGE_FUP_H_2</LocID>                 <Text>A tus órdenes...</Text>  </GameDBLocalizedString>

            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_BRIDGE_FUP_H_3</LocID>                 <Text>Tu amigo Doug... </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_BRIDGE_FUP_A_3</LocID>                 <Text>¡Eran demasiados! Por no hablar de esa cosa que parecía un MONSTRUO... </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_BRIDGE_FUP_H_4</LocID>                 <Text>¿Qué monstruo?  </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_BRIDGE_FUP_A_4</LocID>                 <Text>Tenía los ojos rojos y grandes, cuernos y muchos brazos. Su cuerpo era negro y dorado, como de quitina...     </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_BRIDGE_FUP_H_5</LocID>                 <Text>¿«Negro y dorado, como de quitina»? </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_BRIDGE_FUP_A_5</LocID>                 <Text>Me dio un susto de muerte, ¿VALE? No me acuerdo de más detalles. </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_BRIDGE_FUP_H_6</LocID>                 <Text>No es la primera vez que oigo esa descripción. «Negro y dorado, de quitina. Del Pozo Negro del... algo». Aj, el resto estará bloqueado por los sellos de IA. </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_BRIDGE_FUP_A_6</LocID>                 <Text>¡No pienso quitarte esos sellos ni muerta! ¡Ni menos luchar contra esa cosa! Vamos a dar marcha atrás y a llamar a Número 925. Espero que siga en el norte, echándole un ojo a la Chiquita. </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_BRIDGE_FUP_H_7</LocID>                 <Text>Ah, pensaba que lo del 925 era porque había que marcar ese número. </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_BRIDGE_FUP_A_7</LocID>                 <Text>¿«Marcar» ese número? ¿En qué año te piensas que estamos? No, alcornoque, Número 925 es un robot con recuerdos humanos. Doug lo rescató de un laboratorio o algo así. </Text>  </GameDBLocalizedString>
          
            <!--call to 925-->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_CALL_925_A_1</LocID>                   <Text>[ESTÁTICA RADIOFÓNICA] Número 925, aquí Annika. Se han... ¡Se han llevado a Doug! Yo...    </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_CALL_925_925_1</LocID>                 <Text>[ESTÁTICA RADIOFÓNICA] Te oigo, Annika. Sí, lo sé. ¡Doug me ha llamado todo apurado! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_CALL_925_A_2</LocID>                   <Text>Vamos a ver, tenemos que ayudar a Doug. ¿Se te ocurre otro lugar por el que podamos cruzar al norte, donde tú estás? </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_CALL_925_925_2</LocID>                 <Text>Ajá... ¡¡La heroína de Kelvin no deja a nadie atrás!! Os activo el puente de luz. </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_CALL_925_A_3</LocID>                   <Text>Genial, allí nos vemos. Cambio y fuera. </Text>  </GameDBLocalizedString>
            
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_CALL_925_H_1</LocID>                   <Text>¡Conque has decidido ayudar a Doug! Pues bien que...</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_CALL_925_A_4</LocID>                   <Text>¿Estás loco o qué? ¡Qué va! Doug sabía lo que se jugaba. Simplemente le he dicho a Número 925 lo que quería oír. </Text>  </GameDBLocalizedString>
           
            <!--Hierarch asking Annika about Kelvin-->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_ANNIKA_STORY_H_1</LocID>               <Text>Todos con los que nos hemos topado han mencionado la Estación Kelvin... ¿Qué pasó allí? </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_ANNIKA_STORY_A_1</LocID>               <Text>No quiero hablar del tema.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_ANNIKA_STORY_H_2</LocID>               <Text>Pero ¿justo ahora o...? </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_ANNIKA_STORY_A_2</LocID>               <Text>¡Déjalo ya, Lata!  </Text>  </GameDBLocalizedString>

            <!--Relic during hunt-->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_RELIC_WIN_RELIC_1</LocID>              <Text>¿OS HABÉIS CANSADO DE ESCAPAR? </Text>  </GameDBLocalizedString>
            
            <!--Relic crossing the disabled bridge-->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_DISABLED_BRIDGE_RELIC_1</LocID>        <Text>¡NECIOS! ¡NO HAY OBSTÁCULO QUE ME DETENGA! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_DISABLED_BRIDGE_A_1</LocID>            <Text>¡¿Cómo ha podido esa cosa activar el puente de luz?! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_DISABLED_BRIDGE_RELIC_1.1</LocID>      <Text>¡ACECHAD A LA PRESA!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_DISABLED_BRIDGE_RELIC_2</LocID>        <Text>¿UN «OJO» MECÁNICO?... BUENA SOLUCIÓN, PERO YO PREFIERO CAZAR EN LA OSCURIDAD. </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_DISABLED_BRIDGE_A_2</LocID>            <Text>¡Mierda! Y mira que los sabuesos están hechos para soportar lo que sea. ¡Ese PEM se las trae! Razón de más para largarse de aquí. </Text>  </GameDBLocalizedString>
            
            <!--DR Brown during hunt-->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_BROWNS_MESSAGE_BROWN_1</LocID>         <Text>Vengo de hablar con el Sr. Porter, es decir, tu amigo Doug. «¿Quién es esa tal Annika con la que hablabas por radio cuando te capturamos?», le pregunté. ¡Por el Pozo Negro del Nadir! ¡Imagínate mi sorpresa, señorita Finch! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_BROWNS_MESSAGE_BROWN_2</LocID>         <Text>Oficial de inteligencia Annika Finch, número de contrato 639-1845. Que sepas que acabo de hacer públicos tus datos, además del testimonio de Greta Mansfeld, conocida como la Abuela Manny. Los soberanos «merecen» saber la verdad sobre la heroína de Kelvin.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_BROWNS_MESSAGE_A_1</LocID>             <Text>¡¿Te crees que acaso me importa, parásito comerropa?! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_BROWNS_MESSAGE_BROWN_3</LocID>         <Text>Quizás ahora no, pero, cuando te des cuenta de que se te acabó el chollo con los soberanos y la UNSS..., igual empieza a importante.  </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_BROWNS_MESSAGE_A_2</LocID>             <Text>¡Voy a por ti, capullo! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_BROWNS_MESSAGE_BROWN_4</LocID>         <Text>Qué ganas. </Text>  </GameDBLocalizedString>
            
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_UNSS_COMMANDERS_1</LocID>              <Text>¡Las manos en alto, pirata! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_UNSS_COMMANDERS_2</LocID>              <Text>¡Deja de resistirte! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_UNSS_COMMANDERS_3</LocID>              <Text>¡Por fin te tenemos! </Text>  </GameDBLocalizedString>
            
            <!--Hierarch asking 925 about Kelvin-->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_KELVIN_STORY_H_1</LocID>               <Text>Número 925, cuéntame lo que pasó en Kelvin. ¡Todo el mundo lo sabe menos yo! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_KELVIN_STORY_925_2</LocID>             <Text>Muy bien... Todo comenzó cuando la flota de la UNSS invadió la Estación Kelvin y se puso a bombardearla hasta que se sometiera a ella. </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_KELVIN_STORY_H_3</LocID>               <Text>¡Pero la gente de Kelvin se negaba a hacerlo! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_KELVIN_STORY_925_3</LocID>             <Text>Al revés, estaba loca por arrodillarse ante la UNSS, pero no llegaron a recibir el ofrecimiento y siguieron disparando. </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_KELVIN_STORY_H_5</LocID>               <Text>Pero Annika estaba en la estación... </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_KELVIN_STORY_925_5</LocID>             <Text>Así es, la piloto a bordo de la última nave de evacuación. Imagínate el pánico que cundió entre los refugiados que se quedaron a las puertas de la nave. Su capitán se negaba a dejarlos abordar. </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_KELVIN_STORY_H_7</LocID>               <Text>Pero, aun así, ¿ella los dejó? </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_KELVIN_STORY_925_7</LocID>             <Text>Habían perdido la esperanza cuando, de repente, se abrió la puerta. </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_KELVIN_STORY_H_8</LocID>               <Text>¿El capitán de Annika cambió de opinión?</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_KELVIN_STORY_925_8</LocID>             <Text>No del todo. Cuando los supervivientes llegaron al puente de mando, se encontraron a una Annika herida en el asiento del piloto... y a toda la tripulación muerta. </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_KELVIN_STORY_H_9</LocID>               <Text>¿Los mató? ¿Ella sola? </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_KELVIN_STORY_925_9</LocID>             <Text>Seguramente, una parte de la tripulación se amotinara, pero ella fue la única que sobrevivió a la refriega y que consiguió dejar que abordaran los de fuera. </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_KELVIN_STORY_H_10</LocID>              <Text>¡Qué locura! Si yo fuera ella, ¡lo contaría cada vez que tuviera la ocasión! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_KELVIN_STORY_925_10</LocID>            <Text>A mí no me extraña que no quiera hacerlo. Se vio obligada a matar a los suyos. Los soberanos suelen llevarse tan bien que se consideran familia. </Text>  </GameDBLocalizedString>

            <!--Islets_both_in-->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_ISLETS_A_1</LocID>                     <Text>Número 925, activa el siguiente puente.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_ISLETS_925_1</LocID>                   <Text>Primero, destruye el puente que tienes detrás. No quiero que esa cosa te siga hasta aquí. </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_ISLETS_H_1</LocID>                     <Text>¡¿Que hay que destruir algo?! ¡Yo me encargo!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_ISLETS_925_2</LocID>                   <Text>Genial. Ya se puede pasar.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_ISLETS_A_2</LocID>                     <Text>Espero que el puente se quede cerrado esta vez...</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_ISLETS_H_2</LocID>                     <Text>He hecho trizas el emisor del puente. Ya nadie puede sacarse un rayo láser de la manga... o eso espero.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_ISLETS_RELIC_1</LocID>                 <Text>EXISTEN OTROS MEDIOS PARA CRUZAR. PRONTO TODOS LOS SOBERANOS ESTARÉIS EN MIS MANOS.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_ISLETS_A_3</LocID>                     <Text>[resoplido]</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_ISLETS_H_3</LocID>                     <Text>[resoplido]</Text>  </GameDBLocalizedString>
            <!--islets_crossed-->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_ISLETS_CROSSED_925_1</LocID>           <Text>Me alegro de que hayáis logrado cruzar. ¿Qué es esa cosa?</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_ISLETS_CROSSED_H_1</LocID>             <Text>Yo siento que lo conozco, pero tengo los recuerdos bloqueados por...</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_ISLETS_CROSSED_A_1</LocID>             <Text>Como oiga hablar de esos sellos de las narices otra vez... </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_ISLETS_CROSSED_H_2</LocID>             <Text>Estrellita, pero piénsatelo... </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_ISLETS_CROSSED_A_2</LocID>             <Text>¡QUE NO! Te volverías un ciberinsecto otra vez. ¡Un fanático imbécil más! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_ISLETS_CROSSED_925_2</LocID>           <Text>El profesor Zane podría ayudarnos con los sellos de IA. Cuando escapé del laboratorio de la UNSS, estaba igual de perdido que Lata. Pero, entonces, conocí a Zane y él desbloqueó mis antiguos recuerdos. Bueno, los que la UNSS le robó al hombre que usurpé. </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_ISLETS_CROSSED_A_3</LocID>             <Text>¡Vete tú a saber dónde estará Zane! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_ISLETS_CROSSED_925_3</LocID>           <Text>Pues, en realidad, Zane está aquí, en Quimera. A miles de kliks de distancia, pero con la Chiquita no es problema. </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_ISLETS_CROSSED_A_4</LocID>             <Text>Ah, gracias por esta información tan «útil», Número 925, pero...  </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_ISLETS_CROSSED_925_4</LocID>           <Text>Annika, ¡¿has VISTO a esa cosa?!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_ISLETS_CROSSED_925_5</LocID>           <Text>Al grano, Número 925, por favor te lo pido. </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_ISLETS_CROSSED_925_6</LocID>           <Text>Como esa cosa nos atrape..., no podremos ayudar a Doug porque estaremos muertos. Tenemos que estudiarla antes de liberarlo a él.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_ISLETS_CROSSED_A_5</LocID>             <Text>Me repatea decirlo, pero tienes razón, Número 925. </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_ISLETS_CROSSED_925_7</LocID>           <Text>Decidido, pues. Vosotros dos despejad la ruta hasta la Chiquita. Yo preparé algunas «sorpresas» por si esa cosa se anima a cruzar a esta isla. </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_ISLETS_CROSSED_A_6</LocID>             <Text>Recibido, Número 925. </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_ISLETS_CROSSED_925_8</LocID>           <Text>Bien. Cambio y fuera. </Text>  </GameDBLocalizedString>
            
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_ISLETS_CROSSED_H_3</LocID>             <Text>¡Intenta no sonreír por lo menos, Estrellita! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_ISLETS_CROSSED_A_8</LocID>             <Text>¡Cállate y ponte a quemar algo, anda, guerrero de pura cepa! </Text>  </GameDBLocalizedString>
            
            <!--Red countdown till the second bridge is open-->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_RED_COUTDOWN_925_925_1</LocID>         <Text>Annika, olvídate de la Chiquita un momento. ¡Un sabueso nos indica que se acaba de abrir el puente que hay al norte! ¡Tienes que destruirlo! ¡Hazlo antes de que crucen!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_RED_COUTDOWN_925_A_1</LocID>           <Text>¿En esta misión no puede ir nada bien?</Text>  </GameDBLocalizedString>

            <!--Red countdown - fails-->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_RED_COUTDOWN_FAIL_925_HAK_1</LocID>    <Text>¡Armas preparadas! ¡Qué ganas de liarla parda! Vamos allá... ¡¡¡Ah!!!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_RED_COUTDOWN_FAIL_925_HAK_2</LocID>    <Text>¡CATAPÚN! ¡Toda la gloria de capturar a los soberanos será mía! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_RED_COUTDOWN_FAIL_925_HAK_3</LocID>    <Text>¡Te tengo! </Text>  </GameDBLocalizedString>
 
            <!--Red countdown - fails-->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_RED_COUTDOWN_DONE_925_RH_1</LocID>     <Text>¡Con eso tendremos algo de tiempo!</Text>  </GameDBLocalizedString>

            <!--Relic attacks 925 at the gate-->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_RELIC_ATTACKS_925_925_1</LocID>        <Text>Estructuras defensivas operativas.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_RELIC_ATTACKS_925_H_1</LocID>          <Text>Oye, ¡qué pasada!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_RELIC_ATTACKS_925_925_2</LocID>        <Text>Gracias, pero... ¡Chist! ¡¿Lo oyes?! ¡Tengo que largarme!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_RELIC_ATTACKS_925_925_3</LocID>        <Text>¡Es la cosa! ¡Veo que he terminado los preparativos justo a tiempo!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_RELIC_ATTACKS_925_925_4</LocID>        <Text>Y... puerta cerrada. </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_RELIC_ATTACKS_925_925_5</LocID>        <Text>¡¿Pero qué...?!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_RELIC_ATTACKS_925_925_6</LocID>        <Text>¿Qué está haciendo?</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_RELIC_ATTACKS_925_925_7</LocID>        <Text>¡Mierda! ¡No se ve nada! ¡Pero es IMPOSIBLE que la cosa atraviese la puerta de los primordiales!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_RELIC_ATTACKS_925_925_8</LocID>        <Text>¡No puede ser!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_RELIC_ATTACKS_925_RELIC_1</LocID>      <Text>¡¿EL FAMOSO NÚMERO 925 ES UN ROBOT?! ESPERABA QUE ME DIERAS LA UBICACIÓN DE OTRO NÚCLEO, PERO NO TIENES SIQUIERA TEJIDO CEREBRAL. ¡MENUDA PÉRDIDA DE TIEMPO! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_RELIC_ATTACKS_925_925_9</LocID>        <Text>Annika, ¡llévate la Chiquita y HUYE! ¡Yo...! [RUIDO DE INTERFERENCIA ELÉCTRICA] </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_RELIC_ATTACKS_925_A_1</LocID>          <Text>¡Número 925! ¡Número 925! ¡¡¡ME CAGO EN...!!!</Text>  </GameDBLocalizedString>
         
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_RELIC_ATTACKS_925_H_2</LocID>          <Text>Ese cañón está minado de sorpresas desagradables, pero, para cuando llegue esa cosa, tenemos que estar más que lejos de aquí.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_RELIC_ATTACKS_925_A_2</LocID>          <Text>Sí, nos vemos en la Chiquita. El primero que llegue, que vaya precalentando el motor, ¿de acuerdo?</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_RELIC_ATTACKS_925_H_3</LocID>          <Text>Sí.</Text>  </GameDBLocalizedString>

            <!--ship_spotted-->        
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_SHIP_SPOTTED_RH_1</LocID>              <Text>¡Mira! ¡Es la Chiquita! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_SHIP_SPOTTED_RH_2</LocID>              <Text>La nave más rápida de la flota soberana. </Text>  </GameDBLocalizedString>
           
            <!--first in possition-->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_PREHEAT_RH_1</LocID>                   <Text>¡Ya estoy! Vaya, los motores están congelados. Vamos a tardar un tiempo en poder despegar. </Text>  </GameDBLocalizedString>
            
            <!--END-->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_END_A_1</LocID>                        <Text>Voy a comprobar los motores... ¡Ya casi está! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_END_RELIC_1</LocID>                    <Text>ANNIKA FINCH. ESTOY VIÉNDOTE DUDAR. ¡SÉ QUE HAS VISTO LOS NÚCLEOS! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_END_H_1</LocID>                        <Text>Estrellita, no quiero meterte más presión de la que tienes, pero ¡tenemos a esa cosa ENCIMA! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_END_A_2</LocID>                        <Text>¡LO SÉ, lo sé! ¡Hago lo que pueda! Los motores tienen que precalentarse del todo, porque si no... </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_END_H_2</LocID>                        <Text>¡Acelera ya! ¡Quema a esa cosa con la explosión de los motores! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_PIRATES_LVL2_END_A_3</LocID>                        <Text>¡POR FIN! ¡Los motores están en verde! ¡Quémate, hijo de puta! ¡QUÉMATE! </Text>  </GameDBLocalizedString>

            <!--DR brown by mohl způsobit první malfunction-->
        </LocalizedStrings>
    </GameDBStringTable>
