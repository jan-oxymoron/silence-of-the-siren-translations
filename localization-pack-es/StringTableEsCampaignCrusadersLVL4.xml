        <LocalizedStrings>
            <!--OBJECTIVES MAIN QUESTS-->
            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_CRUSADERS_START_LVL4</LocID>                      <Text>Atrae la flota de la UNSS</Text>  </GameDBLocalizedString>

            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_CRUSADERS_LVL4_CRUS_BASES_1</LocID>               <Text>Ocupa las bases cercanas 0/4</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_CRUSADERS_LVL4_CRUS_BASES_2</LocID>               <Text>Ocupa las bases cercanas 1/4</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_CRUSADERS_LVL4_CRUS_BASES_3</LocID>               <Text>Ocupa las bases cercanas 2/4</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_CRUSADERS_LVL4_CRUS_BASES_4</LocID>               <Text>Ocupa las bases cercanas 3/4</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_CRUSADERS_LVL4_CRUS_BASES_DONE</LocID>            <Text><![CDATA[<color=SOTS_COLOR_MOVEMENT>Ocupa las bases cercanas 4/4 - Terminada</color>]]></Text>  </GameDBLocalizedString>

            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_CRUSADERS_LVL4_STASH_1</LocID>                    <Text>Consigue recursos 0/3</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_CRUSADERS_LVL4_STASH_2</LocID>                    <Text>Consigue recursos 1/3</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_CRUSADERS_LVL4_STASH_3</LocID>                    <Text>Consigue recursos 2/3</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_CRUSADERS_LVL4_STASH_DONE</LocID>                 <Text><![CDATA[<color=SOTS_COLOR_MOVEMENT>Consigue recursos 3/3 - Terminada</color>]]></Text>  </GameDBLocalizedString>


            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_CRUSADERS_LVL4_CROSS_BRIDGE</LocID>               <Text>Cruza el puente</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_CRUSADERS_LVL4_CROSS_BRIDGE_DONE</LocID>          <Text><![CDATA[<color=SOTS_COLOR_MOVEMENT>Cruza el puente. - Terminada</color>]]></Text>  </GameDBLocalizedString>
            
            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_CRUSADERS_LVL4_REPAIR_TELEPORT</LocID>            <Text><![CDATA[Repara el teletransporte <color=SOTS_COLOR_RED>con la Princesa</color>]]></Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_CRUSADERS_LVL4_REPAIR_TELEPORT_DONE</LocID>       <Text><![CDATA[<color=SOTS_COLOR_MOVEMENT>Repara el teletransporte con la Princesa - Terminada</color>]]></Text>  </GameDBLocalizedString>
            
            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_CRUSADERS_LVL4_OPEN_BRIDGE</LocID>                <Text><![CDATA[Abre el puente <color=SOTS_COLOR_RED>con la Princesa</color>]]></Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_CRUSADERS_LVL4_OPEN_BRIDGE_DONE</LocID>           <Text><![CDATA[<color=SOTS_COLOR_MOVEMENT>Abre el puente con la Princesa - Terminada</color>]]></Text>  </GameDBLocalizedString>

            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_CRUSADERS_LVL4_SF_BASES_1</LocID>                 <Text>Captura las bases de los mercenarios 0/2</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_CRUSADERS_LVL4_SF_BASES_2</LocID>                 <Text>Captura las bases de los mercenarios 1/2</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_CRUSADERS_LVL4_SF_BASES_DONE</LocID>              <Text><![CDATA[<color=SOTS_COLOR_MOVEMENT>Captura las bases de los mercenarios 2/2 - Terminada</color>]]></Text>  </GameDBLocalizedString>
           
            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_CRUSADERS_LVL4_SF_MERCHS_1</LocID>                <Text>Derrota a los mercenarios 0/2</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_CRUSADERS_LVL4_SF_MERCHS_2</LocID>                <Text>Derrota a los mercenarios 1/2</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_CRUSADERS_LVL4_SF_MERCHS_DONE</LocID>             <Text><![CDATA[<color=SOTS_COLOR_MOVEMENT>Derrota a los mercenarios 2/2 - Terminada</color>]]></Text>  </GameDBLocalizedString>
  
          
            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_CRUSADERS_LVL4_RAM_GATE</LocID>                   <Text><![CDATA[Derriba la puerta <color=SOTS_COLOR_RED>con la Princesa</color>]]></Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_CRUSADERS_LVL4_RAM_GATE_DONE</LocID>              <Text><![CDATA[<color=SOTS_COLOR_MOVEMENT>Derriba la puerta con la Princesa - Terminada</color>]]></Text>  </GameDBLocalizedString>
            
            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_CRUSADERS_LVL4_UNSS_BASES_1</LocID>               <Text>Captura bases de la UNSS 0/4</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_CRUSADERS_LVL4_UNSS_BASES_2</LocID>               <Text>Captura bases de la UNSS 1/4</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_CRUSADERS_LVL4_UNSS_BASES_3</LocID>               <Text>Captura bases de la UNSS 2/4</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_CRUSADERS_LVL4_UNSS_BASES_4</LocID>               <Text>Captura bases de la UNSS 3/4</Text>  </GameDBLocalizedString>

            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_CRUSADERS_LVL4_GET_TO_SHIP</LocID>                <Text><![CDATA[<color=SOTS_COLOR_RED>Lleva a la Princesa hasta la Estrella Brillante - turno(s) restante(s):</color>]]></Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_CRUSADERS_LVL4_GET_TO_SHIP_DONE</LocID>           <Text><![CDATA[<color=SOTS_COLOR_MOVEMENT>Lleva a la Princesa hasta la Estrella Brillante - Terminada</color>]]></Text>  </GameDBLocalizedString>
            
            <!--DIALOGUES-->
            <!--Heroes arrived to the orbit of planet Sirena, on the surface there is main base Princess evil sister. They are standing next to ancient battleship Bright Star.   -->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_START_NARRATOR_1</LocID>             <Text>En el campo de asteroides de Sirena, cuarto planeta del sistema. </Text>  </GameDBLocalizedString>
            
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_START_VIKTAR_1</LocID>               <Text>¡Tiene gracia! Ahora, ¿podría la Princesa contarnos el plan de verdad? </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_START_PRINCESS_1</LocID>             <Text>No era broma, Viki.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_START_VIKTAR_2</LocID>               <Text>¡Pues ojalá lo fuera! Si atraemos a la flota de la UNSS aquí, nos aniquilarán desde la órbita. ¡Así de fácil! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_START_PRINCESS_2</LocID>             <Text>¡Eso no pasará! Cuando las naves de la UNSS lleguen, llamaré a la Estrella Brillante...</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_START_ANGAEDE_1</LocID>              <Text>... Y USARÉ MI CONEXIÓN CON LAS NAVES DE LA UNSS PARA TRANSMITIR LA VOZ DE LA PRINCESA CON LAS PALABRAS DE LA LETANÍA.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_START_TIN_1</LocID>                  <Text>Con la flota de la UNSS en nuestras manos, ¡les daremos a probar su propia medicina! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_START_PRINCESS_2.5</LocID>           <Text>Estoy bastante segura de que ni siquiera mi hermana sobrevivirá a un bombardeo orbital. </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_START_GILEAS_1</LocID>               <Text>Pero ¿por qué actuar tan pronto? Las palabras de la Estrella Brillante culpan al gran Zieregal de los crímenes de los que acusaba a la Princesa y los otros clones de la Madre Absoluta. Cuando los otros Vástagos escuchen la verdad, vendrán a ayudar como yo. </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_START_PRINCESS_3</LocID>             <Text>Cuando mi hermana descubra que la Estrella Brillante existe, intentará robarla del mismo modo que vamos a robar la flota de la UNSS. ¡Debemos atacar ahora! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_START_VIKTAR_3</LocID>               <Text>Entonces, ¿por qué hemos desembarcado en órbita, Princesa?   </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_START_TIN_2</LocID>                  <Text>Durante la cruzada, hasta la órbita fue un campo de batalla y, después de todo este tiempo, las bases siguen aquí. Aprovechemos para prepararnos. Cuando bajemos a tierra, nos descubrirán.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_START_VIKTAR_4</LocID>               <Text>De acuerdo, me rindo... por ahora. </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_START_PRINCESS_4</LocID>             <Text>¡Vamos!</Text>  </GameDBLocalizedString>
          
            <!--After the dialog, everybody is teleported to their bases, Princess turns around and deactivates the bridge leading to Bright Star orbital islet.--> 
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_START_PRINCESS_5</LocID>             <Text>Por si acaso.</Text>  </GameDBLocalizedString> 
           
            <!--All Childrens bases are captured, now the heroes focus on gathering resources and exploration. Some production building are missing in orbit though. -->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_CRUS_BASES_PRINCESS_1</LocID>        <Text>Bien, con esta están todas.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_CRUS_BASES_TIN_1</LocID>             <Text>Algunos recursos no se pueden producir aquí arriba. Tal vez tengamos que bajar mucho antes de lo previsto.  </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_CRUS_BASES_PRINCESS_2</LocID>        <Text>Abriré el teletransporte de bajada, pero solo cuando agotemos las alternativas. Hay unos pecios cerca... </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_CRUS_BASES_GILEAS_1</LocID>          <Text>¿Ahora nos dedicamos al saqueo?  </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_CRUS_BASES_VIKTAR_1</LocID>          <Text>Déjate de remilgos, humano. Los muertos no necesitan cargamentos. </Text>  </GameDBLocalizedString>

             <!--Time to repair the teleport down.-->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_REPAIR_TELEPORT_RH_1</LocID>         <Text>Hemos agotado todas las grandes reservas de recursos. Hora de abrir el teletransporte de bajada.  </Text>  </GameDBLocalizedString>
        
            <!-- Teleport is repaired.-->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_TELEPORT_REPAIRED_PRINCESS_1</LocID> <Text>El camino hacia abajo está abierto.</Text>  </GameDBLocalizedString>
            
            <!--  Princes, has used the teleport and descended to the ground.-->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_ON_THE_GROUND_PRINCESS_1</LocID>     <Text>¡Estoy abajo, en la superficie!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_ON_THE_GROUND_GILEAS_1</LocID>       <Text>¿Puedes usar esa «psicosfera» para explorar?  </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_ON_THE_GROUND_PRINCESS_2</LocID>     <Text>No, podría alertar a mi hermana.  </Text>  </GameDBLocalizedString>

            <!--Part of the map is separated by the landslide, but the road suggest the area was passable once.-->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_LAND_SLIDE_RH_1</LocID>              <Text>Esta carretera ha sido bloqueada por un desprendimiento. Podríamos despejar el camino con una explosión, ¡pero sería como tocar un cuerno de batalla!  </Text>  </GameDBLocalizedString>

            <!--Hero encounters first UNSS commander. The UNSS commander runs to the near bridge and cross to avoid confrontation.-->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_GAHIJI_REPORT_GAHIJI_1</LocID>       <Text>¡Capitán Rao! ¡Tenemos visita!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_GAHIJI_REPORT_RAO_1</LocID>          <Text>¡Cubrid el puente, enviad mercenarios a asegurarlo! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_GAHIJI_REPORT_GAHIJI_2</LocID>       <Text>¡Recibido!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_GAHIJI_REPORT_RH_1</LocID>           <Text>Así que empezamos.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_GAHIJI_REPORT_PRINCESS_1</LocID>     <Text>Por el lado bueno, ya no tiene sentido evitar la psicosfera. </Text>  </GameDBLocalizedString>
            
           <!-- Hero get close to the now deactivated bridge and overhears the conversation of enemy commanders. Gahiji reports he spotted enemy to Captain Rao and Dr. Brown 9B. -->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_BRIDGE_DIALOG_GAHIJI_1</LocID>       <Text>... Están cerca de aquí.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_BRIDGE_DIALOG_RAO_1</LocID>          <Text>Ya veo... Buen trabajo con lo de desconectar el puente, comandante Gahiji. No podemos subestimarlos otra vez.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_BRIDGE_DIALOG_BROWN_1</LocID>        <Text>¡Menudo tono más cortante, Rao! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_BRIDGE_DIALOG_RAO_2</LocID>          <Text>¡Te lo tienes merecido, 9B! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_BRIDGE_DIALOG_BROWN_2</LocID>        <Text>¡Gergie-larh! ¡¿Sabes qué, maldito pirata?!... Que tienes razón, la cagué. ¿Quién va a decírselo a Ella?  </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_BRIDGE_DIALOG_RAO_3</LocID>          <Text>Lo haré yo. Si le traes más malas noticias, podría arrancarte la cabeza de un mordisco. </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_BRIDGE_DIALOG_BROWN_3</LocID>        <Text>Sería capaz... Gracias, Rao... </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_BRIDGE_DIALOG_RAO_4</LocID>          <Text>Solo queda una cosa que hacer. Llamemos a Furret.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_BRIDGE_DIALOG_RAO_5</LocID>          <Text>Líder Supremo, ¿algún progreso con la voladura de las rocas que bloquean la carretera al este?   </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_BRIDGE_DIALOG_FURRET_1</LocID>       <Text>Estas cosas hay que hacerlas con paciencia, capitán. El más mínimo error podría causar un desprendimiento mayor. ¡No puedo correr!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_BRIDGE_DIALOG_TIN_1</LocID>          <Text>¡¿Furret también está aquí?! ¡Ese cabrón traicionero intenta llegar a nuestra retaguardia!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_BRIDGE_DIALOG_PRINCESS_1</LocID>     <Text>Deberíamos prepararnos para esa posibilidad.</Text>  </GameDBLocalizedString>
            
            <!-- Princess uses her abilities to activate the bridge. -->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_ACTIVATE_BRIDGE_PRINCESS_1</LocID>   <Text>¡Los puentes desactivados son mi especialidad!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_ACTIVATE_BRIDGE_PRINCESS_2</LocID>   <Text>Pan comido.</Text>  </GameDBLocalizedString>
            
            
           <!-- After crossing the bridge two Sovereign fleet mercenaries appear. #ALFA is humanoid robot, Freddie is young, roguish pirate.--> 
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_MERCS_ALFA_1</LocID>                 <Text>Mi RAM se derrite intentando evaluar la amenaza. ¡No te va a gustar el resultado, Freddie! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_MERCS_FREDDIE_1</LocID>              <Text>¡Cállate, ALFA! ¡Vamos a joderles! ¡Me huelo una historia épica, relatada por bares espaciales de todo el sistema! ¡Seremos el mayor imán de pibas del universo! ¡Sí, nena! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_MERCS_ALFA_2</LocID>                 <Text>¡Ay, ay, ay, Freddie! ¡No sé qué me gusta menos! ¡Las pibas o los imanes!   </Text>  </GameDBLocalizedString>
          
            
           <!-- After the firt Sovereign (merc) base is taken, Kali Chapek and Grand Manny appear to help our heroes.-->  
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_KALI_MANNY_KALI_1</LocID>            <Text>Hemos oído que necesitas una mano, Lata.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_KALI_MANNY_TIN_1</LocID>             <Text>¡Pues sí! Pero ¿cómo?...</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_KALI_MANNY_MANNY_1</LocID>           <Text>Con tantos soberanos en manos de la UNSS, la red es un colador. Hemos escuchado las comunicaciones de esos «mercenarios» de tercera. </Text>  </GameDBLocalizedString>
           
             <!--All mercenaries are defeated the way to the Primal gate that separate the UNSS part of the map is clear.-->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_MERCS_DEFEATED_RH_1</LocID>          <Text>¡Los mercenarios están acabados! ¡Es hora de avanzar! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_MERCS_DEFEATED_PRINCESS_1</LocID>    <Text>Si los mandos de la UNSS no llaman a la flota cuando eche abajo la puerta, ¡no sé cuándo lo harán!</Text>  </GameDBLocalizedString>
            
            <!--Heroes encounters Doug Porter, the friend of Annika. He was captured by UNSS in the second mission of Sovereign Fleet campaign and his faite was unknown until now.-->   
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_DOUG_DOUG_1</LocID>                  <Text>... Os hablaré del Núcleo... 925, ¿me recibes?... Ciclo de precalentamiento de Chiquita...</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_DOUG_RH_1</LocID>                    <Text>Otro mercenario... ¿Qué murmura?</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_DOUG_TIN_1</LocID>                   <Text>Espera, ¡es Doug! ¡Doug Porter! Lo recuerdo, era amigo de Annika. ¡Tu hermana lo atrapó en Quimera!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_DOUG_PRINCESS_1</LocID>              <Text>¿Amigo de Annika? ¿Crees que podríamos persuadirlo para que se una a nosotros? </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_DOUG_RH_2</LocID>                    <Text>¡Doug! ¡Eh, Doug! ¡¿Me oyes?!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_DOUG_DOUG_2</LocID>                  <Text>... #925, dale, a toda caña... tenemos que dejarle un mensaje a mi churri... ¡¿QUÉ?! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_DOUG_DOUG_3</LocID>                  <Text>Objetivo de comunicación: Capitán Rao.\nRecurso humano: Porter. \nInforme: Enemigo a las puertas. \nSolicitud: Órdenes. </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_DOUG_RAO_1</LocID>                   <Text>Pobre desgraciado. Si estuviera allí, no permitiría que le trataran así... </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_DOUG_BROWN_1</LocID>                 <Text>No moverías un dedo. Estaba furiosa... «¿Quieres que llegue algún transporte del sistema solar por la estación Umbral?»... </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_DOUG_RAO_2</LocID>                   <Text>Suena a algo que diría Ella... Sí, supongo que era parte del trato cuando aceptamos Su ayuda en aquel momento. </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_DOUG_BROWN_2</LocID>                 <Text>Rao a Porter... al ataque.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_DOUG_DOUG_4</LocID>                  <Text>Recurso humano: Porter. \nEstado: ¡Atacando al enemigo! </Text>  </GameDBLocalizedString>

            <!--Heroes encounters Doug Porter, the friend of Annika. He was captured by UNSS in the second mission of Sovereign Fleet campaign and his faite was unknown until now.-->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_DOUG_AF_PRINCESS_1</LocID>           <Text>¡No le hagáis daño! No controla sus acciones.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_DOUG_AF_HIERARCH_1</LocID>           <Text>¿Puedes ayudarle?</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_DOUG_AF_PRINCESS_2</LocID>           <Text>Lo dudo. No he visto antes su psique. Mi intervención podría empeorar las cosas.</Text>  </GameDBLocalizedString>
            
            <!--Princes rams the Primals gate that leads on UNSS port of the map.-->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_GATE_RAMMING_PRINCESS_1</LocID>      <Text>Los tiempos en los que necesitaba debilitar el campo de fuerza de la puerta quedan muy atrás. </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_GATE_RAMMING_BROWN_1</LocID>         <Text>¡El campo de fuerza de la puerta ha caído! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_GATE_RAMMING_RAO_1</LocID>           <Text>Furret, ¡¿se puede saber a qué esperas?! ¡Necesitamos abrir otro frente y que tus fossorianos entren en acción!  </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_GATE_RAMMING_FURRET_1</LocID>        <Text>¡Casi estamos, capitán! Solo tengo que recalcular el volumen de explosivo para... </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_GATE_RAMMING_RELIC_1</LocID>         <Text>FURRET, ¡UNA EXCUSA MÁS Y EJECUTARÉ A MÁS DE TUS «MUCHACHOS» DE LOS QUE LA EXPLOSIÓN PODRÍA MATAR! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_GATE_RAMMING_RELIC_1.5</LocID>       <Text>RAO, ¿ESTÁ MI FLOTA EN POSICIÓN PARA EL BOMBARDEO? </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_GATE_RAMMING_RAO_2</LocID>           <Text>La flota de la UNSS sigue en camino. ¡El campo de asteroides de la órbita dificulta las maniobras!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_GATE_RAMMING_RELIC_2</LocID>         <Text>¡¿NECESITO MOTIVARLES COMO HAGO CON LOS FOSSORIANOS?!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_GATE_RAMMING_TIN_1</LocID>           <Text>Cuanto más desesperados estén, menos probable es que descubran nuestro plan. ¡Presionadles! ¡Atacad sus bases! </Text>  </GameDBLocalizedString>

             <!--Upon conquering the Firs UNSS base the Fossorians led by Supreme leader Furret blow up the landslide. Everybody expects that they attack our heroes, but they turn the coat and join the players team.--> 
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_FURRET_PART_FURRET_1</LocID>         <Text>3, 2, 1... ¡Bomba va! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_FURRET_PART_HOLESTER_1</LocID>       <Text>¡YIIIJAAA! ¡Entramos por la brecha, equipo!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_FURRET_PART_TIN_1</LocID>            <Text>¡Los fossorianos de Furret! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_FURRET_PART_VIKTAR_1</LocID>         <Text>¡Cabrón traicionero!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_FURRET_PART_KALI_1</LocID>           <Text>¡Se veía venir desde leguas!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_FURRET_PART_GILEAS_1</LocID>         <Text>¡Reagrupaos!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_FURRET_PART_HOLESTER_2</LocID>       <Text>¡No hace falta! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_FURRET_PART_FURRET_2</LocID>         <Text>¡Es hora de que los fossorianos volvamos a luchar por nuestro propio futuro! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_FURRET_PART_RELIC_1</LocID>          <Text>¡ABRIRÉ EL CAMINO A VUESTRO MUNDO DE ORIGEN, Y, CUANDO VUESTROS ANTIGUOS CAUDILLOS SE OCUPEN DE VOSOTROS, SERÁN MIS NUEVAS MASCOTAS! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_FURRET_PART_FURRET_3</LocID>         <Text>¡¿De verdad?! Entonces, ¿por qué lleva tanto cerrada? ¡Y eso que la UNSS necesita suministros desesperadamente! ¡No puedes abrirla más! ¡¿Verdad?! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_FURRET_PART_RELIC_2</LocID>          <Text>FURRET, INSENSATO...   </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_FURRET_PART_FURRET_4</LocID>         <Text>¡Siempre he sido un insensato! ¡Apostarlo todo a una carta! ¡Es la forma de vida fossoriana!</Text>  </GameDBLocalizedString>
             
            <!--The second UNSS base is captured, the Relic wants to start orbital bombardment now.-->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_UNSS_BASE_TWO_RELIC_1</LocID>        <Text>¡QUIERO QUE EL BOMBARDEO EMPIECE AHORA! ¡DE UNA PUTA VEZ! ¡Y CONTRA LOS FOSSORIANOS TAMBIÉN!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_UNSS_BASE_TWO_RAO_1</LocID>          <Text>¡Hay una evacuación en curso! ¡Nuestra gente siempre en la zona! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_UNSS_BASE_TWO_TIN_1</LocID>          <Text>¿Cómo? ¿Podemos interceptar las comunicaciones de la UNSS? </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_UNSS_BASE_TWO_FURRET_1</LocID>       <Text>Es un regalito de nada... Espero que tengas un plan, Princesa. </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_UNSS_BASE_TWO_GILEAS_1</LocID>       <Text>Sí, pero no es el mejor momento para explicarlo...</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_UNSS_BASE_TWO_FURRET_2</LocID>       <Text>No hace falta que expliques nada. Dinos dónde y cuándo, ¡y les daremos lo suyo!</Text>  </GameDBLocalizedString>

            <!--The third UNSS base is captured - pt1, UNSS fleet is ready to bombard. Princess take control over the fleet by broadcasting the litany through the ship Bright Star on the orbit.-->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_UNSS_BASE_THREE_RELIC_1</LocID>      <Text>¡DA LA ORDEN, RAO! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_UNSS_BASE_THREE_RAO_1</LocID>        <Text>¡NO! ¡Nuestra gente sigue ahí abajo!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_UNSS_BASE_THREE_RELIC_2</LocID>      <Text>SI QUIERES VER UN SOLO TRANSPORTE DEL SISTEMA SOLAR PASAR POR LA ESTACIÓN UMBRAL, ¡DARÁS LA ORDEN! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_UNSS_BASE_THREE_BROWN_1</LocID>      <Text>Lo siento, Rao, no tenemos alternativa. Fuerzas de tierra a flota de la UNSS, informe de estado.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_UNSS_BASE_THREE_NIOTA_1</LocID>      <Text>¡UNSS Rickenbacker, en posición! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_UNSS_BASE_THREE_TAKESHI_1</LocID>    <Text>¡UNSS Ira de Khan, armas preparadas! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_UNSS_BASE_THREE_MAYA_1</LocID>       <Text>¡UNSS Normandía, arsenal de misiles activado! </Text>  </GameDBLocalizedString>
            
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_UNSS_BASE_THREE_TIN_1</LocID>        <Text>¡AHORA! ¡Es el momento!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_UNSS_BASE_THREE_PRINCESS_1</LocID>   <Text>¡¿Estrella Brillante, me recibes?! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_UNSS_BASE_THREE_ANGAEDE_1</LocID>    <Text>SÍ. ESTOY LISTA. ESTOY PREPARADA PARA TRANSMITIR TUS PALABRAS A LAS NAVES DE LA UNSS.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_UNSS_BASE_THREE_PRINCESS_2</LocID>   <Text>EMPECEMOS...</Text>  </GameDBLocalizedString>

            <!--The third UNSS base is captured - pt2 Princes evil sister learns what happened and teleports to orbit although it should not be possible.-->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_UNSS_BASE_THREE_NIOTA_2</LocID>      <Text>UNSS Rickenbacker a fuerzas de tierra, ¡tenemos fallos en múltiples sistemas!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_UNSS_BASE_THREE_TAKESHI_2</LocID>    <Text>UNSS Normandía, el sistema no responde, ¡las consolas están bloqueadas! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_UNSS_BASE_THREE_MAYA_2</LocID>       <Text>¡Hay algo apuntando nuestras armas a vuestra posición! Thomas, Rao... [DISTORSIÓN DE SEÑAL]... ¡CORRED!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_UNSS_BASE_THREE_BROWN_2</LocID>      <Text>¡Por el Pozo Negro del Nadir! ¿Qué está pasando ahí?</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_UNSS_BASE_THREE_RELIC_3</LocID>      <Text>¡SOLO HAY UNA EXPLICACIÓN POSIBLE! HAN USADO LA LETANÍA. HAN DESCUBIERTO QUE LA IA DE LAS NAVES DE LA UNSS COMPARTE ORIGEN CON LA DE LAS NAVES DE LOS VÁSTAGOS. ¡DEBO IR A LA ÓRBITA DE INMEDIATO!  </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_UNSS_BASE_THREE_RELIC_4</LocID>      <Text>¡LA PSICOSFERA DE AHÍ ARRIBA ES UN LÍO! NO VEO BIEN... ¡ESPERA, AHÍ ESTÁ!... ¡UN PARCHE NUEVO!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_UNSS_BASE_THREE_PRINCESS_3</LocID>   <Text>¡IMPOSIBLE! ¡¿Cómo?! ¡Se ha teletransportado a la órbita! ¡Eso no debería ser posible!... Estrella Brillante, ¿me recibes? ¡ESTRELLA BRILLANTE!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_UNSS_BASE_THREE_ANGAEDE_2</LocID>    <Text>...</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_UNSS_BASE_THREE_PRINCESS_4</LocID>   <Text>¡MIERDA! ¡Debo llegar a la Estrella Brillante!  </Text>  </GameDBLocalizedString>

            <!--Princess realises thet there is not enough time to reach the orbit and tries to teleport as well - she appears in orbit though on wrong place. She teleports again, this time on the right spot. -->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_EMERGENCY_TELEP_PRINCESS_1</LocID>   <Text>¡No llegaré a tiempo! ¡Tendré que teletransportarme como mi hermana! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_EMERGENCY_TELEP_TIN_1</LocID>        <Text>¡No, es demasiado peligroso! Nunca has intentado...  </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_EMERGENCY_TELEP_PRINCESS_2</LocID>   <Text>Si recupera el control de la flota de la UNSS, ¡moriremos de todos modos!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_EMERGENCY_TELEP_PRINCESS_3</LocID>   <Text>¡Casi me he teletransportado al interior de ese montón de chatarra! Vale, ¡otro intento!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_EMERGENCY_TELEP_PRINCESS_4</LocID>   <Text>¡Creo que le estoy cogiendo el truco! </Text>  </GameDBLocalizedString>
            
            <!--Princess is coming to ship Bright Star, in the ships shadow the Princess evil sister awaits with Annika brainwashed into serving UNSS. --> 
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_END_1_RELIC_1</LocID>                <Text>SABÍA QUE VENDRÍAS, HERMANITA. PERO NO LUCHARÉ CONTRA TI.   </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_END_1_PRINCESS_1</LocID>             <Text>¿Tienes miedo?  </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_END_1_RELIC_2</LocID>                <Text>NO. SENCILLAMENTE, NO NECESITO HACERLO. HE PREPARADO UNA HERRAMIENTA PARA ESTA OCASIÓN.    </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_END_1_PRINCESS_2</LocID>             <Text>¡¿Annika?!  </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_END_1_RELIC_3</LocID>                <Text>LO QUE QUEDA DE ELLA.   </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_END_1_PRINCESS_3</LocID>             <Text>¿Qué ordenas?   </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_END_1_RELIC_4</LocID>                <Text>¡MÁTALA! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_END_1_ANNIKA_1</LocID>               <Text>Sí, señora.   </Text>  </GameDBLocalizedString>
            
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_END_2_PRINCESS_1</LocID>             <Text>¡Annika! ¡No le hagas caso! ¡He venido con Lata! ¡No quiero hacerte daño! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_END_2_RELIC_1</LocID>                <Text>¡SABÍA QUE TE CONTENDRÍAS AL LUCHAR CON ESTA CHUSMA, HERMANA! CLARAMENTE, HE ELEGIDO LA HERRAMIENTA ADECUADA. </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_END_2_PRINCESS_2</LocID>             <Text>¡Lucha, Annika! ¡Puedes librarte de su influjo!   </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_END_2_RELIC_2</LocID>                <Text>¡ESTÁS PERDIENDO EL TIEMPO! QUEBRANTÉ SU VOLUNTAD HACE MUCHO. ESTÁ TOTALMENTE BAJO MI CONTROL. </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_END_2_PRINCESS_3</LocID>             <Text>¡Pagarás por lo que le has hecho! </Text>  </GameDBLocalizedString>
            
              <!-- Annika is defeated and captured by Princess.-->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_END_3_PRINCESS_1</LocID>             <Text>¡Atrapadla! ¡No hagáis daño a Annika! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_END_3_ANNIKA_1</LocID>               <Text>¡Quitadme las manos de encima! ¡Soltadme! </Text>  </GameDBLocalizedString>
            
               <!--Princess talks to her sister and learning important information before the final fight.--> 
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_END_4_RELIC_1</LocID>                <Text>UNA LÁSTIMA. DEBERÍA HABER SABIDO QUE NO HAY NADIE CAPAZ DE DERROTARTE... ¡APARTE DE MÍ! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_END_4_PRINCESS_1</LocID>             <Text>¿Y a qué esperas para hacerlo?   </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_END_4_RELIC_2</LocID>                <Text>¡YA SÉ QUE TENÍAS GANAS DE LIBRAR UN DUELO ÉPICO ENTRE DOS DIOSAS ESPACIALES! PERO DEBO DECEPCIONARTE, HERMANA. ¡NINGUNA DE LAS DOS PUEDE USAR NUESTRO PODER!  </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_END_4_PRINCESS_2</LocID>             <Text>¡¿Qué clase de artimaña es esta?!   </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_END_4_RELIC_3</LocID>                <Text>NO ES UNA ARTIMAÑA. SI LUCHAMOS, ¡NOS OIRÁN!   </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_END_4_PRINCESS_3</LocID>             <Text>¿De qué narices estás hablando?   </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_END_4_RELIC_4</LocID>                <Text>¡DE NUESTRAS HERMANAS EN OTROS SISTEMAS SOLARES! CUANDO EMPECEMOS, ¡NO PODREMOS CONTENERNOS! ¡Y NUESTRA ESPECIE LO OIRÁ!   </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_END_4_PRINCESS_4</LocID>             <Text>¡Estás mintiendo! ¡Quieres distraerme antes de empezar a luchar!  </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_END_4_RELIC_5</LocID>                <Text>¿POR QUÉ CREES QUE DEJÉ DE USAR LA ESTACIÓN UMBRAL Y EXTERMINÉ A TODAS NUESTRAS HERMANAS? ¡PARA QUE EL SISTEMA VOLVIERA A SER INVISIBLE! ¡Y LLEGAS TÚ Y EMPIEZAS A HACER LO CONTRARIO!   </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_END_4_PRINCESS_5</LocID>             <Text>No te creo. </Text>  </GameDBLocalizedString>
            
               <!--Princess won, but her sister decides to use her psionic powers although this will attract the unwanted attention of the other Allmothers clones in the different solar systems.-->  
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_END_5_PRINCESS_1</LocID>             <Text>¡Has perdido!  </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_END_5_RELIC_1</LocID>                <Text>SOLO HE PERDIDO MI EJÉRCITO. ¡PERO LA MADRE ABSOLUTA EN MI INTERIOR PREFIERE INVITAR A TODO EL UNIVERSO QUE CEDERTE EL PODER! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_END_5_RELIC_2</LocID>                <Text>¡MUERE!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_END_5_PRINCESS_2</LocID>             <Text>¡Que así sea!</Text>  </GameDBLocalizedString>
            
               <!-- It's over, Tin comes to the Princess acknowledging her victory. She shared information about the possible future event. End cutscene.-->  
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_END_TIN_1</LocID>                    <Text>¡Lo has conseguido! ¡Has ganado! Hemos... ¡¿QUÉ?! ¿Esa es Annika?... Estrellita, ¿puedes oírme?  </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_END_PRINCESS_1</LocID>               <Text>SÍ. Era el último intento de mi hermana de derrotarme sin usar sus poderes. Quería ocultar el sistema al resto de mi especie.   </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_END_TIN_2</LocID>                    <Text>¡Pero has usado tus poderes! ¡He visto el estallido! No... ¡No lo entiendo!   </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_END_PRINCESS_2</LocID>               <Text>Te lo explicaré. Pero me preocupa el que mi victoria solo nos haya conseguido una tregua temporal. Si mi especie viene, tendremos que prepararnos. El sistema entero deberá unir sus fuerzas.   </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_END_TIN_3</LocID>                    <Text>¿Estás pensando en aceptar tu legado? ¿En aceptar la Madre Absoluta de tu interior?   </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_END_PRINCESS_3</LocID>               <Text>Por ahora, no, pero me temo que pronto no nos quede alternativa.</Text>  </GameDBLocalizedString>
            
      <!--      BEFORE/AFTER FIGHT QUOTES-->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_MERCS_FREDDIE_2</LocID>              <Text>¡Has roto a Alfa! ¡La mayoría de sus piezas son de encargo!... ¡Pagaré las reparaciones con la prima que dan por tu cabeza! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_MERCS_ALFA_3</LocID>                 <Text>¡AY, AY, AY! ¡Espera, Freddie, voy a ayudarte!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_MERCS_RH_1</LocID>                   <Text>... otro que muerde el polvo.</Text>  </GameDBLocalizedString>
            
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_GAHIJI_AF_GAHIJI_1</LocID>           <Text>¡Están por todas partes! ¡Dirigid la artillería a mi posición!  </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_GAHIJI_AF_BROWN_1</LocID>            <Text>Como quieras. A la de tres...   </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_GAHIJI_AF_RAO_1</LocID>              <Text>¡No!  </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_GAHIJI_AF_BROWN_2</LocID>            <Text>De acuerdo, capitán aguafiestas.  </Text>  </GameDBLocalizedString>
            
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_ADELA_BF_RAO_1</LocID>               <Text>¡Saca a tu gente de ahí, Adela!  </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_ADELA_BF_ADELA_1</LocID>             <Text>Imposible, capitán, nos tienen rodeados... Yo... [ESTÁTICA DE RADIO]   </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_ADELA_BF_RAO_2</LocID>               <Text>Adela... ¡Adela!... ¡Mierda!  </Text>  </GameDBLocalizedString>

            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_ZAGLOBA_BF_ZAGLOBA_1</LocID>         <Text>Ale chujnia... ¡Do cholery! ¡Flanco izquierdo! ¡Reagrupaos!... </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_ZAGLOBA_BF_RAO_1</LocID>             <Text>¡Sargento, retirada!   </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_ZAGLOBA_BF_ZAGLOBA_2</LocID>         <Text>¡Imposible, muchacho!   </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_ZAGLOBA_BF_RAO_2</LocID>             <Text>¡Pues ríndete! ¡Es una orden, Zagloba! «¡Déjate de mierdas heroicas!» ¡Tú mismo le dijiste eso a un cadete hace mucho!  </Text>  </GameDBLocalizedString>
            
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_ZOLZAYA_BF_RAO_1</LocID>             <Text>¡Zolzaya, retirada!  </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL4_ZOLZAYA_BF_ZOLZAYA_1</LocID>         <Text>Estamos... ¡capitán!... [ESTÁTICA DE RADIO]  </Text>  </GameDBLocalizedString>

        </LocalizedStrings>
    </GameDBStringTable>
