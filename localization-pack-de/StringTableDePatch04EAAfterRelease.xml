            <GameDBLocalizedString>         <LocID>MAPOBJ_MOVEMENT_NODE_SMALL</LocID>                                   <Text>Bewegungsknoten</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MAPOBJ_MOVEMENT_NODE_SMALL_DESCRIPTION</LocID>                       <Text><![CDATA[<color=SOTS_COLOR_GOLD>Stellt</color> die <color=SOTS_COLOR_MOVEMENT>Bewegungspunkte</color> eines Kommandanten einmal pro Zyklus vollständig wieder her. (Wer zuerst kommt, mahlt zuerst.)]]></Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MAPOBJ_TOMB_OF_SWORDMASTER_DESCRIPTION_V2</LocID>                    <Text><![CDATA[Lernen aus dem heruntergeladenen Bewusstsein eines alten Meisters. Wenn du hier studierst, wird sich eines der <color=SOTS_COLOR_GOLD>Attribute</color> deines Kommandanten <color=SOTS_COLOR_GOLD>dauerhaft um 2 erhöhen</color>.\nJeder Kommandant kann hier nur ein einziges Mal studieren.]]></Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>DIALOG_LEVEL_UP_ATTRIBUTE_TEXT</LocID>                               <Text><![CDATA[Willkommen in meinem Grab, {1}!\nDu kannst ein Attribut deiner Wahl um <color=SOTS_COLOR_GOLD>2 verbessern</color>.]]></Text></GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>IMPROVE_ATTRIBUTE</LocID>                                            <Text>Wähle ein Attribut, das du VERBESSERN möchtest.</Text></GameDBLocalizedString>
