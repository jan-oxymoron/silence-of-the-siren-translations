            <!--BATTLE ARENA-->
            <GameDBLocalizedString><LocID>MAPOBJ_BATTLE_ARENA_NEW_DESCRIPTION</LocID><Text><![CDATA[Der Arenameister bietet dir eine Wette an: Tritt gegen ein Duplikat des stärksten feindlichen Kommandanten auf der Karte an. Wähle deinen Einsatz. Gewinnst du, wird dein Einsatz verdoppelt; verlierst du, erhält ihn der gegnerische Spieler. Deine Armee erleidet in beiden Fällen keine Verluste.]]></Text></GameDBLocalizedString>
            <GameDBLocalizedString><LocID>DIALOG_OBJECT_BATTLE_ARENA_NEW_TEXT</LocID><Text><![CDATA[Eine Gladiatorenarena, in der Champions <color=SOTS_COLOR_GOLD>Aura-Münzen</color> einsetzen und den mächtigsten Kommandanten eines Rivalen zum Duell fordern können.]]></Text></GameDBLocalizedString>
            <GameDBLocalizedString><LocID>DIALOG_OBJECT_BATTLE_ARENA_NEW_FIGHT</LocID><Text>Kämpfe!</Text></GameDBLocalizedString>
            <GameDBLocalizedString><LocID>MAPOBJ_BATTLE_ARENA_WON</LocID><Text>Du hast die Wette gewonnen!</Text></GameDBLocalizedString>
            <GameDBLocalizedString><LocID>MAPOBJ_BATTLE_ARENA_LOST</LocID><Text><![CDATA[Du hast die Wette und damit {1} <sprite name="TMPro_sprites_aura_coin"> verloren.]]></Text></GameDBLocalizedString>
            <GameDBLocalizedString><LocID>MAPOBJ_BATTLE_ARENA_CHALLENGED</LocID><Text>Du wurdest in der Kampfarena herausgefordert. Verteidige dich!</Text></GameDBLocalizedString>
            <GameDBLocalizedString><LocID>MAPOBJ_BATTLE_ARENA_DEFEND</LocID><Text>Verteidige!</Text></GameDBLocalizedString>
            <GameDBLocalizedString><LocID>MAPOBJ_BATTLE_ARENA_DEFENDED</LocID><Text>Du hast deinen Champion erfolgreich in der Kampfarena verteidigt und den Wetteinsatz des Herausforderers erhalten!</Text></GameDBLocalizedString>
