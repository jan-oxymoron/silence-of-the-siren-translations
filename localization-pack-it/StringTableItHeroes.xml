            <!--Exploration skills-->
            <GameDBLocalizedString>         <LocID>HERO_SKILL_EXPLORER</LocID>                              <Text>Giramondo</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>HERO_SKILL_EXPLORER_DESCRIPTION</LocID>                  <Text><![CDATA[Aggiunge in modo permanente <color=SOTS_COLOR_MOVEMENT>4 punti movimento</color> per ogni livello di competenza.]]></Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>SKILL_EFFECT_EXPLORER1</LocID>                           <Text><![CDATA[Aggiunge in modo permanente <color=SOTS_COLOR_MOVEMENT>8 punti movimento</color>.\nIncontrare un comandante amico ripristina <color=SOTS_COLOR_MOVEMENT>4 punti movimento</color> una volta per fase.]]></Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>SKILL_EFFECT_EXPLORER2</LocID>                           <Text><![CDATA[Aggiunge in modo permanente <color=SOTS_COLOR_MOVEMENT>12 punti movimento</color>.\nIncontrare un comandante amico ripristina <color=SOTS_COLOR_MOVEMENT>6 punti movimento</color> una volta per fase.]]></Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>SKILL_EFFECT_EXPLORER3</LocID>                           <Text><![CDATA[Aggiunge in modo permanente <color=SOTS_COLOR_MOVEMENT>16 punti movimento</color>.\nIncontrare un comandante amico ripristina <color=SOTS_COLOR_MOVEMENT>8 punti movimento</color> una volta per fase.]]></Text>  </GameDBLocalizedString>

            <GameDBLocalizedString>         <LocID>HERO_SKILL_ENGINEER</LocID>                              <Text>Ingegnere</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>HERO_SKILL_ENGINEER_DESCRIPTION</LocID>                  <Text><![CDATA[Aggiunge una ricarica giornaliera di <color=SOTS_COLOR_ENERGY>5 punti energia</color> per ogni livello di competenza e potenzia altri aspetti dell'utilizzo energetico.]]></Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>SKILL_EFFECT_ENGINEER1</LocID>                           <Text><![CDATA[Ricarica <color=SOTS_COLOR_ENERGY>5 punti energia</color> giornaliero.\nL'equipaggiamento consuma il <color=SOTS_COLOR_ENERGY>10%</color> in meno di <color=SOTS_COLOR_ENERGY>energia</color>.]]></Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>SKILL_EFFECT_ENGINEER2</LocID>                           <Text><![CDATA[Ricarica <color=SOTS_COLOR_ENERGY>10 punti energia</color> giornaliero.\nI manufatti consumo <color=SOTS_COLOR_ENERGY>10%</color> in meno di <color=SOTS_COLOR_ENERGY>energy</color>.]]></Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>SKILL_EFFECT_ENGINEER3</LocID>                           <Text><![CDATA[Ricarica <color=SOTS_COLOR_ENERGY>15 punti energia</color> giornaliero.\nAggiunge <color=SOTS_COLOR_ENERGY>30 punti energia</color> massimi al comandante di <color=SOTS_COLOR_ENERGY>energy</color>.]]></Text>  </GameDBLocalizedString>

            <GameDBLocalizedString>         <LocID>HERO_SKILL_NEGOTIATOR</LocID>                            <Text>Negoziatore</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>HERO_SKILL_NEGOTIATOR_DESCRIPTION</LocID>                <Text>Alcune unità di ogni gruppo dell'esercito neutrale si uniranno al tuo comandante prima della battaglia. (A seconda del livello di competenza e della disposizione dell'esercito.)</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>SKILL_EFFECT_NEGOTIATOR1</LocID>                         <Text>Il 10%, o almeno 1 unità, di ogni gruppo di unità verrà aggiunto.\n(All'80% del loro prezzo originale.)</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>SKILL_EFFECT_NEGOTIATOR2</LocID>                         <Text>Il 20%, o almeno 1 unità, di ogni gruppo di unità verrà aggiunto.\n(All'60% del loro prezzo originale.)</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>SKILL_EFFECT_NEGOTIATOR3</LocID>                         <Text><![CDATA[Il 30%, o almeno 1 unità, di ogni gruppo di unità verrà aggiunto.\nElimina la penalità al <color=SOTS_COLOR_GOLD>morale</color> per le unità non appartenenti a una fazione presenti nell'esercito.]]></Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>SKILL_EFFECT_NEGOTIATOR3_TOOLTIP</LocID>                 <Text>(Negoziatore di livello 3 annulla le penalità per le unità non appartenenti alla fazione presenti nell'esercito)</Text>  </GameDBLocalizedString>

            <GameDBLocalizedString>         <LocID>HERO_SKILL_BUILDER</LocID>                               <Text>Costruttore</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>HERO_SKILL_BUILDER_DESCRIPTION</LocID>                   <Text><![CDATA[Gli edifici sulla mappa del mondo vengono costruite nella loro <color=SOTS_COLOR_GOLD>versione potenziata</color>. Il livello 3 aggiunge <color=SOTS_COLOR_GOLD>Cyber-trappola</color> alle strutture disponibili.]]></Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>SKILL_EFFECT_CHEAPER_PRODUCTION_UPGRADES</LocID>         <Text><![CDATA[I miglioramenti produttivi degli edifici presenti sulla mappa costano il <color=SOTS_COLOR_GOLD>{1}%</color> in meno.]]></Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>SKILL_EFFECT_CHEAPER_GARRISON_UPGRADES</LocID>           <Text><![CDATA[I miglioramenti delle guarnigioni degli edifici sulla mappa del mondo sono <color=SOTS_COLOR_GOLD>gratuiti</color>!]]></Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>SKILL_EFFECT_BUILDER_DISCOUNT_PERCENT</LocID>            <Text><![CDATA[Le strutture edilizie sono scontate del <color=SOTS_COLOR_GOLD>{1}%</color>!]]> </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>SKILL_EFFECT_TRACKER_DISCOUNT_PERCENT</LocID>            <Text><![CDATA[La distruzione degli Xenoslime costa il <color=SOTS_COLOR_GOLD>{1}%</color> in meno!]]> </Text>  </GameDBLocalizedString>

            <GameDBLocalizedString>         <LocID>HERO_SKILL_SCOUT</LocID>                                 <Text>Scout</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>HERO_SKILL_SCOUT_DESCRIPTION</LocID>                     <Text><![CDATA[Aumenta il raggio di visibilità, fornisce maggiori informazioni sugli eserciti nemici e individua la posizione dei tesori nascosti. Il comandante non subisce gli effetti delle trappole e dei pericoli ambientali.]]></Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>SKILL_EFFECT_SCOUT1</LocID>                              <Text><![CDATA[<color=SOTS_COLOR_GOLD>+1 Raggio di visibilità</color>.\n<color=SOTS_COLOR_GOLD>Aggiunge l'icona (?)</color> per i tesori e le risorse fino 5 caselle di distanza nelle zone non scoperte.]]></Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>SKILL_EFFECT_SCOUT2</LocID>                              <Text><![CDATA[<color=SOTS_COLOR_GOLD>+2 Raggio di visibilità</color>.\n<color=SOTS_COLOR_GOLD>Aggiunge l'icona (?)</color> per le miniere e altre strutture conquistabili situate fino 5 caselle di distanza nelle zone non scoperte.]]></Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>SKILL_EFFECT_SCOUT3</LocID>                              <Text><![CDATA[<color=SOTS_COLOR_GOLD>+3 Raggio di visibilità</color>.\n<color=SOTS_COLOR_GOLD>Aggiunge l'icona (?)</color> per equipaggiamento, manufatti, basi e strutture utili fino 5 caselle di distanza nelle zone non scoperte.]]></Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>SKILL_EFFECT_SPY1</LocID>                                <Text><![CDATA[Mostra gli <color=SOTS_COLOR_GOLD>Attributi</color> del comandante nemico.]]></Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>SKILL_EFFECT_SPY2</LocID>                                <Text><![CDATA[Mostra gli <color=SOTS_COLOR_GOLD>Attributi e competenze</color> del comandante nemico.]]></Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>SKILL_EFFECT_SPY3</LocID>                                <Text><![CDATA[Mostra gli <color=SOTS_COLOR_GOLD>Attributi e competenze</color> del comandante nemico. Mostra anche l'<color=SOTS_COLOR_GOLD>esercito nemico</color>.]]></Text>  </GameDBLocalizedString>

            <GameDBLocalizedString>         <LocID>HERO_SKILL_COLLECTOR</LocID>                             <Text>Collezionista</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>HERO_SKILL_COLLECTOR_DESCRIPTION</LocID>                 <Text>Aggiunge uno scompartimento aggiuntivo per  o  per ogni livello di competenza. Consente di raccogliere oggetti dalle zone pericolose intorno agli eserciti neutrali senza innescare una battaglia. </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>SKILL_EFFECT_COLLECTOR1</LocID>                          <Text>+1 scompartimento equipaggiamento.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>SKILL_EFFECT_COLLECTOR2</LocID>                          <Text><![CDATA[+2 scompartimento equipaggiamento.\n+10% di probabilità di ottenere un ulteriore <color=SOTS_COLOR_FUSION_CORE>Nucleo di fusione</color> primitivo.]]></Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>SKILL_EFFECT_COLLECTOR3</LocID>                          <Text><![CDATA[+1 scompartimento manufatti.\nIl giocatore può vedere un’icona (?) per i <color=SOTS_COLOR_FUSION_CORE>nuclei di fusione</color> fino 5 caselle di distanza nelle zone non scoperte.]]></Text>  </GameDBLocalizedString>

            <GameDBLocalizedString>         <LocID>HERO_SKILL_TRACKER</LocID>                               <Text>Localizzatore</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>HERO_SKILL_TRACKER_DESCRIPTION</LocID>                   <Text><![CDATA[Riduce la penalità per gli spostamenti su terreni accidentati. Mostra le tracce dei nemici. Il comandante non viene preso di mira dalle torrette Primal e da altre difese.]]></Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>SKILL_EFFECT_TERRAIN_COST_REDUCED</LocID>                <Text><![CDATA[<color=SOTS_COLOR_GOLD>La penalità per i terreni accidentati</color> viene ridotta del {1}%.]]></Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>SKILL_EFFECT_SEE_ENEMY_PATHS_TILES</LocID>               <Text><![CDATA[È possibile vedere le tracce degli ultimi {1} passi dei <color=SOTS_COLOR_GOLD>comandanti nemici</color>.]]></Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>SKILL_EFFECT_EXTRA_MOVE_POINTS_FROM_CONSUMABLES</LocID>  <Text><![CDATA[I materiali di consumo ripristinano il {1}% in più di <color=SOTS_COLOR_MOVEMENT>movimento</color>.]]></Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>SKILL_EFFECT_SCOUTING_BONUS</LocID>                      <Text>Raggio di ricognizione +{1} caselle.</Text>  </GameDBLocalizedString>

            <GameDBLocalizedString>         <LocID>HERO_SKILL_EXPLORATION_ABILITIES</LocID>                 <Text>Giramondo</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>HERO_SKILL_EXPLORATION_ABILITIES_DESCRIPTION</LocID>     <Text><![CDATA[Imparando o aumentando di livello l'abilità Giramondo potrai acquisire una serie di <color=SOTS_COLOR_GOLD>Abilità di esplorazione</color>. Dopo aver acquisito questa competenza, recati in una base dotata di un'<color=SOTS_COLOR_GOLD>Accademia</color> per imparare altre abilità.]]></Text>  </GameDBLocalizedString>

