        <LocalizedStrings>
            <GameDBLocalizedString>         <LocID>HERO_SKILL_COMBAT_PSY_ABILITIES</LocID>                              <Text>Psionica</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>HERO_SKILL_COMBAT_PSY_ABILITIES_DESCRIPTION</LocID>                  <Text><![CDATA[Imparando e salendo di livello come Psionica potrai apprendere una selezione di <color=SOTS_COLOR_GOLD>Abilità di combattimento psioniche</color>. Dopo aver appreso questa competenza, recati in una base dotata di un’<color=SOTS_COLOR_GOLD>Accademia</color> per apprendere altre abilità.]]></Text>  </GameDBLocalizedString>
            
            <GameDBLocalizedString>         <LocID>ABILITY_HERO_COMBAT_COOLDOWN_RECOVERY</LocID>                        <Text>Riduzione del Tempo di Ricarica</Text></GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>ABILITY_HERO_COMBAT_COOLDOWN_RECOVERY_DESCRIPTION</LocID>            <Text>Ripristina la barra di ricarica dell'abilità speciale dell'unità in base alla Potenza dell'abilità del comandante (a partire da 1 turno fino al ripristino completo).</Text></GameDBLocalizedString>

            <GameDBLocalizedString>         <LocID>ABILITY_HERO_COMBAT_PSIONIC_BLAST</LocID>                            <Text>Esplosione Psionica</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>ABILITY_HERO_COMBAT_PSIONIC_BLAST_DESCRIPTION</LocID>                <Text>Colpisce i nemici in un'area con energia psionica.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>ABILITY_HERO_COMBAT_PSIONIC_BLAST_DESCRIPTION_LVL2</LocID>           <Text>Area più ampia, provoca Stordimento.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>ABILITY_HERO_COMBAT_PSIONIC_BLAST_DESCRIPTION_LVL3</LocID>           <Text>Area ancora più ampia, provoca Stordimento</Text>  </GameDBLocalizedString>
            
            <GameDBLocalizedString>         <LocID>ABILITY_HERO_CONFUSION</LocID>                                       <Text>Confusione</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>ABILITY_HERO_CONFUSION_DESCRIPTION</LocID>                           <Text>Le unità disorientate faticano a agire secondo gli ordini del loro comandante.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>ABILITY_HERO_CONFUSION_DESCRIPTION_LVL1</LocID>                      <Text>Riduce del 40% l'iniziativa e la velocità di movimento dello gruppo di unità nemiche.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>ABILITY_HERO_CONFUSION_DESCRIPTION_LVL2</LocID>                      <Text>Riduce del 40% l'iniziativa e la velocità di movimento dello gruppo di unità nemiche. Disattiva gli attacchi in mischia.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>ABILITY_HERO_CONFUSION_DESCRIPTION_LVL3</LocID>                      <Text>Riduce del 40% l'iniziativa e la velocità di movimento dello gruppo di unità nemiche. Disattiva gli attacchi in mischia. Disattiva gli attacchi a distanza.</Text>  </GameDBLocalizedString>
            
            <GameDBLocalizedString>         <LocID>STACK_STATUS_EFFECT_REDUCE_INITIATIVE_MOVEMENT</LocID>               <Text>Confuso e tremante</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>STACK_STATUS_EFFECT_REDUCE_INITIATIVE_MOVEMENT_DESCRIPTION</LocID>   <Text>Iniziativa e movimento ridotto del 40%.</Text>  </GameDBLocalizedString> <!-- TWEAKABLE_EFFECT_SLOW_INITIATIVE_REDUCTION_PERCENT and TWEAKABLE_EFFECT_SLOW_MOVEMENT_REDUCTION_PERCENT-->
            <GameDBLocalizedString>         <LocID>STACK_STATUS_EFFECT_BLOCK_MELEE</LocID>                              <Text>Blocca attacchi in mischia</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>STACK_STATUS_EFFECT_BLOCK_MELEE_DECRIPTION</LocID>                   <Text>Questa unità non può utilizzare il proprio attacco in mischia (ciò non influisce sui contrattacchi).</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>STACK_STATUS_EFFECT_BLOCK_RANGED</LocID>                             <Text>Blocca attacchi a distanza</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>STACK_STATUS_EFFECT_BLOCK_RANGED_DESCRIPTION</LocID>                 <Text>Se si tratta di un'unità a distanza, non può utilizzare il proprio attacco base a distanza.</Text>  </GameDBLocalizedString>
            
            <GameDBLocalizedString>         <LocID>ABILITY_HERO_COMBAT_FEINT</LocID>                                    <Text>Finta</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>ABILITY_HERO_COMBAT_FEINT_DESCRIPTION</LocID>                        <Text>In questo turno, sposta un'unità in cima alla lista delle unità.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>ABILITY_HERO_COMBAT_FEINT_DESCRIPTION_LVL3</LocID>                   <Text>Aumenta anche il movimento.</Text>  </GameDBLocalizedString>

            <GameDBLocalizedString>         <LocID>ABILITY_HERO_COMBAT_PSIONIC_CLEANSING</LocID>                        <Text>Purificazione Psionica</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>ABILITY_HERO_COMBAT_PSIONIC_CLEANSING_DESCRIPTION</LocID>            <Text>Rimuove gli effetti di stato negativi dalle unità alleate.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>ABILITY_HERO_COMBAT_PSIONIC_CLEANSING_LVL1</LocID>                   <Text>Colpisce una singola unità.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>ABILITY_HERO_COMBAT_PSIONIC_CLEANSING_LVL2</LocID>                   <Text>Colpisce più unità nel raggio d'azione, cura il bersaglio di 5%.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>ABILITY_HERO_COMBAT_PSIONIC_CLEANSING_LVL3</LocID>                   <Text>Colpisce più unità in un'area più ampia, cura il bersaglio di 10%.</Text>  </GameDBLocalizedString>

            <GameDBLocalizedString>         <LocID>ABILITY_HERO_COMBAT_POLTERGEIST</LocID>                              <Text>Controllo Arcano</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>ABILITY_HERO_COMBAT_POLTERGEIST_DESCRIPTION</LocID>                  <Text>Prendi il controllo dell'unità nemica.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>ABILITY_HERO_COMBAT_POLTERGEIST_LVL2</LocID>                         <Text>Controlla solo il movimento; l'unità potrà comunque attaccarti in seguito. Prende di mira solo le unità tecnologiche.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>ABILITY_HERO_COMBAT_POLTERGEIST_LVL3</LocID>                         <Text>Controlla sia il movimento che l'attacco. Colpisce qualsiasi unità.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>STACK_STATUS_EFFECT_POLTERGEIST_2</LocID>                            <Text>Sotto Controllo Arcano</Text></GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>STACK_STATUS_EFFECT_POLTERGEIST_2_DESCRIPTION</LocID>                <Text>Il movimento dell'unità è controllato dal nemico.</Text></GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>STACK_STATUS_EFFECT_POLTERGEIST_3</LocID>                            <Text>Sotto Controllo Arcano</Text></GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>STACK_STATUS_EFFECT_POLTERGEIST_3_DESCRIPTION</LocID>                <Text>L’unità è sotto il controllo del nemico.</Text></GameDBLocalizedString>

            <GameDBLocalizedString>         <LocID>ABILITY_HERO_COMBAT_PSYSERKER</LocID>                                <Text>Furioso</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>ABILITY_HERO_COMBAT_PSYSERKER_DESCRIPTION</LocID>                    <Text>L'unità bersaglio si trasforma in un berserker: attacca due volte, ma il comandante ne perde il controllo. La durata dell'effetto dipende dalla Potenza dell'Abilità del comandante.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>ABILITY_HERO_COMBAT_PSYSERKER_LVL1</LocID>                           <Text>Prende di mira una singola unità da mischia.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>ABILITY_HERO_COMBAT_PSYSERKER_LVL2</LocID>                           <Text>Colpisce più unità da mischia nel raggio d'azione.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>ABILITY_HERO_COMBAT_PSYSERKER_LVL3</LocID>                           <Text>Colpisce più unità in un raggio più ampio, comprese le unità con attacco a distanza.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>STACK_STATUS_EFFECT_PSYSERKER</LocID>                                <Text>Furia omicida</Text></GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>STACK_STATUS_EFFECT_PSYSERKER_DESCRIPTION</LocID>                    <Text>Attacca due volte. Il comandante non controlla l'unità.</Text></GameDBLocalizedString>

            <GameDBLocalizedString>         <LocID>ABILITY_HERO_COMBAT_PHASE_SHIFT</LocID>                              <Text>Sfasamento</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>ABILITY_HERO_COMBAT_PHASE_SHIFT_DESCRIPTION</LocID>                  <Text>Consente alle unità alleate di attraversare oggetti e altre unità. La durata dell'effetto dipende Potenza della abilità del comandante.</Text>  </GameDBLocalizedString>  
            <GameDBLocalizedString>         <LocID>ABILITY_HERO_COMBAT_PHASE_SHIFT_LVL2</LocID>                         <Text>L'unità può attraversare oggetti e altre unità.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>ABILITY_HERO_COMBAT_PHASE_SHIFT_LVL3</LocID>                         <Text>L'unità può attraversare oggetti e altre unità e non può essere preso di mira dai nemici.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>STACK_STATUS_EFFECT_PHASE_SHIFT_2</LocID>                            <Text>Sfasamento</Text></GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>STACK_STATUS_EFFECT_PHASE_SHIFT_2_DESCRIPTION</LocID>                <Text>L'unità può attraversare oggetti e altre unità.</Text></GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>STACK_STATUS_EFFECT_PHASE_SHIFT_3</LocID>                            <Text>Sfasamento avanzato</Text></GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>STACK_STATUS_EFFECT_PHASE_SHIFT_3_DESCRIPTION</LocID>                <Text>L'unità può attraversare oggetti e altre unità e non può essere preso di mira dai nemici.</Text></GameDBLocalizedString>

            <GameDBLocalizedString>         <LocID>ABILITY_HERO_COMBAT_MAXIMUM_EFFORT</LocID>                           <Text>Massimo Impegno</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>ABILITY_HERO_COMBAT_MAXIMUM_EFFORT_DESCRIPTION</LocID>               <Text>L'unità amica a distanza selezionata ottiene un attacco aggiuntivo. La durata dell'effetto dipende dalla Potenza delle abilità del comandante.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>ABILITY_HERO_COMBAT_MAXIMUM_EFFORT_LVL2</LocID>                      <Text>Attacco a distanza aggiuntivo.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>ABILITY_HERO_COMBAT_MAXIMUM_EFFORT_LVL3</LocID>                      <Text>Attacco a distanza aggiuntivo. Nessuna penalità di mira per la distanza.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>STACK_STATUS_EFFECT_EXTRA_SHOT</LocID>                               <Text>Colpo extra</Text></GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>STACK_STATUS_EFFECT_EXTRA_SHOT_DESCRIPTION</LocID>                   <Text>L'unità dispone di un attacco a distanza aggiuntivo.</Text></GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>STACK_STATUS_EFFECT_PRECISION_SHOT</LocID>                           <Text>Colpo preciso</Text></GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>STACK_STATUS_EFFECT_PRECISION_SHOT_DESCRIPTION</LocID>               <Text>Nessuna penalizzazione per la distanza.</Text></GameDBLocalizedString>
            
            <GameDBLocalizedString>         <LocID>ABILITY_HERO_COMBAT_PHASE_MIRROR</LocID>                             <Text>Specchio di Fase</Text></GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>ABILITY_HERO_COMBAT_PHASE_MIRROR_DESCRIPTION</LocID>                 <Text>L'unità amica selezionata diventa immune alle abilità del comandante nemico (ad eccezione di “dissolvi”).</Text></GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>STACK_STATUS_EFFECT_PHASE_MIRROR</LocID>                             <Text>Phase mirror</Text></GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>STACK_STATUS_EFFECT_PHASE_MIRROR_DESCRIPTION</LocID>                 <Text>Non può essere bersagliato dalle abilità del comandante nemico (ad eccezione di “dissolvi”).</Text></GameDBLocalizedString>

            <GameDBLocalizedString>         <LocID>ABILITY_HERO_COMBAT_MENTAL_BOND</LocID>                              <Text>Legame Mentale</Text></GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>ABILITY_HERO_COMBAT_MENTAL_BOND_DESCRIPTION</LocID>                  <Text>Collega tra loro le unità nemiche. Ogni volta che una di esse subisce danni, anche le altre ne subiscono. Ciascuna unità subisce il 50% del danno originale.</Text></GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>ABILITY_HERO_COMBAT_MENTAL_BOND_DESCRIPTION_LVL2</LocID>             <Text>Collega due unità.</Text></GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>ABILITY_HERO_COMBAT_MENTAL_BOND_DESCRIPTION_LVL3</LocID>             <Text>Collega tre unità.</Text></GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>STACK_STATUS_EFFECT_MENTAL_BOND</LocID>                              <Text>Legame mentale</Text></GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>STACK_STATUS_EFFECT_MENTAL_BOND_DESCRIPTION</LocID>                  <Text>Viene colpito ogni volta che un'altra unità collegata subisce danni.</Text></GameDBLocalizedString>

            <GameDBLocalizedString>         <LocID>ABILITY_HERO_COMBAT_MIND_PATCH</LocID>                               <Text>Modifica Mentale</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>ABILITY_HERO_COMBAT_MIND_PATCH_DESCRIPTION</LocID>                   <Text>L'unità da mischia bersagliata acquisisce un attacco psionico a distanza. La durata dell'effetto dipende dalla Potenza delle abilità del comandante.</Text>  </GameDBLocalizedString>            
            <GameDBLocalizedString>         <LocID>STACK_STATUS_EFFECT_MIND_PATCH</LocID>                               <Text>Mente modificata</Text></GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>STACK_STATUS_EFFECT_MIND_PATCH_DESCRIPTION</LocID>                   <Text>All'unità è stato concesso un attacco psionico a distanza.</Text></GameDBLocalizedString>

            <GameDBLocalizedString>         <LocID>ABILITY_HERO_COMBAT_MENTAL_RIOT</LocID>                               <Text>Rivolta Mentale</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>ABILITY_HERO_COMBAT_MENTAL_RIOT_DESCRIPTION</LocID>                   <Text>Conferisce un effetto di stato casuale a tutte le unità sul campo di battaglia. Le unità amiche ottengono effetti positivi, quelle nemiche effetti negativi.</Text>  </GameDBLocalizedString>            


        </LocalizedStrings>
    </GameDBStringTable>
</Database>
