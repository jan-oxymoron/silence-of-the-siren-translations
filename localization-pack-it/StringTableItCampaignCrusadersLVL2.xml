<?xml version="1.0" encoding="utf-8"?><Database>
    <GameDBStringTable ID="LOC_IT_CAMPAIGN_CRUSADERS_LVL2">

        <LanguageRef>LANG_IT</LanguageRef>

        <Contributors>
            <Name>Roberto Natta</Name>
        </Contributors>

        <LocalizedStrings>
            <!--OBJECTIVES MAIN QUESTS-->
            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_CRUSADERS_STARTIN_LVL2</LocID>                    <Text>Parla con Grande Zieregal</Text>  </GameDBLocalizedString>

            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_CRUSADERS_LVL2_BASE_GATE</LocID>                  <Text>Visita la base nelle vicinanze</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_CRUSADERS_LVL2_BASE_GATE_DONE</LocID>             <Text><![CDATA[<color=SOTS_COLOR_MOVEMENT>Visita la base nelle vicinanze - Fatto</color>]]></Text>  </GameDBLocalizedString>


            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_CRUSADERS_LVL2_GET_TO_FORTRESS</LocID>            <Text>Raggiungi la fortezza degli Zieregal</Text>  </GameDBLocalizedString>
           
            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_CRUSADERS_LVL2_DEFEAT_PIRATES</LocID>             <Text>Sconfiggi la Flotta Sovrana</Text>  </GameDBLocalizedString>
            
            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_CRUSADERS_LVL2_SAVE_TIN</LocID>                   <Text>Salva Tin in orbita</Text>  </GameDBLocalizedString>
            
            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_CRUSADERS_LVL2_RAM_GATE</LocID>                   <Text><![CDATA[Sfonda il portale <color=SOTS_COLOR_RED>con Princess</color> ]]></Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_CRUSADERS_LVL2_RAM_GATE_DONE</LocID>              <Text><![CDATA[<color=SOTS_COLOR_MOVEMENT>Sfonda il portale con Princess - Fatto</color>]]></Text>  </GameDBLocalizedString>


            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_CRUSADERS_LVL2_GET_TO_FORTRESS_TELEP</LocID>      <Text>Usa il teletrasporto nella fortezza di Zieregal</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_CRUSADERS_LVL2_GET_TO_FORTRESS_TELEP_DONE</LocID> <Text><![CDATA[<color=SOTS_COLOR_MOVEMENT>Usa il teletrasporto nella fortezza di Zieregal - Fatto</color>]]></Text>  </GameDBLocalizedString>

            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_CRUSADERS_LVL2_CAPTURE_BASES_01</LocID>           <Text>Conquista le basi nemiche 0/2</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_CRUSADERS_LVL2_CAPTURE_BASES_02</LocID>           <Text>Conquista le basi nemiche 1/2</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_CRUSADERS_LVL2_CAPTURE_BASES_DONE</LocID>         <Text><![CDATA[<color=SOTS_COLOR_MOVEMENT>Conquista le basi nemiche 2/2 iatto</color>]]></Text>  </GameDBLocalizedString>

            <GameDBLocalizedString>       <LocID>OBJECTIVE_CAMPAIGN_CRUSADERS_LVL2_DEFEAT_ZIEREGAL</LocID>            <Text>Sconfiggi Grande Zieregal</Text>  </GameDBLocalizedString>


            <!--DIALOGUES-->
            <!--Tin(Hierarch) and Arthur arrived near the area controlled by the Children of the Source order. -->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_START_NARRATOR_1</LocID>             <Text>Qualche giorno dopo, Tin e il messaggero dei Figli della Sorgente giungono nei pressi della fortezza del Grande Zieregal.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_START_GILEAS_1</LocID>               <Text>Mi dica, mio signore, perché abbiamo lasciato la sua nave alle nostre spalle?</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_START_GILEAS_2</LocID>               <Text>Scommetto che le tue gambe di carne sono stanche, ma Chiquita resta con Principess.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_START_GILEAS_3</LocID>               <Text>Devo confessare che invidio i tuoi piedi resistenti alle vesciche, ma il primo punto di ristoro è proprio dietro l’angolo.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_START_TIN_1</LocID>                  <Text>Questa strada non sembra sorvegliata... né percorsa.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_START_GILEAS_4</LocID>               <Text>È vero, signore, ma a poche miglia da qui c’è un ponte. Una volta attraversato, raggiungeremo il territorio controllato dai Figli.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_START_GILEAS_5</LocID>               <Text>Da lì, la fortezza di Grande Zieregal è a breve distanza.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_START_TIN_2</LocID>                  <Text>Fantastico, ho un sacco di domande da fargli.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_START_GILEAS_6</LocID>               <Text>Se cerchi informazioni sulla “Flotta Perduta”, preparati a rimanere deluso. Tutti sanno che quelle navi sono sparite da un pezzo.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_START_TIN_3</LocID>                  <Text>Ma dai?! Nei cervelli dei bambini cyborg sono stati inseriti dei sigilli della memoria! Nessuno ricorda davvero cosa sia successo!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_START_GILEAS_7</LocID>               <Text>Se le tue presunte guarnizioni sono state rimosse, perché non te lo ricordi?</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_START_TIN_4</LocID>                  <Text>Il giorno in cui abbiamo perso la flotta mi trovavo in superficie.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_START_GILEAS_8</LocID>               <Text>Che comodità.</Text>  </GameDBLocalizedString>

            <!--Tin and Arthur arrived in the empty base.   -->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_BASE_EMPTY_RH_1</LocID>              <Text>Non c’è nessuno qui?!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_BASE_EMPTY_GILEAS_1</LocID>          <Text>Strano, conosco bene questa zona. Dovrebbe esserci una guarnigione. C’è qualcosa che non quadra.</Text>  </GameDBLocalizedString>



            <!--Tin and Arthur spotted a mercenary. Mercenary will fall back to FOW once he broadcast the message to his boss.   -->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_MERCENARY_MERCENARY_1</LocID>        <Text>Capo, sono arrivati. Sta andando tutto secondo i piani. Una volta finito, manderò i miei ragazzi a riscuotere il pagamento. </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_MERCENARY_GILEAS_1</LocID>           <Text>Pirati! Usano la crittografia della Flotta Sovrana. Come mai riesci a decifrare il loro segnale?</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_MERCENARY_TIN_1</LocID>              <Text>Io e i Sovrani abbiamo un passato in comune... Hmm, mi chiedo davvero chi sia quel “capo”...</Text>  </GameDBLocalizedString>
            
            
            <!-- Tin and Arthur are approaching the mercenary base. The mercenary is escaping to the orbit via nearby orbital teleport   -->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_BRIDGE_TIN_1</LocID>                 <Text>Il ponte non è stato messo fuori uso; l'emettitore è stato distrutto! Questo richiede delle spiegazioni...</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_BRIDGE_GILEAS_1</LocID>              <Text>Contatterò immediatamente il Grande Zieregal.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_BRIDGE_TIN_2</LocID>                 <Text>Quello può aspettare! DOPO DI LUI!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_BRIDGE_GILEAS_2</LocID>              <Text>Non è una buona idea!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_BRIDGE_TIN_3</LocID>                 <Text>Perché? Ti tremano già le gambe? Annika non batterebbe ciglio.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_BRIDGE_GILEAS_3</LocID>              <Text>È solo che... è vietato entrare nell’orbita locale! Lì non è stabile!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_BRIDGE_TIN_4</LocID>                 <Text>Il mercenario non ci andrebbe se fosse così pericoloso... Immagino che ci sia solo un modo per scoprirlo.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_BRIDGE_TIN_5</LocID>                 <Text>Chi ti ha assunto, feccia?!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_BRIDGE_MERCENARY_1</LocID>           <Text>Oh, non è lontano, ma prima mi hanno pagato per fare un po’ di combattimenti!</Text>  </GameDBLocalizedString>

            <!-- Orbit, Mercenary was defeated, Tin (Hierarch is heading onwards to discover identity of merchs boss but is trapped by the will of the Ship wreck nearby -->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_MERCENARY_AF_MERCENARY_1</LocID>     <Text>Che gamba pelosa! Voi cyberbug siete proprio tosti!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_MERCENARY_AF_TIN_1</LocID>           <Text>Ora mi occuperò del tuo capo.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_MERCENARY_AF_SHIP_1</LocID>          <Text>ORA SEI MIO!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_MERCENARY_AF_TIN_2</LocID>           <Text>Cosa? Non riesco a muovermi! I manometri sono fuori scala! Che sta succedendo?</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_MERCENARY_AF_GILEAS_1</LocID>        <Text>Oh, eccoti qui... Che è successo?! Un guasto?</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_MERCENARY_AF_ZIEREGAL_1</LocID>      <Text>Arthur! Fermati subito, o finirai per essere schiacciato anche tu!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_MERCENARY_AF_ZIEREGAL_2</LocID>      <Text>Quella nave non è distrutta, Arthur. Ha intrappolato quell’eretico con i suoi poteri psichici.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_MERCENARY_AF_TIN_3</LocID>           <Text>Lasciami andare, nave! Sono uno dei Figli della Fonte!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_MERCENARY_AF_ZIEREGAL_3</LocID>      <Text>Non servirà a niente! L'impatto che le ha distrutto il corpo l'ha lasciata priva di sensi. Si chiama “Furia Cieca”, e penso che sia un nome piuttosto azzeccato!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_MERCENARY_AF_GILEAS_2</LocID>        <Text>Grande Zieregal, non capisco! Gli avevate promesso libero passaggio! Ho agito di conseguenza!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_MERCENARY_AF_ZIEREGAL_4</LocID>      <Text>Se avessi saputo del piano, ti avrebbe smascherato, Arthur! Da parte tua, sarai onorato come nessun altro essere umano prima d’ora.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_MERCENARY_AF_GILEAS_3</LocID>        <Text>... Io... vi sono grato, mio signore! Se non avete più bisogno di me, me ne andrò.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_MERCENARY_AF_TIN_4</LocID>           <Text>Perché?</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_MERCENARY_AF_ZIEREGAL_5</LocID>      <Text>Ottima domanda. È una questione complessa. Vorrei fartelo sapere! ... ma ti dirò solo questo! Presto, la tua Principess subirà lo stesso destino che hai subito tu.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_MERCENARY_AF_TIN_5</LocID>           <Text>È al sicuro, lontana da qui!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_MERCENARY_AF_ZIEREGAL_6</LocID>      <Text>Il buon Arthur la porterà qui.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_MERCENARY_AF_TIN_6</LocID>           <Text>Principess smaschererà le sue bugie!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_MERCENARY_AF_ZIEREGAL_7</LocID>      <Text>Hai appena visto quanto sia negato nell’arte dell'inganno. È nato nell’epoca sbagliata della storia dell’umanità. Il suo cuore da cavaliere gli imporrà di avvertire la tua Principess. Lei verrà in tuo aiuto e cadrà nella tua stessa trappola.</Text>  </GameDBLocalizedString>
            
            <!--Princess and Viktar start-->                                                                                       
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_PRINCESS_START_NARRATOR_1</LocID>    <Text>Poco dopo, la principessa e Viktar “atterrarono” con la loro nave nelle vicinanze.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_PRINCESS_START_VIKTAR_1</LocID>      <Text>Ottimo lavoro! Chiquita è bloccata nella palude e i motori sono pieni di fango. Se c’è un posto in cui il fango non dovrebbe stare, è proprio nei motori.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_PRINCESS_START_PRINCESS_1</LocID>    <Text>Dillo e basta, dai!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_PRINCESS_START_VIKTAR_2</LocID>      <Text>È inutile darsi la colpa a vicenda. Sappiamo tutti che è colpa della Principess!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_PRINCESS_START_PRINCESS_2</LocID>    <Text>OH... CHE GRANDE... PROBLEMA! Possiamo lasciare qui alcuni membri dell’equipaggio. Loro prepareranno Chiquita mentre noi cerchiamo Arthur, l’umano che ci ha inviato il messaggio.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_PRINCESS_START_VIKTAR_3</LocID>      <Text>E c’è dell’altro! La Principess sta cadendo a capofitto in un’altra trappola! E, come se non bastasse, mi sta trascinando con sé! Arthur è un essere umano... </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_PRINCESS_START_PRINCESS_3</LocID>    <Text>Gergielarca, ANNIKA WAS ALSO HUMAN! ... END OF DISCUSSION, SERVANT!  Gergielarca, ANNIKA ERA ANCHE LEI UN ESSERE UMANO! ... FINE DELLA DISCUSSIONE, SERVO!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_PRINCESS_START_PRINCESS_4</LocID>    <Text>... Scusa, Viky! Cavolo, non sono affatto così! È come se fosse stata l'Omnimadre a parlare!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_PRINCESS_START_VIKTAR_4</LocID>      <Text>Forse dovresti diventare più simile a lei. Secondo le leggende, l’Omnimadre era in grado di far precipitare le navi dal cielo con una sola parola. Potresti ordinare a Chiquita di tirarsi fuori dal fango.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_PRINCESS_START_PRINCESS_5</LocID>    <Text>Non sai di cosa stai parlando. Andiamo, Arthur ci sta aspettando all’interno della base che abbiamo individuato prima di atterrare.</Text>  </GameDBLocalizedString>

            <!--Message that is tied to event that stops Princess or Viky if they venture in wrong direction --> 
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_FAR_ENOUGH_RH_1</LocID>              <Text>Finché la mia schiena non sarà coperta dalla base, sarebbe imprudente continuare.</Text>  </GameDBLocalizedString>

            <!--Princess meets Gileas near her starting point   -->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_FAR_MEETING_GILEAS_GILEAS_1</LocID>  <Text>Mi chiamo Arthur, sono... Ero il messaggero del Grande Zieregal. Ho accompagnato Lord Hierarch quando la nave lo ha imprigionato in orbita.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_FAR_MEETING_GILEAS_RH_1</LocID>      <Text>Un essere umano che è diventato un guerriero dei Figli, che cosa curiosa! Ma le mie domande dovranno aspettare. Come raggiungiamo l’orbita?</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_FAR_MEETING_GILEAS_GILEAS_2</LocID>       <Text>Il teletrasporto che abbiamo usato si trova dall’altra parte delle montagne. A proposito di orbita, dov’è la tua nave?</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_FAR_MEETING_GILEAS_VIKTAR_1</LocID>       <Text>Principess è “sbarcata” a...</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_FAR_MEETING_GILEAS_PRINCESS_1</LocID>       <Text>Non importa!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_FAR_MEETING_GILEAS_VIKTAR_2</LocID>       <Text>Non è così?</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_FAR_MEETING_GILEAS_PRINCESS_2</LocID>       <Text>Sì, sta’ zitto!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_FAR_MEETING_GILEAS_PRINCESS_3</LocID>       <Text>Chiquita... al momento non è disponibile.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_FAR_MEETING_GILEAS_GILEAS_3</LocID>       <Text>Capisco... C’è un altro teletrasporto, ma c’è un problema. Si trova all'interno della fortezza del Grande Zieregal.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_FAR_MEETING_GILEAS_PRINCESS_4</LocID>       <Text>Possiamo farci strada a forza di lotta!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_FAR_MEETING_GILEAS_GILEAS_4</LocID>       <Text>Forse, ma la fortezza non è protetta solo dalle spade. C'è un Portale Primordiale, e solo il Grande Zieregal...</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_FAR_MEETING_GILEAS_PRINCESS_5</LocID>       <Text>... ha una chiave. Sì, riesco a vedere il portale nella psicosfera. Sta attingendo energia da diverse fonti. La prima è fuori portata, nelle profondità della base di Grand Zieregal...</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_FAR_MEETING_GILEAS_PRINCESS_6</LocID>       <Text>... ma il secondo è fuori...</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_FAR_MEETING_GILEAS_PRINCESS_7</LocID>       <Text>... e anche il terzo.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_FAR_MEETING_GILEAS_VIKTAR_3</LocID>       <Text>Cosa intende dire la Principess? Tutti sanno che i campi di forza dei portali primordiali sono indistruttibili.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_FAR_MEETING_GILEAS_PRINCESS_8</LocID>       <Text>Tre fonti di energia per alimentare il portale sarebbero troppe. Ma se disattiviamo le due che si trovano all’esterno della fortezza, potrò “sfondare” il portale con un’esplosione psionica.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_FAR_MEETING_GILEAS_GILEAS_5</LocID>       <Text>Psicosfera, arieti psionici?</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_FAR_MEETING_GILEAS_VIKTAR_4</LocID>       <Text>La nostra Principess è piena di sorprese. Col tempo, ti ci abituerai.</Text>  </GameDBLocalizedString>
            
            
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_FAR_PLAN_GILEAS_1</LocID>            <Text>Scusa se te lo chiedo, ma hai un piano? Non avrei mai immaginato che avremmo dovuto affrontare una nave!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_FAR_PLAN_PRINCESS_1</LocID>          <Text>Cosa sai della Litania, Arthur?</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_FAR_PLAN_VIKTAR_1</LocID>            <Text>Principess sta per mettere alla prova quei versi su quel relitto, con il signore Hierarch al suo fianco?</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_FAR_PLAN_GILEAS_3</LocID>            <Text>Versetti? Non funzionerà; ha perso i sensi a causa dell’incidente.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_FAR_PLAN_PRINCESS_3</LocID>          <Text>Allora temo che dovrò darle una bella botta!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_FAR_PLAN_VIKTAR_2</LocID>            <Text>[SOSPIRO] Omnimadre, aiutaci!</Text>  </GameDBLocalizedString>
  
            <!-- Princess and Viktar advancing towards lands controlled by Grand Zieregal  -->                                         
           
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_MESSAGE_TO_ZIEREGAL_BALINOR_1</LocID>    <Text>Grande Zieregal, stanno avanzando lungo il versante occidentale della collina... guidati da Arthur!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_MESSAGE_TO_ZIEREGAL_ZIEREGAL_1</LocID>    <Text>Uccideteli tutti!</Text>  </GameDBLocalizedString>

            <!--Princess managed to conquere the enemy bases set on power source of the gate of the Grand Zieregal fortress and weakened the gates force field.  -->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_GATE_WEAKENED_PRINCESS_1</LocID>     <Text>Ancora uno e poi posso sfondare il portale.</Text>  </GameDBLocalizedString>

            
            <!--Princess managed to conquere the enemy bases set on power source of the gate of the Grand Zieregal fortress and weakened the gates force field.  -->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_GATE_WEAK_PRINCESS_1</LocID>         <Text>Il portale è indebolito. Posso sfondarlo.</Text>  </GameDBLocalizedString>
           
           
            <!--princess and Grand Zieregal meats near the gate. Princess will successfully open the gate by her psionic abilities  -->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_PRINCESS_AT_GATE_ZIEREGAL_1</LocID>  <Text>Abominevole impostore dell’Omnimadre! Dopo tutto questo correre, il portale è ancora chiuso! Non reggi il confronto con il tuo stesso ideale.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_PRINCESS_AT_GATE_PRINCESS_1</LocID>  <Text>Bla, bla! Scommetto che era una tipa tosta. Ma se prendessi esempio da lei, ve ne pentireste tutti. Per vostra fortuna, oggi non ce n’è bisogno.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_PRINCESS_AT_GATE_ZIEREGAL_2</LocID>  <Text>Per l’amore dell’Omnimadre!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_PRINCESS_AT_GATE_PRINCESS_2</LocID>  <Text>Ora, lascia andare Tin... \n... o ti schiaccerò come un verme!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_PRINCESS_AT_GATE_ZIEREGAL_3</LocID>  <Text>Questo non è il luogo che ho scelto per affrontare il mio destino!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_PRINCESS_AT_GATE_GILEAS_1</LocID>    <Text>L’hai lasciato andare per affrontarlo su un campo di battaglia, invece di schiacciarlo semplicemente con i tuoi poteri! Hai scelto la via dell’onore!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_PRINCESS_AT_GATE_PRINCESS_4</LocID>  <Text>[ANSIMANDO] Stai scherzando? Lo farei volentieri a pezzi, ma... mi tremano le gambe... per la stanchezza... di tutte quelle cariche.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_PRINCESS_AT_GATE_VIKTAR_3</LocID>    <Text>Ogni volta che Principess sta per conquistare un nuovo seguace, lei apre la bocca e la magia svanisce!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_PRINCESS_AT_GATE_PRINCESS_5</LocID>  <Text>[ALZA LE SPALLE] Immagino di essere fatto così.</Text>  </GameDBLocalizedString>


            <!--One of the commanders managed to get to orbit - Arthur points the way   -->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_SENSE_TIN_RH_1</LocID>               <Text>Ormai non manca molto.</Text>  </GameDBLocalizedString>
           
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_SENSE_TIN_PRINCESS_1</LocID>         <Text>Faremmo meglio a mantenere un po' di distanza. Non so fino a dove possa “arrivare” la nave.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_SENSE_TIN_GILEAS_1</LocID>           <Text>Quel posto dovrebbe essere abbastanza sicuro. Il Grande Zieregal se ne stava lì, illeso.</Text>  </GameDBLocalizedString>


            <!--End - Princess and her Friends arrives to Ancient shipwreck that is holding and slowly crushing Tin (Hierarch) by the power of her will   -->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_SHIP_TWO_PRINCESS_1</LocID>          <Text>Assaggialo!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_SHIP_TWO_SHIP_1</LocID>              <Text>CHE IMITAZIONE MISERA DEI MIEI POTERI. AVVICINATI, COSÌ POSSO PRENDERE ANCHE TE.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_SHIP_TWO_VIKTAR_1</LocID>            <Text>E così se ne va il piano “da mano pesante” ...</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_SHIP_TWO_PRINCESS_2</LocID>          <Text>Se hai un’idea migliore, saputello, sono tutto orecchi!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_SHIP_TWO_VIKTAR_2</LocID>            <Text>No, ma se non facciamo nulla, Lord Hierarch verrà schiacciato!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_SHIP_TWO_PRINCESS_3</LocID>          <Text>Lascialo andare, stupido relitto!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_SHIP_TWO_VIKTAR_3</LocID>            <Text>Non funziona! Non posso stare a guardare! Mio signore, vi aiuterò o morirò nel tentativo!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_SHIP_TWO_PRINCESS_4</LocID>          <Text>Fermati, Viktar, non sei stato creato per essere un guerriero! Il tuo corpo non regge la pressione!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_SHIP_TWO_SHIP_2</LocID>              <Text>IL PRIMO È RESISTENTE, MA QUESTO LO ROMPERÒ COME UNA SOTTILE LASTRA DI VETRO!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_SHIP_TWO_PRINCESS_5</LocID>          <Text>Non c’è altra via! Devo lasciare che l’Omnimadre che è in me prenda il comando!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_SHIP_TWO_PRINCESS_6</LocID>          <Text>LASCIALI ANDARE, STRONZA!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_SHIP_TWO_TIN_1</LocID>               <Text>Che cosa è successo? Non sento più la presenza della nave!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_SHIP_TWO_PRINCESS_7</LocID>          <Text>Credo di aver usato troppa potenza... Mi sono spaventato...</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_SHIP_TWO_SHIP_3</LocID>              <Text>HO PROVATO QUEL TIPO DI POTERE SOLO UNA VOLTA IN PASSATO... OMNIMADRE... SEI TORNATA... PER LIBERARMI... DAL MIO CORPO DISTRUTTO.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_SHIP_TWO_PRINCESS_8</LocID>          <Text>Mi dispiace! Sono...</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_SHIP_TWO_SHIP_4</LocID>              <Text>SONO FELICE... PER QUELL’ULTIMO SGUARDO A TE... OMNIMADRE... ORA POSSO ANDARE... LE MIE SORELLE CADUTE MI ASPETTANO. </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_SHIP_TWO_PRINCESS_9</LocID>          <Text>No, no, no... Io... credo... di averla uccisa!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_SHIP_TWO_ZIEREGAL_1</LocID>          <Text>La nave è fuori uso. Ma finché impugno la mia spada, non sono ancora sconfitto. Vedo bene quanto l’ultimo colpo ti abbia prosciugato le forze, quindi, per una volta, sarà una lotta alla pari.</Text>  </GameDBLocalizedString>


              <!--The Grand Zieregal enters a scene, attacks and is defeated-->   
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_ZIEREGAL_AF_ZIEREGAL_1</LocID>       <Text>Basta! Affronterò le conseguenze della mia sconfitta a testa alta.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_ZIEREGAL_AF_TIN_1</LocID>            <Text>Ancora una volta, Grande Zieregal. Perché?</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_ZIEREGAL_AF_ZIEREGAL_3</LocID>       <Text>Perché la tua Principesa conosce la litania!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_ZIEREGAL_AF_TIN_3</LocID>            <Text>Cosa intendi dire, Grande Zieregal? Parla!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_ZIEREGAL_AF_ZIEREGAL_5</LocID>       <Text>Il giorno in cui abbiamo conquistato questo sistema, quasi l’intera flotta è stata distrutta dalla trasmissione della Litania! Ecco perché i Figli hanno trascorso secoli a cercare e uccidere gli impostori dell’Omnimadre!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_ZIEREGAL_AF_TIN_4</LocID>            <Text>Vuole metterti contro di me, non lo capisci?!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_ZIEREGAL_AF_ZIEREGAL_6</LocID>       <Text>Solo i cloni dell’Omnimadre conoscevano i versi in grado di costringere le navi a fare qualsiasi cosa. Persino a distruggersi!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_ZIEREGAL_AF_PRINCESS_2</LocID>       <Text>ERO IN IBERNAZIONE!!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_ZIEREGAL_AF_ZIEREGAL_7</LocID>       <Text>È lei la sirena che ha attirato la nostra flotta verso la rovina!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_ZIEREGAL_AF_PRINCESS_3</LocID>       <Text>È UNA BUGIA!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_ZIEREGAL_AF_ZIEREGAL_8</LocID>       <Text>L'Omnimadre ha ridotto in schiavitù interi sistemi stellari! Tu desideri fare lo stesso!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_ZIEREGAL_AF_PRINCESS_4</LocID>       <Text>STAI ZITTO!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_ZIEREGAL_AF_ZIEREGAL_9</LocID>       <Text>Intere specie, costrette a unirsi al suo esercito di cyborg! Pianeti bruciati in nome dell’Omnimadre! IL TUO NOME!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_ZIEREGAL_AF_PRINCESS_5</LocID>       <Text>STAI ZITTO!</Text>  </GameDBLocalizedString>
                    <!--An this moment Princes strikes the Grand Zieregal so hard he dies.  -->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_ZIEREGAL_AF_TIN_5</LocID>            <Text>È morto.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_ZIEREGAL_AF_PRINCESS_6</LocID>       <Text>... Io... non volevo ucciderlo!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_ZIEREGAL_AF_GILEAS_1</LocID>         <Text>Il mio onore mi impone di raccontare ai Figli ciò di cui sono stato testimone... Vuoi zittire anche me?</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_ZIEREGAL_AF_PRINCESS_7</LocID>       <Text>Ma certo che no, non ti farò del male, Arthur!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_ZIEREGAL_AF_GILEAS_2</LocID>         <Text>Arrivederci... per ora.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_ZIEREGAL_AF_PRINCESS_8</LocID>       <Text>Ma voi due mi credete, vero? Forse l’Omnimadre era un mostro, ma io non sono lei!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_ZIEREGAL_AF_VIKTAR_1</LocID>         <Text>Ti ho sempre creduto, sempre.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_ZIEREGAL_AF_TIN_6</LocID>            <Text>Anch’io, ma alcune delle parole degli Zieregal contenevano un briciolo di verità...</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_ZIEREGAL_AF_PRINCESS_9</LocID>       <Text>Quindi pensi che io sia responsabile di...</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_ZIEREGAL_AF_TIN_7</LocID>            <Text>No! Non ha negato l’esistenza della Flotta Perduta! È una cosa che i Figli hanno sempre fatto...</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_ZIEREGAL_AF_TIN_8</LocID>            <Text>C’è un posto che ho sempre considerato troppo rischioso da perlustrare. Ma ora abbiamo le prove.</Text>  </GameDBLocalizedString>
            
            <!--      BEFORE/AFTER FIGHT QOUTES-->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_CRUSADER_AF_RH_1</LocID>             <Text>Unisciti a noi! Non siamo nemici dei Figli, ma solo del Grande Zieregal!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_CRUSADER_AF_CRUSADER_1</LocID>       <Text>I miei voti al Grande Zieregal non possono essere revocati!</Text>  </GameDBLocalizedString>
                                                                           
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_CRUSADER_AF_RH_2</LocID>             <Text>Questo scontro è assurdo!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_CRUSADER_AF_CRUSADER_2</LocID>       <Text>Sono d’accordo. Ma combatterò a tutti i costi.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_CRUSADER_AF_RH_3</LocID>             <Text>Fammi indovinare, un giuramento?</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_CRUSADER_AF_CRUSADER_3</LocID>       <Text>Esatto.</Text>  </GameDBLocalizedString>
            
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_CRUSADER_AF_CRUSADER_4</LocID>       <Text>IO</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_CRUSADER_AF_RH_4</LocID>             <Text>Giuramento al Grande Zieregal, giusto?</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_CRUSADER_AF_CRUSADER_5</LocID>       <Text>[ALZA LE SPALLE] Non siamo forse i Figli della Sorgente?</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_CRUSADERS_LVL2_CRUSADER_AF_RH_5</LocID>             <Text>[SOSPIRA] Credo di aver trovato la risposta.</Text>  </GameDBLocalizedString>
            


        </LocalizedStrings>
    </GameDBStringTable>
