<?xml version="1.0" encoding="utf-8"?><Database>
    <GameDBStringTable ID="LOC_IT_CAMPAIGN_BEASTMASTERS_LVL1">

        <LanguageRef>LANG_IT</LanguageRef>

        <Contributors>
            <Name>Roberto Natta</Name>
        </Contributors>

        <LocalizedStrings>
            <!--OBJECTIVES MAIN QUESTS-->
            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_BEASTMASTERS_LVL1_START</LocID>                   <Text>Avvia l’offensiva</Text>  </GameDBLocalizedString>
          
            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_BEASTMASTERS_LVL1_SECOND_BASE_1</LocID>           <Text>Attacca le roccaforti dei Figli della Fonte 0/2</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_BEASTMASTERS_LVL1_SECOND_BASE_2</LocID>           <Text>Attacca le roccaforti dei Figli della Fonte 1/2</Text>  </GameDBLocalizedString>
            
            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_BEASTMASTERS_LVL1_GET_SETRI_TO_ELEVATOR</LocID>   <Text>Raggiungi il teletrasporto orbitale - turno/i rimanenti:</Text>  </GameDBLocalizedString>

            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_BEASTMASTERS_LVL1_RETAKE_X_BASE</LocID>           <Text>Conquista la base Xenauri</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_BEASTMASTERS_LVL1_RETAKE_X_BASE_DONE</LocID>      <Text><![CDATA[<color=SOTS_COLOR_MOVEMENT>Conquista la base Xenauri - Fatto</color>]]></Text>  </GameDBLocalizedString>

            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_BEASTMASTERS_LVL1_FIND_WAY_SURFACE</LocID>        <Text>Esci dal sottosuolo</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_BEASTMASTERS_LVL1_FIND_WAY_SURFACE_DONE</LocID>   <Text><![CDATA[<color=SOTS_COLOR_MOVEMENT>Esci dal sottosuolo - Fatto</color>]]></Text>  </GameDBLocalizedString>

            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_BEASTMASTERS_LVL1_INBARK_1</LocID>                <Text>Porta i tuoi comandanti a bordo 0/2</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_BEASTMASTERS_LVL1_INBARK_2</LocID>                <Text>Porta i tuoi comandanti a bordo 1/2</Text>  </GameDBLocalizedString>
          
            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_BEASTMASTERS_LVL1_FOS_BASE_1</LocID>                <Text>Conquista le basi dei Fossoriani 0/3</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_BEASTMASTERS_LVL1_FOS_BASE_2</LocID>                <Text>Conquista le basi dei Fossoriani 1/3</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_BEASTMASTERS_LVL1_FOS_BASE_3</LocID>                <Text>Conquista le basi dei Fossoriani 2/3</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_BEASTMASTERS_LVL1_FOS_BASE_4</LocID>                <Text><![CDATA[<color=SOTS_COLOR_MOVEMENT>Conquista le basi dei Fossoriani 3/3 - Fatto</color>]]> </Text>  </GameDBLocalizedString>
            
            <!--DIALOGUES-->
            <!--Se-Wari and Se-Tri are standing near their base.   -->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_START_NARRATOR_0</LocID>          <Text>Il DLC “Xenauri Riders” è ambientato dopo gli eventi di “Silence of the Siren”, la campagna del gioco originale.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_START_NARRATOR_1</LocID>          <Text>Il pianeta Scylla, nei pressi della base avanzata appena istituita dalla forza di sbarco degli Xenauri.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_START_T_1</LocID>                 <Text>Mettete giù gli attrezzi! Passiamo all’offensiva! La tempesta è iniziata!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_START_W_1</LocID>                 <Text>È pazzesco! Abbiamo appena iniziato a costruire l’accampamento! Non siamo pronti!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_START_T_2</LocID>                 <Text>Silenzio! State parlando con la Guardia di Altari del Pathfinder!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_START_W_2</LocID>                 <Text>Come potrei mai dimenticarlo, sorella?</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_START_T_3</LocID>                 <Text>Che cos’era quello?</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_START_W_3</LocID>                 <Text>Niente, Eccellenza.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_START_T_4</LocID>                 <Text>Ci è stato affidato il compito di conquistare le roccaforti degli Insetti di Ferro in questa zona...</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_START_T_5</LocID>                 <Text>... e qui. Sarò io a guidare l’attacco. Fallire significa tradire il Pathfinder!</Text>  </GameDBLocalizedString>
<!--
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_START_T_5</LocID>                 <Text>... and here. I’ll lead the attack. You handle logistics! To fail is to betray the Pathfinder! </Text>  </GameDBLocalizedString>
-->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_START_W_4</LocID>                 <Text>[SOTTOVOCE] Proprio come dei veri fanatici.</Text>  </GameDBLocalizedString>
            
            <!--First encounter with the Iron Insect warrior (Children of the Source) hero.-->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_CHILDREN_ENC_RH_1</LocID>         <Text>È un guerriero Insetto di Ferro!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_CHILDREN_ENC_KNIGHT_1</LocID>     <Text>[PARLA IN UNA LINGUA STRANA, LEGGERMENTE DISTORTA DA SUONI METALLICI]</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_CHILDREN_ENC_W_1</LocID>          <Text>Sta cercando di negoziare? Magari potremmo trovare un modo per comunicare!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_CHILDREN_ENC_T_2</LocID>          <Text>Sono solo robot senza cervello! Il Pathfinder ha ordinato il loro sterminio!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_CHILDREN_ENC_W_2</LocID>          <Text>E dal giorno in cui sei entrata a far parte della Guardia dei Pathfinder, la sua parola è stata legge. [SUSSURRANDO A SE STESSA] A prescindere dal buon senso.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_CHILDREN_ENC_KNIGHT_2</LocID>     <Text>[SUONI METALLICI TAGLIENTI]</Text>  </GameDBLocalizedString>
           
            <!--Iron Insect warrior is defeated.-->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_ARTAR_DEFEATED_W_1</LocID>        <Text>Riposa in pace, guerriero Insetto di Ferro. Spero che tu possa trovare la pace.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_ARTAR_DEFEATED_T_1</LocID>        <Text>Gli Insetti di Ferro non possono competere con la Guardia di Altari del Pathfinder!</Text>  </GameDBLocalizedString>

            <!--First base of the Children of the Source is conquered.  -->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_FIRST_FORTRESS_IS_CONQUERED_RH_1</LocID>   <Text>Il primo avamposto è nostro!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_FIRST_FORTRESS_IS_CONQUERED_T_2</LocID>    <Text>Il primo avamposto è stato conquistato in nome dei Pathfinder. Una volta conquistato il secondo, la riserva sarà nostra!</Text>  </GameDBLocalizedString>

            <!--At the start of the next game turn, Se-Wari notise a bright flash in the sky. -->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_EXPLOSION_FORESHADOWED_W_1</LocID>         <Text>Vedo dei lampi luminosi tra le nuvole sopra di noi! Ma non ho mai visto un temporale del genere!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_EXPLOSION_FORESHADOWED_T_1</LocID>         <Text>Quella non è una tempesta, idiota! È la nave madre! Sta bombardando il settore vicino!</Text>  </GameDBLocalizedString>

            <!--At the start of the next game turn, flashes intensifies. -->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SETRI_SUMMONED_W_</LocID>         <Text>I lampi si fecero più intensi!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SETRI_SUMMONED_T_1</LocID>        <Text>La nave madre è sotto attacco!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SETRI_SUMMONED_W_2</LocID>        <Text>Come fai a capirlo da qui?!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SETRI_SUMMONED_T_3</LocID>        <Text>Il collegamento... Devo tornare sulla nave... al santuario di cristallo!</Text>  </GameDBLocalizedString>
            
            <!--Se-Tri arrives to the teleport but befor she can enter and debris from the Mothership struck the place. She teleports Se-Wari out of harms way just in time.  -->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_TELEPORT_CRASH_RH_1</LocID>       <Text>Ci siamo quasi... COSA?! QUEL LAMPEGGIO ERA TROPPO INTENSO PER ESSERE QUELLO DI UN’ARMA!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_TELEPORT_CRASH_T_1</LocID>        <Text>La nave madre! Il mio legame con il santuario di cristallo! ... Non mi sento bene.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_TELEPORT_CRASH_W_1</LocID>        <Text>Se-Tri?... Stai bene?</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_TELEPORT_CRASH_T_3</LocID>        <Text>No... non... Dove mi trovo?! Non avvicinarti!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_TELEPORT_CRASH_W_3</LocID>        <Text>Se-Tri, Io... cos'è quel fruscio?!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_TELEPORT_CRASH_W_4</LocID>        <Text>C’è qualcosa che sta cadendo dritto verso di noi!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_TELEPORT_CRASH_T_4</LocID>        <Text>No!</Text>  </GameDBLocalizedString>

            <!--Se-Wari appears in the underground and is immediately surrounded by Fossorians.-->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEWARI_CAPTURED_W_1</LocID>           <Text>Mi ha forse appena teletrasportato fuori dalla zona di pericolo?</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEWARI_CAPTURED_FOSSORIAN_2</LocID>   <Text>[PARLA IN UNA LINGUA STRANA, CON UN LEGGERO ACCENTO DISTORTO A CAUSA DELLA FORMA NON UMANOIDE DELLA BOCCA]</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEWARI_CAPTURED_W_2</LocID>           <Text>O forse dritto verso un altro tipo di guai.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEWARI_CAPTURED_W_3</LocID>           <Text>Grossi guai!</Text>  </GameDBLocalizedString>
            
            <!--In a small cave Se-Wari chat with Captain Pick (the only Sovereign fleet hero of Fossorain descend). In the middle of the conversation the Fossorian hero Bokas arrives. -->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PICK_AND_SEWARI_NARRATOR_1</LocID>       <Text>Qualche giorno dopo. Nelle profondità del sottosuolo.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PICK_AND_SEWARI_P_1.5</LocID>            <Text>...impari in fretta, ragazza, ma...</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PICK_AND_SEWARI_BOKAS_1</LocID>          <Text>Non ti pago per chiacchierare, Pick! Dovresti interrogarla sui manufatti!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PICK_AND_SEWARI_W_2</LocID>              <Text>Manufatti?</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PICK_AND_SEWARI_P_3</LocID>              <Text>La tecnologia Xenauri rinvenuta tra i detriti della vostra nave madre...</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PICK_AND_SEWARI_W_5</LocID>              <Text>Rottami! La nave madre è stata distrutta?!...</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PICK_AND_SEWARI_BOKAS_2</LocID>          <Text>Zitti, voi due! A me interessano solo i manufatti! Nessuno sa come usarli!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PICK_AND_SEWARI_W_6</LocID>              <Text>Ma non posso aiutarti...</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PICK_AND_SEWARI_BOKAS_3</LocID>          <Text>Il dolore ti scioglierà la lingua!!!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PICK_AND_SEWARI_W_7</LocID>              <Text>BASTA! FA MALE!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PICK_AND_SEWARI_BOKAS_4</LocID>          <Text>Te la sei cercata!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PICK_AND_SEWARI_P_9</LocID>              <Text>Basta così, Bokas! Smettila!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PICK_AND_SEWARI_P_10</LocID>             <Text>Ho detto BASTA!</Text>  </GameDBLocalizedString>
            
            <!--Pick decide to help Se-Wari and they defeat Bokas.  -->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEWARI_LIBERATED_BOKAS_1</LocID>     <Text>[ALLA RADIO] Aiutatemi, amici miei! I prigionieri stanno scappando!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEWARI_LIBERATED_TOTT_1</LocID>      <Text>Chi stai chiamando “amico”, bastardo?!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEWARI_LIBERATED_MOLTAIR_1</LocID>   <Text>Sì, tu, mucchio puzzolente di sterco di verme!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEWARI_LIBERATED_BENI_1</LocID>      <Text>Vengo in tuo aiuto, Bokas, mio carissimo amico!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEWARI_LIBERATED_BOKAS_3</LocID>     <Text>Oh, col cavolo! Preferirei morire piuttosto che farmi salvare da un brutto mezzosangue!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEWARI_LIBERATED_P_1</LocID>         <Text>[CLIC DEL COMUNICATORE CHE SI SPEGNE] ...Così va meglio.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEWARI_LIBERATED_W_1</LocID>         <Text>Scegli, io...</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEWARI_LIBERATED_P_2</LocID>         <Text>Risparmiati i ringraziamenti, ragazza. Mi piaci, ma questo non significa che siamo amici... Anch’io sto cercando i manufatti di Xenauri. Io ti tiro fuori di lì e tu mi insegni come usarli. Affare fatto?</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEWARI_LIBERATED_W_2</LocID>         <Text>Ti dirò tutto quello che so... a una condizione: che tu mi aiuti a trovare mia sorella. È un’Altari, quindi starà bene... Ma devo esserne sicuro.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEWARI_LIBERATED_P_3</LocID>         <Text>Altari? </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEWARI_LIBERATED_W_3</LocID>         <Text>Significa più o meno “psionica”. E, dato che fa parte della Guardia Altari dei Pathfinder, è dotata di capacità eccezionali. </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEWARI_LIBERATED_P_4</LocID>         <Text>Psionica, dici... OK! Affare fatto... Ora, i miei simili pelosi hanno rimosso così tanti detriti dalla tua nave madre che possiamo iniziare a costruire una base quaggiù!</Text>  </GameDBLocalizedString>

            <!--At the start of the next game turn, Se-Wari asks Pick how he joined Fossorians. -->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PICK_REASONING_W_1</LocID>        <Text>Prima hai detto che sei stato assunto per insegnarmi?</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PICK_REASONING_P_1</LocID>        <Text>Mi hanno beccato mentre curiosavo tra le macerie. Così ho detto che volevo unirmi a loro e ho aspettato l’occasione giusta per svignarmela in silenzio.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PICK_REASONING_W_2</LocID>        <Text>Credo che la tranquillità sia ormai fuori discussione.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PICK_REASONING_P_2</LocID>        <Text>Sì, ma non preoccuparti. Il vecchio Pick sa bene da quale parte tenere il martello.</Text>  </GameDBLocalizedString>

            <!--First Fossorian hero defeated -->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_ELEVATOR_INFO_P_1</LocID>         <Text>Ora che abbiamo la base, abbiamo la possibilità di aprirci un varco fino all’ascensore che porta in superficie.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_ELEVATOR_INFO_W_1</LocID>         <Text>E una volta raggiunta la superficie?</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_ELEVATOR_INFO_P_2</LocID>         <Text>Non sarà certo più facile, ragazza mia, ma ho alcuni compagni di equipaggio e una nave veloce nascosta tra le rocce.</Text>  </GameDBLocalizedString>
            
            <!-- After they escape the underground, Se-Wari disscus with Pick their nex move.-->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SURFACE_RH_1</LocID>              <Text>Superficie! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SURFACE_W_1</LocID>               <Text>Cavolo, è piuttosto lontano dal posto in cui io e mia sorella ci siamo persi di vista.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SURFACE_P_1</LocID>               <Text>Non è poi così lontano, ma conosco la zona e la nave è l’unico modo per arrivarci.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SURFACE_P_2</LocID>               <Text>Allora, è ora di contattare la mia squadra. Spero che non se ne siano andati mentre ero bloccato laggiù.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SURFACE_P_3</LocID>               <Text>Freddie, Alfa, voi pigri e miserabili bastardi! Mi ricevete?</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SURFACE_FREDDIE_1</LocID>         <Text>Ti abbiamo sentito, capo! Non ce ne andremmo mai senza di te!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SURFACE_ALFA_1</LocID>            <Text>Allora, devo cancellare la registrazione di una settimana intera in cui ti lamenti di voler volare via, Freddie?</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SURFACE_FREDDIE_2</LocID>         <Text>Ehi, Alfa! Vaffanculo!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SURFACE_P_4</LocID>               <Text>Zitti, imbecilli! Stiamo arrivando da voi.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SURFACE_ALFA_2</LocID>            <Text>Noi?</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SURFACE_P_5</LocID>               <Text>Sì, ho compagnia. Un Xenauri.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SURFACE_FREDDIE_3</LocID>         <Text>Xenauri?   </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SURFACE_ALFA_3</LocID>            <Text>Gli alieni, Freddie! Da una settimana la Rete Sovrana non parla d’altro. Magari se non passassi tutto il giorno a giocare a Tetris...</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SURFACE_FREDDIE_4</LocID>         <Text>...devi proprio continuare a mettermi in imbarazzo, Alfa...</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SURFACE_P_6</LocID>               <Text>[CLIC DEL COMUNICATORE CHE SI SPEGNE]... Li ho presi in saldo... erano articoli danneggiati.</Text>  </GameDBLocalizedString>
            
            <!--Our heroes discover a second Xenauri base. -->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SURFACE_BASE_RH_1</LocID>         <Text>Un altro posto in cui i Fossoriani hanno ammucchiato i detriti. Un luogo ideale per costruire un’altra base.</Text>  </GameDBLocalizedString>

            <!--Suddenly, a radio transmission starts. The Pathfinder briefly appears on screen.-->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PATH_CALL_PATHFINDER_1</LocID>    <Text>[DISTORSIONI DEL SEGNALE]... La mia Guardia Altari... [DISTORSIONI DEL SEGNALE]... confusa... [DISTORSIONI DEL SEGNALE]... il settimo pianeta di questo sistema... [DISTORSIONI DEL SEGNALE]... coordinate 0-6-0-3...</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PATH_CALL_P_1</LocID>             <Text>Il settimo pianeta. Quindi si tratta di Chimera! Ma chi era quella?</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PATH_CALL_W_1</LocID>             <Text>Il Pathfinder. Custode del Santuario di Cristallo. Lui e la sua Guardia di Altari hanno unificato i clan del mio pianeta natale.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PATH_CALL_P_2</LocID>             <Text>Quindi è tipo “il più forte degli Altari”?</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PATH_CALL_W_3</LocID>             <Text>No, non lo è. Ma la sua Guardia di Altari gli è fanaticamente fedele.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PATH_CALL_P_3</LocID>             <Text>Interessante.</Text>  </GameDBLocalizedString>


            <!--Suddenly, a radio transmission starts. The Se-Tri briefly appears on screen.-->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SETRI_CALL_SETRI_1</LocID>        <Text>...[DISTORSIONI DEL SEGNALE]...</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SETRI_CALL_W_1</LocID>            <Text>Se-Tri?!... Accidenti! È tornata di nuovo silenziosa! Deve essere ancora bloccata da qualche parte sulla riva nord!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SETRI_CALL_P_1</LocID>            <Text>Sembri preoccupato. Non avevi detto che lei è un’Altari?</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SETRI_CALL_W_2</LocID>            <Text>Sì, ma qualcosa in lei è cambiato dopo che la nostra nave madre è stata distrutta.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SETRI_CALL_P_2</LocID>            <Text>Come se avesse perso i suoi poteri psionici?</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SETRI_CALL_W_3</LocID>            <Text>No, ma sembrava confusa, persino spaventata... Da quando è entrata nella Guardia, mi ero quasi dimenticato che potesse avere paura... È cambiata così tanto... Perché tutte queste domande su di lei?</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SETRI_CALL_P_4</LocID>            <Text>È solo per curiosità, tutto qui.</Text>  </GameDBLocalizedString>

            <!--Se-Wari approach a crystal biom part of the map.-->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_CRYSTALS_W_1</LocID>              <Text>Quei cristalli mi ricordano il mio pianeta. Montagne di cristallo, deserti di cristallo, grotte di cristallo... in pratica è tutto qui. Cristalli e lucertole Ssaari.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_CRYSTALS_P_2</LocID>              <Text>Il tuo mondo sembra un posto difficile in cui vivere.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_CRYSTALS_W_2</LocID>              <Text>Sì, in pratica è un posto deserto. Ma quei vecchi dipinti ricordano ciò che vedo qui. Alberi, erba, rocce, acqua... persino quegli strani monoliti che stiamo guardando adesso.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_CRYSTALS_P_3</LocID>              <Text>Rovine degli antichi Primordiali? Sul tuo pianeta?</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_CRYSTALS_W_3</LocID>              <Text>Ma solo in quei dipinti. Cristalli a perdita d’occhio… è l’unico mondo che conosco.</Text>  </GameDBLocalizedString>

            <!--Near the Pick's ship.-->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEW_CONFESSION_P_1</LocID>        <Text>La nave! Non è lontana!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEW_CONFESSION_W_1</LocID>        <Text>Pick, non sono stato del tutto sincero con te. I reperti provenienti dalla nave madre Xenauri...</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEW_CONFESSION_P_2</LocID>        <Text>Non funzioneranno...</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEW_CONFESSION_W_2</LocID>        <Text>Come fai a saperlo?</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEW_CONFESSION_P_3</LocID>        <Text>Se non riusciamo a vedere un’interfaccia, ciò non significa che non ci sia. E uno psionico... cioè, un Altari può vedere ciò che gli altri non riescono a vedere, giusto?</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEW_CONFESSION_W_3</LocID>        <Text>Sì... e allora perché mi stai aiutando?</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEW_CONFESSION_P_4</LocID>        <Text>Sei in gamba, ragazza. Mi piaci, ma questo non vuol dire che siamo amici... c’è anche un altro motivo. Te lo spiegherò una volta che saremo al sicuro sulla nave.</Text>  </GameDBLocalizedString>
            
            <!--At the surface, our heroes encounter Lunga Molly a Fossorian main commander of the area.  -->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SHIP_FOSS_BASES_MOLLY_1</LocID>   <Text>Voi due idioti avete rovinato tutto! La mia base sotterranea è in fiamme! I manufatti raccolti dai miei Fossoriani non valgono più nulla, e ora ci sono segnalazioni di navi dell’UNSS in orbita geostazionaria sopra di noi! Scommetterei il mio martello che anche questa è opera vostra!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SHIP_FOSS_BASES_P_1</LocID>       <Text>L’UNSS?! Non lavorerei mai per loro!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SHIP_FOSS_BASES_MOLLY_2</LocID>   <Text>Quella bugia è grande quanto il mio martello! Ma io non sono stupido! So che hai una nave nascosta da qualche parte qui vicino! Se decolli, i miei cannoni antiaerei ti abbatteranno!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SHIP_FOSS_BASES_P_2</LocID>       <Text>I cannoni antiaerei saranno un problema, e anche quelle navi dell’UNSS.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SHIP_FOSS_BASES_W_2</LocID>       <Text>UNSS? </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SHIP_FOSS_BASES_P_3</LocID>       <Text>Il gruppo più grande di idioti che si credono i padroni di tutto da queste parti. Ma Princess li tiene ben stretti. Almeno per ora.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SHIP_FOSS_BASES_W_3</LocID>       <Text>Chi è questa Princess?</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SHIP_FOSS_BASES_P_4</LocID>       <Text>Una potente psionica aliena... proprio come la tua Altari! Ma non preoccuparti, siamo pesci troppo piccoli per finire nella sua rete. Basta chiacchiere. Quei cannoni antiaerei non si disattiveranno da soli.</Text>  </GameDBLocalizedString>

            <!--Both Fossorian bases are conquered.  -->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SHIP_FLY_RH_1</LocID>             <Text>Le basi sono nostre! I cannoni antiaerei sono fuori uso! Ora possiamo decollare!</Text>  </GameDBLocalizedString>

            <!--Lunga Molly is defeated. -->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_MOLLY_AF_MOLLY_1</LocID>          <Text>Ogni volta che mi costruisco una posizione, spuntano fuori degli idioti che mandano tutto all’aria!</Text>  </GameDBLocalizedString>

            <!--The first Fossorian base is conquered. -->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_LAST_BASE_RH_1</LocID>            <Text>Rimane solo una base.</Text>  </GameDBLocalizedString>

            <!--Molly spawns before the remaining Fossorian base to face our heroes. -->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_MOLLY_SPAWN_RH_1</LocID>          <Text>L’ultima base! Una volta neutralizzate le difese antiaeree, potremo decollare!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_MOLLY_SPAWN_MOLLY_1</LocID>       <Text>Non finché il mio Martellatore avrà qualcosa da dire al riguardo!</Text>  </GameDBLocalizedString>
            
            <!--The Pick's ship was reached by one of the heroes before the both Fossorian bases were conquered.  -->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_CANNOT_BOARD_RH_1</LocID>         <Text>Non è ancora possibile salire a bordo. I cannoni antiaerei nelle basi fossoriane sono ancora operativi.</Text>  </GameDBLocalizedString>
            
            <!--The Pick's ship was reached by one of the heroes after the both Fossorian bases were conquered.  -->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_NEAR_SHIP_RH_1</LocID>            <Text>Sono riuscito ad arrivare alla nave.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_NEAR_SHIP_RH_2</LocID>            <Text>Va bene, sali a bordo e aspettami.</Text>  </GameDBLocalizedString>

            <!--End, our heroes speaks on board of the Pick's ship. Freddi and Alfa are also present on board. -->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_P_1</LocID>                   <Text>Ehi, ragazzi! Lo zio Pick è tornato... Togli quei piedi sporchi dal sistema di navigazione, Freddie!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_FREDDIE_1</LocID>             <Text>Sì, mio capitano, ammiraglio, capo onnipotente!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_ALFA_1</LocID>                <Text>Bene, siete arrivati anche voi due. Mentre vi aspettavamo, abbiamo raccolto un sacco di manufatti dai detriti della nave Xenauri. Ma...</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_FREDDIE_2</LocID>             <Text>...cazzo, non ci sono pulsanti con cui armeggiare, capo!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_ALFA_2</LocID>                <Text>Ma è proprio per questo che hai portato gli Xenauri, vero?</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_P_2</LocID>                   <Text>Lasciamo perdere per un po’ quella storia degli Xenauri! Prima di tutto, dobbiamo scoprire cosa è successo a sua sorella. Devo andare a nord...</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_FREDDIE_3</LocID>             <Text>Sì, beh... NO. Non se ne parla proprio, capo.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_P_3</LocID>                   <Text>Ma dai, Freddie, illuminami!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_ALFA_3</LocID>                <Text>Le forze dell’UNSS hanno preso il controllo dell’intera sponda settentrionale...</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_FREDDIE_4</LocID>             <Text>Chiquita! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_P_4</LocID>                   <Text>Chiquita cosa?! Che cazzo di banane?! Smettila di urlare parole a caso e di fingere di aver finito l’asilo!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_FREDDIE_5</LocID>             <Text>Chiquita è atterrata insieme a loro. E indovina chi era ai comandi di quella nave? Quella fottuta Princess! Alta tre metri, ricoperta di chitina, con poteri psionici! L’ho incontrata una volta e...</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_ALFA_4</LocID>                <Text>...i tuoi pantaloni non sono più stati gli stessi. Lo sappiamo tutti, Freddie. Ma Princess se n’è andata poco dopo!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_W_2</LocID>                   <Text>Princess deve aver percepito i poteri psionici di Se-Tri e l’ha catturata!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_P_5</LocID>                   <Text>Dobbiamo prima verificarlo. Ma temo che tu abbia proprio centrato il punto, ragazza mia. Dobbiamo scoprire dove l’ha portata Princess.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_FREDDIE_6</LocID>             <Text>Cosa?! Perché?!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_P_6</LocID>                   <Text>Sta’ zitto, Freddie... Sua sorella è un’Altari, il che significa che è una potente psionica! Finora Princess ha avuto il monopolio della “magia”! Questo deve cambiare!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_W_3</LocID>                   <Text>Ecco, quindi, il vero motivo! Ecco perché continuavi a farmi domande sugli Altari e su mia sorella!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_P_7</LocID>                   <Text>Grazie ai suoi poteri psionici, Princess ha il controllo assoluto sui viaggi spaziali a lunga distanza. Di conseguenza, detiene il potere su tutte le principali fazioni del sistema.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_ALFA_5</LocID>                <Text>Neanch’io la sopporto, ma da quando ha preso il potere le fazioni hanno smesso di combattere tra loro.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_P_8</LocID>                   <Text>Ma quanto durerà la pace dipende solo da lei! Immaginate se tutti potessero viaggiare dove vogliono! Lassù ci sono nuovi mondi che aspettano solo di essere scoperti! Sarebbe...</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_FREDDIE_7</LocID>            <Text>Il sogno più splendido di Sovrani diventa realtà!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_ALFA_6</LocID>                <Text>E gli psionici di Xenauri sono la chiave.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_W_4</LocID>                   <Text>Scegli, io...</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_P_9</LocID>                   <Text>Risparmiati i ringraziamenti, ragazza. Abbiamo appena deciso di sfidare l’essere più pericoloso del Sistema Siren. Potremmo benissimo pentircene prima che sia finita.</Text>  </GameDBLocalizedString>

            <!--Enemy FOSSORIAN COMMANDERS - QOUTES-->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_BENNI_BF_BENNI_1</LocID>          <Text>Ti ucciderò per il mio amico Bokas!</Text>  </GameDBLocalizedString>
            
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_MOLTAIR_BF_MOLTAIR_1</LocID>      <Text>Sono Moltair! Ex comandante della Divisione Liberator! Vincitore di innumerevoli battaglie...</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_MOLTAIR_BF_P_1</LocID>            <Text>... di cui nessuno ha mai sentito parlare.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_MOLTAIR_BF_X_1</LocID>            <Text>Sei davvero rumoroso per essere una creatura così piccola!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_MOLTAIR_BF_MOLTAIR_2</LocID>      <Text>Argh!!! Non vedrai mai più il sole!</Text>  </GameDBLocalizedString>

            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_TOTT_BF_QUETIN_1</LocID>          <Text>Ciao, sono Quetin di Moletargis!</Text>  </GameDBLocalizedString>
 
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_TOTT_BF_TOTT_1</LocID>            <Text>La tua piccola evasione finisce qui!</Text>  </GameDBLocalizedString>
            
        </LocalizedStrings>
    </GameDBStringTable>
</Database>
