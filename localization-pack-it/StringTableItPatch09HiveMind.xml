            <GameDBLocalizedString>         <LocID>ENCYCLOPEDIA</LocID>                                                  <Text>Enciclopedia</Text>  </GameDBLocalizedString>

            <GameDBLocalizedString>         <LocID>UNIT_MORALE_DESCRIPTION</LocID>                                      <Text><![CDATA[This unit's effect on the morale of the whole army.\nStronger units have bigger influence.\n<color=SOTS_COLOR_GOLD>Positive</color> if the unit belongs to the same faction as its commander, <color=SOTS_COLOR_RED>negative</color> otherwise.]]></Text></GameDBLocalizedString>
            
