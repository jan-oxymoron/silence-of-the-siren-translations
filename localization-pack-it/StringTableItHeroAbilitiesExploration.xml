            <GameDBLocalizedString>         <LocID>ABILITY_HERO_EXPLORATION_DEATH_MARK</LocID>                        <Text>Marchio della morte</Text></GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>ABILITY_HERO_EXPLORATION_DEATH_MARK_DESCRIPTION</LocID>            <Text><![CDATA[Rileva il comandante nemico nella nebbia di guerra. Il comandante preso di mira perde <color=SOTS_COLOR_MOVEMENT>punti movimento</color>.]]></Text></GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>ABILITY_HERO_EXPLORATION_DEATH_MARK_DESCRIPTION_LVL1</LocID>       <Text><![CDATA[ Gittata: 4 caselle, 2 turni.]]></Text></GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>ABILITY_HERO_EXPLORATION_DEATH_MARK_DESCRIPTION_LVL2</LocID>       <Text><![CDATA[ Gittata: 5 caselle, 3 turni.]]></Text></GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>ABILITY_HERO_EXPLORATION_DEATH_MARK_DESCRIPTION_LVL3</LocID>       <Text><![CDATA[ Gittata: 6 caselle, 4 turni.]]></Text></GameDBLocalizedString>

            <GameDBLocalizedString>         <LocID>STATUS_EFFECT_DEATH_MARK</LocID>                                   <Text><![CDATA[<color=SOTS_COLOR_RED>Marchio della morte attivo!</color>]]></Text>  </GameDBLocalizedString>

            
            <GameDBLocalizedString>         <LocID>ABILITY_HERO_EXPLORATION_BATTLE_CRY</LocID>                        <Text>Grido di battaglia</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>ABILITY_HERO_EXPLORATION_BATTLE_CRY_DESCRIPTION</LocID>            <Text>Incrementa il morale della tuo esercito!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>ABILITY_HERO_EXPLORATION_BATTLE_CRY_DESCRIPTION_LVL1</LocID>       <Text>+5 morale per 1 turno.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>ABILITY_HERO_EXPLORATION_BATTLE_CRY_DESCRIPTION_LVL2</LocID>       <Text>+10 morale e -5 morale ai tuoi nemici per 3 turni.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>ABILITY_HERO_EXPLORATION_BATTLE_CRY_DESCRIPTION_LVL3</LocID>       <Text>+15 morale e -10 morale ai tuoi nemici per 4 turni.</Text>  </GameDBLocalizedString>

            <GameDBLocalizedString>         <LocID>STATUS_EFFECT_BATTLE_CRY_1</LocID>                                 <Text><![CDATA[<color=SOTS_COLOR_LIGHT_GREEN>Grido di battaglia</color>]]></Text></GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>STATUS_EFFECT_BATTLE_CRY_2</LocID>                                 <Text><![CDATA[<color=SOTS_COLOR_LIGHT_GREEN>Grido di battaglia</color>]]></Text></GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>STATUS_EFFECT_BATTLE_CRY_3</LocID>                                 <Text><![CDATA[<color=SOTS_COLOR_LIGHT_GREEN>Grido di battaglia</color>]]></Text></GameDBLocalizedString>


            <GameDBLocalizedString>         <LocID>ABILITY_HERO_EXPLORATION_SHOW_RESOURCES</LocID>                    <Text>Mostra Risorse</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>ABILITY_HERO_EXPLORATION_SHOW_RESOURCES_DESCRIPTION</LocID>        <Text>Individua immediatamente le risorse presenti nell'area circostante il comandante.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>ABILITY_HERO_EXPLORATION_SHOW_RESOURCES_DESCRIPTION_LVL1</LocID>   <Text>Scopre le risorse di base.</Text></GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>ABILITY_HERO_EXPLORATION_SHOW_RESOURCES_DESCRIPTION_LVL2</LocID>   <Text>Individua tutte le risorse.</Text></GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>ABILITY_HERO_EXPLORATION_SHOW_RESOURCES_DESCRIPTION_LVL3</LocID>   <Text>Individua tutte le risorse e i nuclei di fusione.</Text></GameDBLocalizedString>


            <GameDBLocalizedString>         <LocID>ABILITY_HERO_EXPLORATION_SHOW_TREASURES</LocID>                    <Text>Mostra Tesori</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>ABILITY_HERO_EXPLORATION_SHOW_TREASURES_DESCRIPTION</LocID>        <Text>Individua immediatamente oggetti di valore nell'area circostante il comandante.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>ABILITY_HERO_EXPLORATION_SHOW_TREASURES_DESCRIPTION_LVL1</LocID>   <Text>Trova forzieri.</Text></GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>ABILITY_HERO_EXPLORATION_SHOW_TREASURES_DESCRIPTION_LVL2</LocID>   <Text>Trova forzieri ed equipaggiamento.</Text></GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>ABILITY_HERO_EXPLORATION_SHOW_TREASURES_DESCRIPTION_LVL3</LocID>   <Text>Scopre forzieri, equipaggiamento e artefatti.</Text></GameDBLocalizedString>

            
            <GameDBLocalizedString>         <LocID>ABILITY_HERO_EXPLORATION_BARBARIAN_HORDE</LocID>                   <Text>Orda dei barbari</Text></GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>ABILITY_HERO_EXPLORATION_BARBARIAN_HORDE_DESCRIPTION</LocID>       <Text>Mostrati come il tuo comandante più forte!</Text></GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>ABILITY_HERO_EXPLORATION_BARBARIAN_HORDE_DESCRIPTION_LVL2</LocID>  <Text>Induce i nemici a chiedersi se sia il caso di attaccare.</Text></GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>ABILITY_HERO_EXPLORATION_BARBARIAN_HORDE_DESCRIPTION_LVL3</LocID>  <Text>Inganna anche la competenza “Scout”.</Text></GameDBLocalizedString>


            <GameDBLocalizedString>         <LocID>ABILITY_HERO_EXPLORATION_EASY_PREY</LocID>                         <Text>Preda facile</Text></GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>ABILITY_HERO_EXPLORATION_EASY_PREY_DESCRIPTION</LocID>             <Text>Appari come il tuo comandante più debole!</Text></GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>ABILITY_HERO_EXPLORATION_EASY_PREY_DESCRIPTION_LVL2</LocID>        <Text>Fingi di essere debole per indurre gli altri ad attaccarti!</Text></GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>ABILITY_HERO_EXPLORATION_EASY_PREY_DESCRIPTION_LVL3</LocID>        <Text>Inganna anche la competenza “Scout”.</Text></GameDBLocalizedString>

            
            <GameDBLocalizedString>         <LocID>ABILITY_HERO_EXPLORATION_INVISIBILITY</LocID>                      <Text>Invisibilità</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>ABILITY_HERO_EXPLORATION_INVISIBILITY_DESCRIPTION</LocID>          <Text>Rende il comandante invisibile ai nemici finché qualcuno non si avvicina troppo.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>ABILITY_HERO_EXPLORATION_INVISIBILITY_DESCRIPTION_LVL2</LocID>     <Text>Invisibile fino a 4 caselle di distanza dai comandanti nemici.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>ABILITY_HERO_EXPLORATION_INVISIBILITY_DESCRIPTION_LVL3</LocID>     <Text>Invisibile fino a 2 caselle di distanza dai comandanti nemici.</Text>  </GameDBLocalizedString>

            <GameDBLocalizedString>         <LocID>STATUS_EFFECT_INVISIBILITY_2</LocID>                               <Text><![CDATA[<color=SOTS_COLOR_LIGHT_GREEN>Invisibile</color>]]></Text></GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>STATUS_EFFECT_INVISIBILITY_3</LocID>                               <Text><![CDATA[<color=SOTS_COLOR_LIGHT_GREEN>Invisibile</color>]]></Text></GameDBLocalizedString>

            
            <GameDBLocalizedString>         <LocID>ABILITY_HERO_EXPLORATION_PROTECTIVE_FIELD</LocID>                  <Text>Scudo Protettivo</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>ABILITY_HERO_EXPLORATION_PROTECTIVE_FIELD_DESCRIPTION</LocID>      <Text>Crea un campo protettivo che impedisce agli oggetti visitati e alle abilità di infliggere effetti negativi.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>ABILITY_HERO_EXPLORATION_PROTECTIVE_FIELD_DESCRIPTION_LVL2</LocID> <Text>Protegge il comandante.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>ABILITY_HERO_EXPLORATION_PROTECTIVE_FIELD_DESCRIPTION_LVL3</LocID> <Text>Protegge i comandanti che si trovano entro un raggio di 2 caselle dal lanciatore dell'incantesimo.</Text>  </GameDBLocalizedString>

            <GameDBLocalizedString>         <LocID>STATUS_EFFECT_PROTECTIVE_FIELD</LocID>                             <Text><![CDATA[<color=SOTS_COLOR_LIGHT_GREEN>Scudo Protettivo</color>]]></Text></GameDBLocalizedString>


            <GameDBLocalizedString>         <LocID>ABILITY_HERO_EXPLORATION_REINFORCEMENT</LocID>                     <Text>Rinforza!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>ABILITY_HERO_EXPLORATION_REINFORCEMENT_DESCRIPTION</LocID>         <Text>Evoca le unità di un tipo specifico disponibili nelle tue basi direttamente nell'esercito di questo comandante.</Text>  </GameDBLocalizedString>

            <GameDBLocalizedString>         <LocID>DIALOG_ABILITY_REINFORCEMENT</LocID>                               <Text>Chiama i rinforzi!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>DIALOG_ABILITY_REINFORCEMENT_TEXT</LocID>                          <Text><![CDATA[Scegli un tipo di unità disponibile! Le unità disponibili in tutte le tue basi e non assegnate a un eroe di guarnigione saranno chiamate all'azione!\nPuoi evocare solo unità con un livello pari o inferiore alla <color=SOTS_COLOR_GOLD>Potenza delle abilità</color> del tuo comandante.]]></Text>  </GameDBLocalizedString>

      
            <GameDBLocalizedString>         <LocID>ABILITY_HERO_EXPLORATION_EAGLE_EYE</LocID>                         <Text>Occhio d'Aquila</Text></GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>ABILITY_HERO_EXPLORATION_EAGLE_EYE_DESCRIPTION</LocID>             <Text>Raddoppia il raggio visivo del comandante per una fase.</Text></GameDBLocalizedString>


            <GameDBLocalizedString>         <LocID>ABILITY_HERO_EXPLORATION_TOXIC_CLOUD</LocID>                       <Text>Nuvola Sovraccarica</Text></GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>ABILITY_HERO_EXPLORATION_TOXIC_CLOUD_DESCRIPTION</LocID>           <Text>Posiziona una nuvola artificiale sulla mappa. Se un comandante vi entra, perderà la possibilità di muoversi e il suo esercito subirà danni nel combattimento successivo.</Text></GameDBLocalizedString>
            
            <GameDBLocalizedString>         <LocID>STATUS_EFFECT_SUPERCHARGED_CLOUD_DAMAGE</LocID>                    <Text><![CDATA[Hai attraversato una nuvola sovraccarica. Le tue unità sono <color=SOTS_COLOR_RED>sotto shock e avvelenate</color>.]]></Text></GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>STATUS_EFFECT_ELECTRONIC_EQUIPMENT_DISABLED</LocID>                <Text><![CDATA[<color=SOTS_COLOR_RED>Le apparecchiature elettroniche sono state disattivate.</color>]]></Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>ELECTRONIC_EQUIPMENT_DISABLED</LocID>                              <Text><![CDATA[<color=SOTS_COLOR_RED>Le apparecchiature elettroniche sono state disattivate a causa di un effetto di stato su questo comandante.</color>]]></Text>  </GameDBLocalizedString>
            
            <GameDBLocalizedString>         <LocID>ABILITY_HERO_EXPLORATION_EVACUATION</LocID>                        <Text>Evacuazione</Text></GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>ABILITY_HERO_EXPLORATION_EVACUATION_DESCRIPTION</LocID>            <Text>Teletrasporta il comandante e il suo esercito alla base più vicina.</Text></GameDBLocalizedString>

            
            <GameDBLocalizedString>         <LocID>ABILITY_HERO_EXPLORATION_MIMIC</LocID>                             <Text>Mimica</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>ABILITY_HERO_EXPLORATION_MIMIC_DESCRIPTION</LocID>                 <Text>Chiama un amico olografico autonomo, così potrai apparire in più posti contemporaneamente. Non lasciare che tocchi nulla!</Text>  </GameDBLocalizedString>

            <GameDBLocalizedString>         <LocID>HERO_MIMIC</LocID>                                                 <Text>Sono un mimo!</Text>  </GameDBLocalizedString>
            
            <GameDBLocalizedString>         <LocID>STATUS_EFFECT_ROOTS</LocID>                                        <Text><![CDATA[<color=SOTS_COLOR_RED>Morso. Movimento ridotto.</color>]]></Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>STATUS_EFFECT_MUSHROOM_SPORES</LocID>                              <Text><![CDATA[<color=SOTS_COLOR_LIGHT_GREEN>Spore inalate. Potenza di combattimento aumentata.</color>]]></Text>  </GameDBLocalizedString>

            <GameDBLocalizedString>         <LocID>STATUS_EFFECT_IN_TRAINING</LocID>                                  <Text><![CDATA[<color=SOTS_COLOR_LIGHT_GREEN>In addestramento. Guadagna XP ogni turno. Bonus difensivo, tattica.</color>]]></Text>  </GameDBLocalizedString>
            
