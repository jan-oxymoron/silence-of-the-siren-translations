            <GameDBLocalizedString>         <LocID>ABILITY_HERO_EXPLORATION_RUSH_DESCRIPTION</LocID>                  <Text><![CDATA[Ripristina i <color=SOTS_COLOR_MOVEMENT>Punti Movimento</color> del comandante. Potenza delle abilità ne potenzia l'effetto.]]></Text></GameDBLocalizedString>

            <GameDBLocalizedString>         <LocID>ABILITY_HERO_EXPLORATION_RUSH_DESCRIPTION_LVL1</LocID>             <Text><![CDATA[Ripristina (6 + Potenza delle abilità) <color=SOTS_COLOR_MOVEMENT>Punti Movimento</color>.]]></Text></GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>ABILITY_HERO_EXPLORATION_RUSH_DESCRIPTION_LVL2</LocID>             <Text><![CDATA[Ripristina (12 + Potenza delle abilità) <color=SOTS_COLOR_MOVEMENT>Punti Movimento</color>.]]></Text></GameDBLocalizedString>
