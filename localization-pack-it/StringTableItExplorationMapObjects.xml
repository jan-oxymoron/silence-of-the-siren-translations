            <GameDBLocalizedString>         <LocID>TOOLTIP_TRAIN_LOST</LocID>                                         <Text><![CDATA[Durante il processo di addestramento <color=SOTS_COLOR_RED>perderai {1} unità</color>.]]></Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>TOOLTIP_UNIT_NOT_ENOUGH_TO_TRAIN</LocID>                           <Text><![CDATA[Per addestrarli <color=SOTS_COLOR_GOLD>ti servono</color> almeno <color=SOTS_COLOR_GOLD>2 unità</color>.]]></Text>  </GameDBLocalizedString>

