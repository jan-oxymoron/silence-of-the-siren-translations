            <GameDBLocalizedString>         <LocID>MAPOBJ_FIBERALLOYMILL_LVL1_DESCRIPTION</LocID>                     <Text><![CDATA[Produce <color=SOTS_COLOR_ALLOYS>1</color> (<color=SOTS_COLOR_ALLOYS>2</color> una volta potenziato) <color=SOTS_COLOR_ALLOYS>Lega</color> per fase.]]></Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MAPOBJ_LIMERITMINE_LVL1</LocID>                                    <Text>Cava di Limerite</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MAPOBJ_LIMERITMINE_LVL1_DESCRIPTION</LocID>                        <Text><![CDATA[Produce <color=SOTS_COLOR_LIMERITE>1</color> (<color=SOTS_COLOR_LIMERITE>2</color> una volta potenziato) <color=SOTS_COLOR_LIMERITE>Limerite</color> per fase.]]></Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MAPOBJ_NANO_COMPOUND_MINE</LocID>                                  <Text>Collisore di Radiant</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MAPOBJ_NANO_COMPOUND_MINE_DESCRIPTION</LocID>                      <Text><![CDATA[Produce <color=SOTS_COLOR_RADIANT>1</color> (<color=SOTS_COLOR_RADIANT>2</color> una volta potenziato) <color=SOTS_COLOR_RADIANT>Radiant</color> per fase.]]></Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MAPOBJ_GOLD_MINE</LocID>                                           <Text>Operazione di fusione</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MAPOBJ_GOLD_MINE_DESCRIPTION</LocID>                               <Text><![CDATA[Produce <color=SOTS_COLOR_GOLD>500</color> (<color=SOTS_COLOR_GOLD>1000</color> una volta potenziato) <color=SOTS_COLOR_GOLD>Monete Aura</color> ogni turno.]]></Text>  </GameDBLocalizedString>
                                                                                                                      
            <GameDBLocalizedString>         <LocID>MAPOBJ_WATCHTOWER_01</LocID>                                       <Text>Torre di osservazione</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MAPOBJ_WATCHTOWER_01_DESCRIPTION</LocID>                           <Text>Rileva immediatamente l'area circostante e la tiene sotto sorveglianza.</Text>  </GameDBLocalizedString>
                                                                                                                      
            <GameDBLocalizedString>         <LocID>MAPOBJ_AURA_COIN_STORAGE</LocID>                                   <Text>Deposito di Monete Aura</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MAPOBJ_AURA_COIN_STORAGE_DESCRIPTION</LocID>                       <Text><![CDATA[Conferisce a un comandante che lo visita <color=SOTS_COLOR_GOLD>1000 Monete Aura</color> una volta per ciclo.]]></Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MAPOBJ_SMUGGLERS_DEN</LocID>                                       <Text>Covo dei contrabbandieri</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MAPOBJ_SMUGGLERS_DEN_DESCRIPTION</LocID>                           <Text><![CDATA[Un comandante in visita riceverà una <color=SOTS_COLOR_GOLD>ricompensa casuale</color>. Utilizzabile una volta per ciclo. <color=SOTS_COLOR_ATTACK>Attaccare</color> ti garantisce una <color=SOTS_COLOR_GOLD>ricompensa maggiore</color>, ma <color=SOTS_COLOR_GOLD>disattiverà</color> la tana per <color=SOTS_COLOR_GOLD>3 cicli</color>.]]></Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MAPOBJ_SLAVECAMP</LocID>                                           <Text>Campo di schiavi</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MAPOBJ_SLAVECAMP_DESCRIPTION</LocID>                               <Text><![CDATA[Il posto è sorvegliato da unità Mole per proteggere la merce. Chiunque <color=SOTS_COLOR_GOLD>può acquistare</color> ciò che vede. L’offerta cambia ad ogni fase, quindi non esitare se vedi qualcosa che ti piace. <color=SOTS_COLOR_ATTACK>Attaccare</color> garantisce ai comandanti <color=SOTS_COLOR_GOLD>più unità schiavizzate gratuite</color>, ma <color=SOTS_COLOR_GOLD>disattiverà</color> l’accampamento per <color=SOTS_COLOR_GOLD>3 cicli</color>.]]></Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MAPOBJ_DOJO</LocID>                                                <Text>Santuario dello Spadaccino</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MAPOBJ_DOJO_DESCRIPTION</LocID>                                    <Text><![CDATA[Un Dojo che ripristina il mojo, dove i comandanti guadagnano <color=SOTS_COLOR_XP>2000 Punti esperienza</color>. Ogni comandante può utilizzare questo edificio una sola volta.]]></Text>  </GameDBLocalizedString> <!--Mojo restoring Dojo, that leads to -->
            <GameDBLocalizedString>         <LocID>MAPOBJ_BROTHEL</LocID>                                             <Text>Annoiato? Ciao!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MAPOBJ_BROTHEL_DESCRIPTION</LocID>                                 <Text><![CDATA[Questo locale malfamato gode di grande rispetto tra le file e aumenta il <color=SOTS_COLOR_GOLD>Morale di 20</color> per un ciclo. Ogni comandante può utilizzare questo edificio una volta per ciclo.]]></Text>  </GameDBLocalizedString> <!--TODO put bac once brothel is fixed Each commander can use this building once per cycle.-->
            <GameDBLocalizedString>         <LocID>MAPOBJ_TOMB_OF_SWORDMASTER</LocID>                                 <Text>Tomba del Maestro d'Armi</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MAPOBJ_TOMB_OF_SWORDMASTER_DESCRIPTION</LocID>                     <Text><![CDATA[Imparando da un maestro esperto nell'uso del bastone, la <color=SOTS_COLOR_ATTACK>Potenza nel combattimento di un comandante aumenta in modo permanente di 2</color>. Ogni comandante può allenarsi qui solo una volta.]]></Text>  </GameDBLocalizedString>
                                                                                                                      
            <GameDBLocalizedString>         <LocID>MAPOBJ_ENERGYNODE_SMALL</LocID>                                    <Text>Nodo energetico</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MAPOBJ_ENERGYNODE_SMALL_DESCRIPTION</LocID>                        <Text><![CDATA[<color=SOTS_COLOR_GOLD>Ricarica</color> completamente la <color=SOTS_COLOR_ENERGY>riserva di punti energia</color> di un comandante una volta per ciclo. (In ordine di arrivo.)]]></Text>  </GameDBLocalizedString>
                                                                                                                      
            <GameDBLocalizedString>         <LocID>MAPOBJ_EXPLORATION_SKILL_ACADEMY</LocID>                           <Text>Accademia delle competenze</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MAPOBJ_EXPLORATION_SKILL_ACADEMY_DESCRIPTION</LocID>               <Text>I comandanti in visita possono apprendere qualsiasi competenza. Utilizzabile una volta per ogni comandante.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MAPOBJ_EXPLORATION_TECH_ABILITY_ACADEMY</LocID>                    <Text>Accademia tecnologica</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MAPOBJ_EXPLORATION_TECH_ABILITY_ACADEMY_DESCRIPTION</LocID>        <Text><![CDATA[I comandanti in visita possono apprendere <color=SOTS_COLOR_GOLD>qualsiasi abilità tecnologica</color>. Può essere utilizzata <color=SOTS_COLOR_GOLD>una volta per comandante</color>.]]></Text>  </GameDBLocalizedString>
           
