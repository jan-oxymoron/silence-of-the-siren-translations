            <GameDBLocalizedString>         <LocID>MAPOBJ_BIOFARM_01</LocID>                                          <Text>Fattoria biologica</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MAPOBJ_BIOFARM_01_DESCRIPTION</LocID>                              <Text><![CDATA[Produce <color=SOTS_COLOR_BIOMASS>1</color> (<color=SOTS_COLOR_BIOMASS>2</color> una volta potenziato) <color=SOTS_COLOR_BIOMASS>biomassa</color> per fase.]]></Text>  </GameDBLocalizedString>
