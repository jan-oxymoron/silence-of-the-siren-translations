            <GameDBLocalizedString>         <LocID>MAPOBJ_MYSTERIOUS_WANDERER</LocID>                          <Text>Viandante misterioso</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MAPOBJ_MYSTERIOUS_WANDERER_DESCRIPTION</LocID>              <Text><![CDATA[Vaga misteriosamente nei dintorni. Si dice che <color=SOTS_COLOR_XP>conceda esperienza</color> e <color=SOTS_COLOR_GOLD>migliori un attributo a tua scelta</color> alla <color=SOTS_COLOR_GOLD>prima persona</color> che incontra <color=SOTS_COLOR_GOLD>ad ogni ciclo</color>.]]></Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>DIALOG_OBJECT_MYSTERIOUS_WANDERER</LocID>                   <Text>Misterioso vagabondo</Text></GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>DIALOG_OBJECT_MYSTERIOUS_WANDERER_TEXT</LocID>              <Text><![CDATA[Ciao, amico mio. Sei il primo che è riuscito a raggiungermi in questo ciclo. E per questo ti concedo <color=SOTS_COLOR_XP>1000 punti esperienza</color> e potrai <color=SOTS_COLOR_GOLD>scegliere</color> quale <color=SOTS_COLOR_GOLD>attributo</color> desideri <color=SOTS_COLOR_GOLD>migliorare di 1</color>.]]></Text></GameDBLocalizedString>
                                                                                                            
            <!--Traveling merchant-->                                                                       
