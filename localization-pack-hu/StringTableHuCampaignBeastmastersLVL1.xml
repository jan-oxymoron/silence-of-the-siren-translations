<?xml version="1.0" encoding="utf-8"?><Database>
    <GameDBStringTable ID="LOC_HU_CAMPAIGN_BEASTMASTERS_LVL1">

        <LanguageRef>LANG_HU</LanguageRef>

        <Contributors>
            <Name>Hahakocka</Name>
        </Contributors>

        <LocalizedStrings>
            <!--OBJECTIVES MAIN QUESTS-->
            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_BEASTMASTERS_LVL1_START</LocID>                   <Text>Start the offensive</Text>  </GameDBLocalizedString>
          
            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_BEASTMASTERS_LVL1_SECOND_BASE_1</LocID>           <Text>Attack the Children of the Source strongpoints 0/2</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_BEASTMASTERS_LVL1_SECOND_BASE_2</LocID>           <Text>Attack the Children of the Source strongpoints 1/2</Text>  </GameDBLocalizedString>
            
            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_BEASTMASTERS_LVL1_GET_SETRI_TO_ELEVATOR</LocID>   <Text>Reach the orbital teleport</Text>  </GameDBLocalizedString>

            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_BEASTMASTERS_LVL1_RETAKE_X_BASE</LocID>           <Text>Capture the Xenauri base </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_BEASTMASTERS_LVL1_RETAKE_X_BASE_DONE</LocID>      <Text><![CDATA[<color=SOTS_COLOR_MOVEMENT>Capture the Xenauri base - Finished</color>]]></Text>  </GameDBLocalizedString>

            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_BEASTMASTERS_LVL1_FIND_WAY_SURFACE</LocID>        <Text>Exit the underground</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_BEASTMASTERS_LVL1_FIND_WAY_SURFACE_DONE</LocID>   <Text><![CDATA[<color=SOTS_COLOR_MOVEMENT>Exit the underground - Finished</color>]]></Text>  </GameDBLocalizedString>

            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_BEASTMASTERS_LVL1_INBARK_1</LocID>                <Text>Get your commanders on board 0/2</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_BEASTMASTERS_LVL1_INBARK_2</LocID>                <Text>Get your commanders on board 1/2</Text>  </GameDBLocalizedString>
          
            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_BEASTMASTERS_LVL1_FOS_BASE_1</LocID>                <Text>Conquer the Fossorian bases 0/3</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_BEASTMASTERS_LVL1_FOS_BASE_2</LocID>                <Text>Conquer the Fossorian bases 1/3</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_BEASTMASTERS_LVL1_FOS_BASE_3</LocID>                <Text>Conquer the Fossorian bases 2/3</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_BEASTMASTERS_LVL1_FOS_BASE_4</LocID>                <Text><![CDATA[<color=SOTS_COLOR_MOVEMENT>Conquer the Fossorian bases 3/3 - Finished</color>]]> </Text>  </GameDBLocalizedString>
            
            <!--DIALOGUES-->
            <!--Se-Wari and Se-Tri are standing near their base.   -->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_START_NARRATOR_0</LocID>          <Text>The Xenauri Riders DLC takes place after the events of Silence of the Siren, the original game’s campaign.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_START_NARRATOR_1</LocID>          <Text>Planet Scylla, near the freshly established forward base of the Xenauri landing force.   </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_START_T_1</LocID>                 <Text>Put down your tools! We’re going on the offensive! The storm has begun! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_START_W_1</LocID>                 <Text>That’s insane! We’ve only just started building the camp! We’re not ready!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_START_T_2</LocID>                 <Text>Silence! You are speaking to the Pathfinder's Altari Guard! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_START_W_2</LocID>                 <Text>How could I ever forget, sister? </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_START_T_3</LocID>                 <Text>What was that? </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_START_W_3</LocID>                 <Text>Nothing, Mighty.  </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_START_T_4</LocID>                 <Text>We have been entrusted with capturing the Iron Insect strongpoints here...</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_START_T_5</LocID>                 <Text>... and here. I’ll lead the attack. You handle logistics! To fail is to betray the Pathfinder! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_START_W_4</LocID>                 <Text>[WHISPERING TO HERSELF] Like true fanatics. </Text>  </GameDBLocalizedString>
            
            <!--First encounter with the Iron Insect warrior (Children of the Source) hero.-->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_CHILDREN_ENC_RH_1</LocID>         <Text>It’s an Iron Insect warrior!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_CHILDREN_ENC_KNIGHT_1</LocID>     <Text>[SPEAKING IN A STRANGE LANGUAGE, SLIGHTLY DISTORTED BY METALLIC SOUNDS] </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_CHILDREN_ENC_W_1</LocID>          <Text>Is he trying to negotiate? Maybe we could find some way to communicate! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_CHILDREN_ENC_T_2</LocID>          <Text>They are just mindless robots! The Pathfinder ordered their extermination! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_CHILDREN_ENC_W_2</LocID>          <Text>And since the day you joined the Pathfinder’s Guard, his word has been law. [WHISPERING TO HERSELF] Regardless of common sense. </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_CHILDREN_ENC_KNIGHT_2</LocID>     <Text>[SHARP METALLIC SOUNDS] </Text>  </GameDBLocalizedString>
           
            <!--Iron Insect warrior is defeated.-->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_ARTAR_DEFEATED_W_1</LocID>        <Text>Rest now, Iron Insect warrior. I hope you find peace.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_ARTAR_DEFEATED_T_1</LocID>        <Text>The Iron Insects are no match for the Pathfinder's Altari Guard!</Text>  </GameDBLocalizedString>

            <!--First base of the Children of the Source is conquered.  -->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_FIRST_FORTRESS_IS_CONQUERED_RH_1</LocID>   <Text>The first strongpoint is ours!  </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_FIRST_FORTRESS_IS_CONQUERED_T_2</LocID>    <Text>The first strongpoint was claimed in the Pathfinder’s name. Once we capture the second, the bank will be ours!    </Text>  </GameDBLocalizedString>

            <!--At the start of the next game turn, Se-Wari notise a bright flash in the sky. -->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_EXPLOSION_FORESHADOWED_W_1</LocID>         <Text>I see bright flashes in the clouds above us! But I’ve never seen a storm like that!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_EXPLOSION_FORESHADOWED_T_1</LocID>         <Text>That's no storm, fool! It's the Mothership! It's bombarding the neighboring sector!   </Text>  </GameDBLocalizedString>

            <!--At the start of the next game turn, flashes intensifies. -->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SETRI_SUMMONED_W_</LocID>         <Text>The flashes intensified!   </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SETRI_SUMMONED_T_1</LocID>        <Text>The Mothership is under attack! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SETRI_SUMMONED_W_2</LocID>        <Text>How can you tell from here?! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SETRI_SUMMONED_T_3</LocID>        <Text>The connection... I must return to the ship... to the crystal shrine! </Text>  </GameDBLocalizedString>
            
            <!--Se-Tri arrives to the teleport but befor she can enter and debris from the Mothership struck the place. She teleports Se-Wari out of harms way just in time.  -->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_TELEPORT_CRASH_RH_1</LocID>       <Text>We’re nearly there... WHAT?! THAT FLASH WAS TOO BRIGHT FOR ANY WEAPON! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_TELEPORT_CRASH_T_1</LocID>        <Text>The Mothership! My connection with the crystal shrine! ... I don’t feel well.   </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_TELEPORT_CRASH_W_1</LocID>        <Text>Se-Tri?... Are you alright?  </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_TELEPORT_CRASH_T_3</LocID>        <Text>No... I don’t... Where am I?! Don’t come any closer!    </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_TELEPORT_CRASH_W_3</LocID>        <Text>Se-Tri, I... what is that swishing sound?! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_TELEPORT_CRASH_W_4</LocID>        <Text>Something is falling straight toward us! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_TELEPORT_CRASH_T_4</LocID>        <Text>No!</Text>  </GameDBLocalizedString>

            <!--Se-Wari appears in the underground and is immediately surrounded by Fossorians.-->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEWARI_CAPTURED_W_1</LocID>           <Text>Did she just teleport me out of harm’s way?</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEWARI_CAPTURED_FOSSORIAN_2</LocID>   <Text>[SPEAKING IN A STRANGE LANGUAGE, SLIGHTLY DISTORTED BY THE NON-HUMANOID SHAPE OF THE MOUTH]</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEWARI_CAPTURED_W_2</LocID>           <Text>Or perhaps straight into another kind of trouble.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEWARI_CAPTURED_W_3</LocID>           <Text>Big trouble! </Text>  </GameDBLocalizedString>
            
            <!--In a small cave Se-Wari chat with Captain Pick (the only Sovereign fleet hero of Fossorain descend). In the middle of the conversation the Fossorian hero Bokas arrives. -->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PICK_AND_SEWARI_NARRATOR_1</LocID>       <Text>A few days later. Deep underground.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PICK_AND_SEWARI_P_1.5</LocID>            <Text>...you learn quickly, girl, but...  </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PICK_AND_SEWARI_BOKAS_1</LocID>          <Text>I don’t pay you to chat, Pick! You're supposed to interrogate her about the artifacts!  </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PICK_AND_SEWARI_W_2</LocID>              <Text>Artifacts?        </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PICK_AND_SEWARI_P_3</LocID>              <Text>Xenauri technology found in debris from your Mothership...  </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PICK_AND_SEWARI_W_5</LocID>              <Text>Debris! The Mothership was destroyed?!...       </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PICK_AND_SEWARI_BOKAS_2</LocID>          <Text>Shut up, you two! I care only about the artifacts! Nobody knows how to use them! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PICK_AND_SEWARI_W_6</LocID>              <Text>But I can’t help you... </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PICK_AND_SEWARI_BOKAS_3</LocID>          <Text>The pain will untangle your tongue!!!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PICK_AND_SEWARI_W_7</LocID>              <Text>STOP! IT HURTS!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PICK_AND_SEWARI_BOKAS_4</LocID>          <Text>You brought this upon yourself!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PICK_AND_SEWARI_P_9</LocID>              <Text>That’s enough, Bokas! Stop!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PICK_AND_SEWARI_P_10</LocID>             <Text>I said STOP!  </Text>  </GameDBLocalizedString>
            
            <!--Pick decide to help Se-Wari and they defeat Bokas.  -->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEWARI_LIBERATED_BOKAS_1</LocID>     <Text>[TO THE RADIO] Help me, my friends! The prisoners are escaping!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEWARI_LIBERATED_TOTT_1</LocID>      <Text>Who are you calling a friend, you bastard?!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEWARI_LIBERATED_MOLTAIR_1</LocID>   <Text>Yeah, you stinking pile of worm dung!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEWARI_LIBERATED_BENI_1</LocID>      <Text>I am coming to your aid, Bokas, my dearest friend!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEWARI_LIBERATED_BOKAS_3</LocID>     <Text>Oh, no you don’t! I’d rather be killed than saved by an ugly halfbreed! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEWARI_LIBERATED_P_1</LocID>         <Text>[CLICK OF THE COMMUNICATOR BEING SHUT DOWN] ...That’s better.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEWARI_LIBERATED_W_1</LocID>         <Text>Pick, I...  </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEWARI_LIBERATED_P_2</LocID>         <Text>Save your thanks, girl. I like you, but that doesn’t mean we’re friends.... I’m after the Xenauri artifacts too. I get you out, you teach me how to use them. Deal?    </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEWARI_LIBERATED_W_2</LocID>         <Text>I’ll tell you everything I know... on one condition: you help me find my sister. She’s Altari, so she’ll be alright... But I need to be sure.  </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEWARI_LIBERATED_P_3</LocID>         <Text>Altari? </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEWARI_LIBERATED_W_3</LocID>         <Text>It means something like a psyker. And she is one of the Pathfinder's Altari Guard, so she is exceptionally gifted. </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEWARI_LIBERATED_P_4</LocID>         <Text>Psyker, you say... OK! We have a deal... Now, my furry kindred have pulled so much debris from your Mothership that we can start building a base down here! </Text>  </GameDBLocalizedString>

            <!--At the start of the next game turn, Se-Wari asks Pick how he joined Fossorians. -->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PICK_REASONING_W_1</LocID>        <Text>Earlier, you said you were hired to teach me?  </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PICK_REASONING_P_1</LocID>        <Text>They caught me sniffing around the debris. So I said I wanted to join them and waited for a chance to quietly disappear.  </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PICK_REASONING_W_2</LocID>        <Text>I think the quiet is off the table.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PICK_REASONING_P_2</LocID>        <Text>Yeah, but don’t worry. Old Pick knows which end of the hammer to hold.   </Text>  </GameDBLocalizedString>

            <!--First Fossorian hero defeated -->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_ELEVATOR_INFO_P_1</LocID>         <Text>Now that we have the base, we have a chance to fight our way to the elevator leading to the surface. </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_ELEVATOR_INFO_W_1</LocID>         <Text>And once we reach the surface?  </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_ELEVATOR_INFO_P_2</LocID>         <Text>It ain’t gonna get easier, girl, but I’ve got some crewmates and a fast ship hidden in the rocks.  </Text>  </GameDBLocalizedString>
            
            <!-- After they escape the underground, Se-Wari disscus with Pick their nex move.-->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SURFACE_RH_1</LocID>              <Text>Surface! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SURFACE_W_1</LocID>               <Text>Damn, that's pretty far from the place where my sister and I were separated. </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SURFACE_P_1</LocID>               <Text>Not that far, but I know the area, and the ship is the only way to get there.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SURFACE_P_2</LocID>               <Text>So, time to contact my crew. I hope they didn’t run off while I was stuck down there.  </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SURFACE_P_3</LocID>               <Text>Freddie, Alfa, you lazy, miserable pricks! Do you copy? </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SURFACE_FREDDIE_1</LocID>         <Text>We hear you, boss! We’d never leave without you! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SURFACE_ALFA_1</LocID>            <Text>So, shall I delete the week-long recording of you whining about wanting to fly off, Freddie?   </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SURFACE_FREDDIE_2</LocID>         <Text>Hey, Alfa! Fuck you! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SURFACE_P_4</LocID>               <Text>Shut up, imbeciles! We’re heading your way. </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SURFACE_ALFA_2</LocID>            <Text>We?  </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SURFACE_P_5</LocID>               <Text>Yeah, I’ve got company. A Xenauri.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SURFACE_FREDDIE_3</LocID>         <Text>Xenauri?   </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SURFACE_ALFA_3</LocID>            <Text>The aliens, Freddie! The Sovereign Net hasn’t buzzed about anything else for a week. Maybe if you didn’t play Tetris all day long...  </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SURFACE_FREDDIE_4</LocID>         <Text>...you just have to keep embarrassing me, Alfa... </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SURFACE_P_6</LocID>               <Text>[CLICK OF COMMUNICATOR BEING SHUT DOWN]... I got those two at a discount... damaged goods. </Text>  </GameDBLocalizedString>
            
            <!--Our heroes discover a second Xenauri base. -->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SURFACE_BASE_RH_1</LocID>         <Text>Another place where the Fossorians piled up debris. An ideal spot to start another base.</Text>  </GameDBLocalizedString>

            <!--Suddenly, a radio transmission starts. The Pathfinder briefly appears on screen.-->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PATH_CALL_PATHFINDER_1</LocID>    <Text>[SIGNAL DISTORTIONS]... My Altari Guard ... [SIGNAL DISTORTIONS] ... confused ... [SIGNAL DISTORTIONS] ... the seventh planet of this system ... [SIGNAL DISTORTIONS] ... coordinates 0-6-0-3... </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PATH_CALL_P_1</LocID>             <Text>The seventh planet. That means Chimera! But who was that? </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PATH_CALL_W_1</LocID>             <Text>The Pathfinder. Keeper of the Crystal Shrine. He and his Altari Guard unified the clans of my homeworld.    </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PATH_CALL_P_2</LocID>             <Text>So he is something like the strongest of the Altari?</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PATH_CALL_W_3</LocID>             <Text>No, he is not. But his Altari Guard is fanatically loyal to him. </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PATH_CALL_P_3</LocID>             <Text>Interesting.</Text>  </GameDBLocalizedString>


            <!--Suddenly, a radio transmission starts. The Se-Tri briefly appears on screen.-->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SETRI_CALL_SETRI_1</LocID>        <Text>...[SIGNAL DISTORTIONS]...</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SETRI_CALL_W_1</LocID>            <Text>Se-Tri?!... Damn! It went silent again! She must still be stranded somewhere on the northern bank! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SETRI_CALL_P_1</LocID>            <Text>You seem worried. Didn’t you say she’s Altari? </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SETRI_CALL_W_2</LocID>            <Text>Yes, but something changed in her after our Mothership was destroyed.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SETRI_CALL_P_2</LocID>            <Text>Like she lost her psionic powers? </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SETRI_CALL_W_3</LocID>            <Text>No, but she seemed confused, even scared... Since she joined the Guard, I’d almost forgotten that she could be scared... She’s changed so much... Why so many questions about her?</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SETRI_CALL_P_4</LocID>            <Text>Just curious, that’s all. </Text>  </GameDBLocalizedString>

            <!--Se-Wari approach a crystal biom part of the map.-->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_CRYSTALS_W_1</LocID>              <Text>Those crystals remind me of my planet. Crystal mountains, crystal deserts, crystal caves... that’s basically it. Crystals and Ssaari lizards.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_CRYSTALS_P_2</LocID>              <Text>Your world sounds like a tough place to live.  </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_CRYSTALS_W_2</LocID>              <Text>Yeah, it’s basically dead. But the old paintings resemble what I see here. Trees, grass, rocks, water... even the strange monoliths we’re looking at now.        </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_CRYSTALS_P_3</LocID>              <Text>Ruins of ancient Primals? On your planet?</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_CRYSTALS_W_3</LocID>              <Text>But only in those paintings. Crystals as far as I can see... that’s the only world I know. </Text>  </GameDBLocalizedString>

            <!--Near the Pick's ship.-->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEW_CONFESSION_P_1</LocID>        <Text>The ship! It’s not far away! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEW_CONFESSION_W_1</LocID>        <Text>Pick, I wasn’t completely honest with you. The artifacts from the Xenauri Mothership...</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEW_CONFESSION_P_2</LocID>        <Text>They won’t work...</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEW_CONFESSION_W_2</LocID>        <Text>How do you know?</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEW_CONFESSION_P_3</LocID>        <Text>If we can’t see an interface, that doesn’t mean there isn’t one. And a psyker... I mean, an Altari can see what others cannot, right? </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEW_CONFESSION_W_3</LocID>        <Text>Yes... so why are you helping me? </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEW_CONFESSION_P_4</LocID>        <Text>Clever, girl. I like you, but that doesn’t mean we’re friends... there’s another reason, too. I’ll explain once we’re safe on the ship.</Text>  </GameDBLocalizedString>
            
            <!--At the surface, our heroes encounter Long Molly a Fossorian main commander of the area.  -->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SHIP_FOSS_BASES_MOLLY_1</LocID>   <Text>You two idiots ruined it all! My underground base is in flames! The artifacts my Fossorians gathered are worthless, and now there are reports of UNSS ships in geostationary orbit above us! I’d bet my hammer that this is your doing too!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SHIP_FOSS_BASES_P_1</LocID>       <Text>The UNSS?! I would never work for them!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SHIP_FOSS_BASES_MOLLY_2</LocID>   <Text>That lie is as big as my hammer! But I’m not stupid! I know you’ve got a ship hidden somewhere nearby! If you take off, my anti-aircraft guns will shoot you down!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SHIP_FOSS_BASES_P_2</LocID>       <Text>Anti-aircraft guns will be a problem, and those UNSS ships too.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SHIP_FOSS_BASES_W_2</LocID>       <Text>UNSS? </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SHIP_FOSS_BASES_P_3</LocID>       <Text>The biggest bunch of morons, who think they run everything around here. But the Princess keeps them on a short leash. At least for now. </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SHIP_FOSS_BASES_W_3</LocID>       <Text>Who is this Princess? </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SHIP_FOSS_BASES_P_4</LocID>       <Text>A powerful alien psyker... like your Altari! But don’t worry, we’re too small a fish for her hook. Enough chit-chat. Those anti-aircraft guns won’t disable themselves. </Text>  </GameDBLocalizedString>

            <!--Both Fossorian bases are conquered.  -->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SHIP_FLY_RH_1</LocID>             <Text>The bases are ours! The anti-aircraft guns are disabled! Now we can fly out! </Text>  </GameDBLocalizedString>

            <!--Long Molly is defeated. -->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_MOLLY_AF_MOLLY_1</LocID>          <Text>Every time I build a position for myself, some morons show up and ruin everything!</Text>  </GameDBLocalizedString>

            <!--The first Fossorian base is conquered. -->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_LAST_BASE_RH_1</LocID>            <Text>Only one base remains.</Text>  </GameDBLocalizedString>

            <!--Molly spawns before the remaining Fossorian base to face our heroes. -->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_MOLLY_SPAWN_RH_1</LocID>          <Text>The last base! Once the anti-aircraft defenses are down, we can fly out! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_MOLLY_SPAWN_MOLLY_1</LocID>       <Text>Not while my Hammer has something to say about that! </Text>  </GameDBLocalizedString>
            
            <!--The Pick's ship was reached by one of the heroes before the both Fossorian bases were conquered.  -->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_CANNOT_BOARD_RH_1</LocID>         <Text>Can’t board yet. The anti-aircraft guns in the Fossorian bases are still online. </Text>  </GameDBLocalizedString>
            
            <!--The Pick's ship was reached by one of the heroes after the both Fossorian bases were conquered.  -->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_NEAR_SHIP_RH_1</LocID>            <Text>I made it to the ship. </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_NEAR_SHIP_RH_2</LocID>            <Text>Okay, board and wait for me.</Text>  </GameDBLocalizedString>

            <!--End, our heroes speaks on board of the Pick's ship. Freddi and Alfa are also present on board. -->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_P_1</LocID>                   <Text>Hey, kids! Uncle Pick is home... Get your dirty feet off the navicomp, Freddie!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_FREDDIE_1</LocID>             <Text>Yes, my captain, admiral, almighty boss!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_ALFA_1</LocID>                <Text>Good, you two made it. While we waited, we gathered a lot of artifacts from the debris of the Xenauri ship. But... </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_FREDDIE_2</LocID>             <Text>...shit, there are no buttons to screw with, boss!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_ALFA_2</LocID>                <Text>But that’s why you brought the Xenauri, right?</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_P_2</LocID>                   <Text>Forget the Xenauri junk for a while! First, we need to find out what happened to her sister. I need to get north...  </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_FREDDIE_3</LocID>             <Text>Yeah, well... NO. That ain’t happening, boss. </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_P_3</LocID>                   <Text>Why, Freddie, enlighten me!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_ALFA_3</LocID>                <Text>The UNSS forces took over the whole northern bank...</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_FREDDIE_4</LocID>             <Text>Chiquita! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_P_4</LocID>                   <Text>Chiquita what?! Fucking bananas?! Stop shouting random words and pretend you graduated from kindergarten! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_FREDDIE_5</LocID>             <Text>Chiquita landed with them. And guess who was flying that ship? The fucking Princess! Three meters tall, chitin, psionic powers! I met her once and...</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_ALFA_4</LocID>                <Text>...your trousers were never the same. We all know that, Freddie. But the Princess took off shortly after! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_W_2</LocID>                   <Text>The Princess must have sensed Se-Tri’s psionic powers and captured her!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_P_5</LocID>                   <Text>We must verify that first. But I fear you’ve hit the nail on the head, girl. We need to find out where the Princess took her. </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_FREDDIE_6</LocID>             <Text>What?! Why?!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_P_6</LocID>                   <Text>Shut up, Freddie... Her sister is Altari, which means a powerful psyker! Until now, the Princess has had a monopoly on “magic”! That has to change!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_W_3</LocID>                   <Text>So that’s the true reason! That’s why you kept asking about the Altari and my sister!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_P_7</LocID>                   <Text>Thanks to her psionic powers, the Princess has absolute control over long-distance space travel. So she holds power over every major faction in the system. </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_ALFA_5</LocID>                <Text>I don’t like her either, but the factions stopped all major fighting after she took over.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_P_8</LocID>                   <Text>But how long the peace lasts is up to her alone! Imagine everybody could travel wherever they wanted! New worlds are up there, waiting to be discovered! It would be...  </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_FREDDIE_7</LocID>            <Text>The shiniest Sovereign dream come true!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_ALFA_6</LocID>                <Text>And the Xenauri psykers are the key. </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_W_4</LocID>                   <Text>Pick, I ...   </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_P_9</LocID>                   <Text>Save your thanks, girl. We just decided to go against the most dangerous being in the Siren System. We may well regret it before it’s done.   </Text>  </GameDBLocalizedString>

            <!--Enemy FOSSORIAN COMMANDERS - QOUTES-->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_BENNI_BF_BENNI_1</LocID>          <Text>I’ll strike you down for my friend, Bokas!</Text>  </GameDBLocalizedString>
            
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_MOLTAIR_BF_MOLTAIR_1</LocID>      <Text>I am Moltair! Ex-commander of the Liberator Division! Winner of countless battles... </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_MOLTAIR_BF_P_1</LocID>            <Text>... nobody has ever heard of.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_MOLTAIR_BF_X_1</LocID>            <Text>You are so loud for such a small creature! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_MOLTAIR_BF_MOLTAIR_2</LocID>      <Text>Arrgh!!! You will never see the sun again! </Text>  </GameDBLocalizedString>

            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_TOTT_BF_QUETIN_1</LocID>          <Text>Hello, I’m Quetin from Moletargis! </Text>  </GameDBLocalizedString>
 
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_TOTT_BF_TOTT_1</LocID>            <Text>Your little prison break ends here!    </Text>  </GameDBLocalizedString>
            
        </LocalizedStrings>
    </GameDBStringTable>
</Database>
