<?xml version="1.0" encoding="utf-8"?><Database>
    <GameDBStringTable ID="LOC_HU_CAMPAIGN_BEASTMASTERS_LVL1">

        <LanguageRef>LANG_HU</LanguageRef>

        <Contributors>
            <Name>Hahakocka</Name>
        </Contributors>

        <LocalizedStrings>
            <!--OBJECTIVES MAIN QUESTS-->
            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_BEASTMASTERS_LVL1_START</LocID>                   <Text>Indítsd meg a támadást</Text>  </GameDBLocalizedString>
          
            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_BEASTMASTERS_LVL1_SECOND_BASE_1</LocID>           <Text>Támadd meg a Forrás Gyermekeinek erődített állásait. 0/2</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_BEASTMASTERS_LVL1_SECOND_BASE_2</LocID>           <Text>Támadd meg a Forrás Gyermekeinek erődített állásait. 1/2</Text>  </GameDBLocalizedString>
            
            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_BEASTMASTERS_LVL1_GET_SETRI_TO_ELEVATOR</LocID>   <Text>Érd el az orbitális teleportot.</Text>  </GameDBLocalizedString>

            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_BEASTMASTERS_LVL1_RETAKE_X_BASE</LocID>           <Text>Foglald el a Xenauri-bázist. </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_BEASTMASTERS_LVL1_RETAKE_X_BASE_DONE</LocID>      <Text><![CDATA[<color=SOTS_COLOR_MOVEMENT>Foglald el a Xenauri-bázist. - Elvégezve</color>]]></Text>  </GameDBLocalizedString>

            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_BEASTMASTERS_LVL1_FIND_WAY_SURFACE</LocID>        <Text>Menj fel a felszínre a Földalatti területről</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_BEASTMASTERS_LVL1_FIND_WAY_SURFACE_DONE</LocID>   <Text><![CDATA[<color=SOTS_COLOR_MOVEMENT>Menj fel a felszínre a Földalatti területről - Elvégezve</color>]]></Text>  </GameDBLocalizedString>

            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_BEASTMASTERS_LVL1_INBARK_1</LocID>                <Text>Állítsd magad mellé a parancsnokaidat. 0/2</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_BEASTMASTERS_LVL1_INBARK_2</LocID>                <Text>Állítsd magad mellé a parancsnokaidat. 1/2</Text>  </GameDBLocalizedString>
          
            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_BEASTMASTERS_LVL1_FOS_BASE_1</LocID>                <Text>Foglald el a Földtúrók bázisait. 0/3</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_BEASTMASTERS_LVL1_FOS_BASE_2</LocID>                <Text>Foglald el a Földtúrók bázisait 1/3</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_BEASTMASTERS_LVL1_FOS_BASE_3</LocID>                <Text>Foglald el a Földtúrók bázisait 2/3</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>OBJECTIVE_CAMPAIGN_BEASTMASTERS_LVL1_FOS_BASE_4</LocID>                <Text><![CDATA[<color=SOTS_COLOR_MOVEMENT>Foglald el a Földtúrók bázisait 3/3 - Elvégezve</color>]]> </Text>  </GameDBLocalizedString>
            
            <!--DIALOGUES-->
            <!--Se-Wari and Se-Tri are standing near their base.   -->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_START_NARRATOR_0</LocID>          <Text>A Xenauri Nomádok DLC az eredeti játék kampánya, a Heroes of Science &amp; Fiction eseményeit követően játszódik.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_START_NARRATOR_1</LocID>          <Text>A Szkülla bolygón, a Xenauri partraszálló erők frissen létesített előretolt támaszpontjának közelében.   </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_START_T_1</LocID>                 <Text>Tegyétek le a szerszámokat! Támadásba lendülünk! Kitört a vihar! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_START_W_1</LocID>                 <Text>Ez őrület! Hiszen épp csak elkezdtük a tábor építését! Még nem vagyunk készen!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_START_T_2</LocID>                 <Text>Csend! A Nyomkereső Altári Gárdájához beszélsz! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_START_W_2</LocID>                 <Text>Hogyan is felejthetném el ezt valaha, nővérem?? </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_START_T_3</LocID>                 <Text>Mi volt ez? </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_START_W_3</LocID>                 <Text>Semmi, Hatalmaskám.  </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_START_T_4</LocID>                 <Text>A feladatunk az itteni Vasrovar-erődítmények elfoglalása....</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_START_T_5</LocID>                 <Text>... ...és itt. Én vezetem a támadást. Te felelsz a logisztikáért! A kudarc egyenlő a Nyomkereső elárulásával! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_START_W_4</LocID>                 <Text>[MAGÁBAN SUTTOGVA] Mint az igazi fanatikusok. </Text>  </GameDBLocalizedString>
            
            <!--First encounter with the Iron Insect warrior (Children of the Source) hero.-->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_CHILDREN_ENC_RH_1</LocID>         <Text>Ez egy Vasrovar-harcos.!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_CHILDREN_ENC_KNIGHT_1</LocID>     <Text>[Idegen nyelven beszélve, fémes hangok által kissé torzítva] </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_CHILDREN_ENC_W_1</LocID>          <Text>Vajon tárgyalni próbál? Talán találhatnánk valamilyen módot a kommunikációra! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_CHILDREN_ENC_T_2</LocID>          <Text>Csak gondolkodás nélküli robotok! A Nyomkereső elrendelte a kiirtásukat! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_CHILDREN_ENC_W_2</LocID>          <Text>És amióta csatlakoztál a Nyomkereső Őrségéhez, az ő szava a törvény.. [MAGÁBAN SUTTOGVA] A józan ész figyelmen kívül hagyásával. </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_CHILDREN_ENC_KNIGHT_2</LocID>     <Text>[Éles, fémes hangok] </Text>  </GameDBLocalizedString>
           
            <!--Iron Insect warrior is defeated.-->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_ARTAR_DEFEATED_W_1</LocID>        <Text>Pihenj most, Vasrovar harcos. Remélem, megtalálod a békét..</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_ARTAR_DEFEATED_T_1</LocID>        <Text>A Vasrovarok nem érnek fel a Nyomkereső Altári Gárdájával!</Text>  </GameDBLocalizedString>

            <!--First base of the Children of the Source is conquered.  -->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_FIRST_FORTRESS_IS_CONQUERED_RH_1</LocID>   <Text>Az első erődített állás pont a miénk!  </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_FIRST_FORTRESS_IS_CONQUERED_T_2</LocID>    <Text>Az első erődített állást a Nyomkereső nevében foglaltuk el. Ha a másodikat is elfoglaljuk, a bank a miénk lesz!    </Text>  </GameDBLocalizedString>

            <!--At the start of the next game turn, Se-Wari notise a bright flash in the sky. -->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_EXPLOSION_FORESHADOWED_W_1</LocID>         <Text>Élénk villanásokat látok a fejünk feletti felhőkben! De még sosem láttam ilyen vihart.!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_EXPLOSION_FORESHADOWED_T_1</LocID>         <Text>Az nem vihar, te bolond! Az az Anyahajó! Épp a szomszédos szektort bombázza.!   </Text>  </GameDBLocalizedString>

            <!--At the start of the next game turn, flashes intensifies. -->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SETRI_SUMMONED_W_</LocID>         <Text>A villanások felerősödtek!   </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SETRI_SUMMONED_T_1</LocID>        <Text>Támadás érte az anyahajót! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SETRI_SUMMONED_W_2</LocID>        <Text>Hogy tudod ezt megállapítani innen?! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SETRI_SUMMONED_T_3</LocID>        <Text>A kapcsolat... Vissza kell térnem a hajóra... a Kristályszentélyhez.! </Text>  </GameDBLocalizedString>
            
            <!--Se-Tri arrives to the teleport but befor she can enter and debris from the Mothership struck the place. She teleports Se-Wari out of harms way just in time.  -->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_TELEPORT_CRASH_RH_1</LocID>       <Text>Mindjárt ott vagyunk... MI?! AZ A VILLANÁS TÚL ERŐS VOLT BÁRMILYEN FEGYVERHEZ! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_TELEPORT_CRASH_T_1</LocID>        <Text>Az Anyahajó! A kapcsolatom a Kristályszentéllyel! ... Nem érzem jól magam.   </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_TELEPORT_CRASH_W_1</LocID>        <Text>Se-Tri?... Jól vagy?  </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_TELEPORT_CRASH_T_3</LocID>        <Text>Nem... nem... Hol vagyok?! Ne gyere közelebb!    </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_TELEPORT_CRASH_W_3</LocID>        <Text>Se-Tri, Én... mi az a suhogó hang?! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_TELEPORT_CRASH_W_4</LocID>        <Text>Valami egyenesen felénk zuhan! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_TELEPORT_CRASH_T_4</LocID>        <Text>Nem!</Text>  </GameDBLocalizedString>

            <!--Se-Wari appears in the underground and is immediately surrounded by Fossorians.-->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEWARI_CAPTURED_W_1</LocID>           <Text>Csak nem elteleportáltatott engem a bajból?</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEWARI_CAPTURED_FOSSORIAN_2</LocID>   <Text>[Idegen nyelven beszélve, amelyet kissé eltorzít a száj nem humanoid alakja.]</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEWARI_CAPTURED_W_2</LocID>           <Text>Vagy talán egyenesen csak egy másfajta bajba.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEWARI_CAPTURED_W_3</LocID>           <Text>Nagy bajba! </Text>  </GameDBLocalizedString>
            
            <!--In a small cave Se-Wari chat with Captain Pick (the only Sovereign fleet hero of Fossorain descend). In the middle of the conversation the Fossorian hero Bokas arrives. -->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PICK_AND_SEWARI_NARRATOR_1</LocID>       <Text>Néhány nappal később. Mélyen a föld alatt.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PICK_AND_SEWARI_P_1.5</LocID>            <Text>...Gyorsan tanulsz, leány, de...  </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PICK_AND_SEWARI_BOKAS_1</LocID>          <Text>Nem azért fizetek neked, hogy csevegj, Pick! Az lenne a dolgod, hogy kifaggasd az Ereklyékről!  </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PICK_AND_SEWARI_W_2</LocID>              <Text>Ereklyékről?        </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PICK_AND_SEWARI_P_3</LocID>              <Text>Az Anyahajótok roncsai között talált Xenauri-technológia....  </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PICK_AND_SEWARI_W_5</LocID>              <Text>Törmelékek! Megsemmisült az anyahajó?!...       </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PICK_AND_SEWARI_BOKAS_2</LocID>          <Text>Fogjátok be a szátokat, ti ketten! Engem csak az Ereklyék érdekelnek! Senki sem tudja, hogyan kell használni őket! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PICK_AND_SEWARI_W_6</LocID>              <Text>De nem tudok segíteni neked.... </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PICK_AND_SEWARI_BOKAS_3</LocID>          <Text>A fájdalom majd megoldja a nyelvedet!!!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PICK_AND_SEWARI_W_7</LocID>              <Text>HAGYD ABBA! EZ FÁJ!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PICK_AND_SEWARI_BOKAS_4</LocID>          <Text>Ezt te hoztad a saját fejedre!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PICK_AND_SEWARI_P_9</LocID>              <Text>Elég volt, Bokas! Állj le!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PICK_AND_SEWARI_P_10</LocID>             <Text>Azt mondtam ÁLLJ LE!  </Text>  </GameDBLocalizedString>
            
            <!--Pick decide to help Se-Wari and they defeat Bokas.  -->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEWARI_LIBERATED_BOKAS_1</LocID>     <Text>[A RÁDIÓHOZ] Segítsetek, barátaim! Szöknek a foglyok!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEWARI_LIBERATED_TOTT_1</LocID>      <Text>Kit nevezel barátnak, te rohadék?!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEWARI_LIBERATED_MOLTAIR_1</LocID>   <Text>Úgy ám, te büdös gilisztaürülék-halom!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEWARI_LIBERATED_BENI_1</LocID>      <Text>Segítségedre sietek, Bokas, legkedvesebb barátom!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEWARI_LIBERATED_BOKAS_3</LocID>     <Text>Na azt már nem! Inkább meghalok, mintsem hogy egy csúnya félvér mentsen meg! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEWARI_LIBERATED_P_1</LocID>         <Text>[A kommunikátor kikapcsolásakor hallható kattanás] ...Így már jobb.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEWARI_LIBERATED_W_1</LocID>         <Text>Pick, Én...  </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEWARI_LIBERATED_P_2</LocID>         <Text>Hagyd a köszönetet, leány. Kedvellek, de ez nem jelenti azt, hogy barátok vagyunk... Én is a Xenauri Ereklyékre vágyom. Ha kihozlak, akkor megtanítasz használni őket. Üzlet?    </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEWARI_LIBERATED_W_2</LocID>         <Text>Elmondok mindent, amit tudok... egyetlen feltétellel: segítesz megtalálni a húgomat. Altári származású, szóval nem eshet baja... De biztos akarok lenni benne.  </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEWARI_LIBERATED_P_3</LocID>         <Text>Altári? </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEWARI_LIBERATED_W_3</LocID>         <Text>Olyasmit jelent, mint a Pszí-használók. Ráadásul a Nyomkereső Altári Gárdájának a tagja, tehát kivételes képességekkel rendelkezik. </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEWARI_LIBERATED_P_4</LocID>         <Text>Pszí-használó, mondod... Rendben! Megegyeztünk... Nos, szőrös fajtársaim annyi törmeléket hoztak fel az Anyahajótokból, hogy már neki is láthatunk egy bázis építésének itt lent! </Text>  </GameDBLocalizedString>

            <!--At the start of the next game turn, Se-Wari asks Pick how he joined Fossorians. -->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PICK_REASONING_W_1</LocID>        <Text>Korábban azt mondtad, azért fogadtak fel, hogy tanítsál?  </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PICK_REASONING_P_1</LocID>        <Text>Rajtakaptak, amint a törmelék között szaglásztam. Így hát azt mondtam, csatlakozni akarok hozzájuk, és kivártam a pillanatot, amikor észrevétlenül leléphetek.  </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PICK_REASONING_W_2</LocID>        <Text>Szerintem a csend már nem opció.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PICK_REASONING_P_2</LocID>        <Text>Persze, de ne aggódj. Az Öreg Pick tudja, melyik végén kell fogni a kalapácsot.</Text>  </GameDBLocalizedString>

            <!--First Fossorian hero defeated -->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_ELEVATOR_INFO_P_1</LocID>         <Text>Most, hogy a miénk a bázis, esélyünk nyílik arra, hogy utat törjünk a felszínre vezető liftig. </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_ELEVATOR_INFO_W_1</LocID>         <Text>És ha már felértünk a felszínre?  </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_ELEVATOR_INFO_P_2</LocID>         <Text>Nem lesz ez könnyebb, leányom, de vannak embereim és egy gyors hajóm, amit a sziklák között rejtettem el.  </Text>  </GameDBLocalizedString>
            
            <!-- After they escape the underground, Se-Wari disscus with Pick their nex move.-->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SURFACE_RH_1</LocID>              <Text>A felszín! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SURFACE_W_1</LocID>               <Text>A fenébe, ez elég messze van attól a helytől, ahol a húgomat és engem elszakítottak egymástól.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SURFACE_P_1</LocID>               <Text>Nincs olyan messze, de ismerem a környéket, és csak hajóval lehet odajutni.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SURFACE_P_2</LocID>               <Text>Nos, ideje felvenni a kapcsolatot a csapatommal. Remélem, nem léptek le, amíg én ott lent ragadtam.  </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SURFACE_P_3</LocID>               <Text>Freddie, Alfa, ti lusta, nyomorult rohadékok! Veszitek az adást? </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SURFACE_FREDDIE_1</LocID>         <Text>Értettük, főnök! Sosem mennénk el nélküled! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SURFACE_ALFA_1</LocID>            <Text>Szóval, töröljem azt az egyhetes felvételt, amin arról nyafogsz, hogy el akarsz repülni, Freddie?   </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SURFACE_FREDDIE_2</LocID>         <Text>Hé, Alfa! Baszódj meg! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SURFACE_P_4</LocID>               <Text>Fogjátok be a szátokat, idióták! Felétek tartunk. </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SURFACE_ALFA_2</LocID>            <Text>Ti így többesben?  </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SURFACE_P_5</LocID>               <Text>Igen, társaságom van. Egy Xenauri..</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SURFACE_FREDDIE_3</LocID>         <Text>Egy Xenauri?   </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SURFACE_ALFA_3</LocID>            <Text>Az idegenek, Freddie! Egy hete semmi másról nem zeng a Szuverén Flotta Hálózata. Talán ha nem egész nap Tetrist játszanál......  </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SURFACE_FREDDIE_4</LocID>         <Text>...Egyszerűen muszáj folyton zavarba hoznod, Alfa.... </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SURFACE_P_6</LocID>               <Text>[A kommunikátor kikapcsolásának kattanása]... Azt a kettőt akciósan vettem... sérült áru volt. </Text>  </GameDBLocalizedString>
            
            <!--Our heroes discover a second Xenauri base. -->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SURFACE_BASE_RH_1</LocID>         <Text>Egy újabb hely, ahová a Földtúrók a törmeléket halmozták. Ideális pont egy újabb bázis létesítéséhez.</Text>  </GameDBLocalizedString>

            <!--Suddenly, a radio transmission starts. The Pathfinder briefly appears on screen.-->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PATH_CALL_PATHFINDER_1</LocID>    <Text>[Jeltorzulások]... Az Altári Gárdám ... [Jeltorzulások] ... zavaros ... [Jeltorzulások] ... ennek a rendszernek a hetedik bolygója ... [Jeltorzulások] ... a koordináták 0-6-0-3... </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PATH_CALL_P_1</LocID>             <Text>A hetedik bolygó. Ez a Kimérát jelenti! De ki volt ő? </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PATH_CALL_W_1</LocID>             <Text>A Nyomkereső. A Kristályszentély őrzője. Ő és az Altári Gárda egyesítették szülőbolygóm klánjait.    </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PATH_CALL_P_2</LocID>             <Text>Tehát ő valami olyan, mint a legerősebb az Altáriak közt?</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PATH_CALL_W_3</LocID>             <Text>Nem, ő nem az. De az Altári Gárdája fanatikusan hűséges hozzá. </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PATH_CALL_P_3</LocID>             <Text>Érdekes.</Text>  </GameDBLocalizedString>


            <!--Suddenly, a radio transmission starts. The Se-Tri briefly appears on screen.-->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SETRI_CALL_SETRI_1</LocID>        <Text>...[Jeltorzulások]...</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SETRI_CALL_W_1</LocID>            <Text>Se-Tri?!... A fenébe! Megint elhallgatott! Biztosan még mindig ott rekedt valahol az északi parton! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SETRI_CALL_P_1</LocID>            <Text>Aggódni látszol. Nem azt mondtad, hogy ő egy Altári? </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SETRI_CALL_W_2</LocID>            <Text>Igen, de valami megváltozott benne, miután megsemmisült az Anyahajónk.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SETRI_CALL_P_2</LocID>            <Text>Mintha elvesztette volna a pszionikus képességeit? </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SETRI_CALL_W_3</LocID>            <Text>Nem, de zavarodottnak, sőt, ijedtnek tűnt... Amióta csatlakozott az Őrséghez, szinte elfelejtettem, hogy képes félni... Annyit változott... Miért kérdezősködsz ennyit felőle?</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SETRI_CALL_P_4</LocID>            <Text>Csak kíváncsi vagyok, ennyi az egész. </Text>  </GameDBLocalizedString>

            <!--Se-Wari approach a crystal biom part of the map.-->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_CRYSTALS_W_1</LocID>              <Text>Azok a kristályok a bolygómra emlékeztetnek. Kristályhegyek, kristálysivatagok, kristálybarlangok... nagyjából ennyi az egész. Kristályok és Ssaari gyíkok.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_CRYSTALS_P_2</LocID>              <Text>A te világod kemény helynek tűnik az élethez.  </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_CRYSTALS_W_2</LocID>              <Text>Igen, lényegében halott. De a régi festmények hasonlítanak arra, amit itt látok. Fák, fű, sziklák, víz... sőt, még azokra a különös monolitokra is, amiket most nézünk.        </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_CRYSTALS_P_3</LocID>              <Text>Az Ősiek romjai? A bolygótokon?</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_CRYSTALS_W_3</LocID>              <Text>De csak azokon a festményeken. Kristályok, ameddig a szem ellát... ez az egyetlen világ, amelyet ismerek. </Text>  </GameDBLocalizedString>

            <!--Near the Pick's ship.-->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEW_CONFESSION_P_1</LocID>        <Text>A hajó! Nem messze van! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEW_CONFESSION_W_1</LocID>        <Text>Pick, nem voltam teljesen őszinte veled. A Xenauri Anyahajó ereklyéi......</Text>  </GameDBLocalizedString>

            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEW_CONFESSION_P_2</LocID>        <Text>Nem fognak működni....</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEW_CONFESSION_W_2</LocID>        <Text>Honnan tudod?</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEW_CONFESSION_P_3</LocID>        <Text>Ha nem látunk kezelőfelületet, az még nem jelenti azt, hogy nincs is. Márpedig egy pszíker... akarom mondani, egy Altári olyasmit is láthat, amit mások nem, igaz? </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEW_CONFESSION_W_3</LocID>        <Text>Igen... szóval miért segítesz nekem? </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEW_CONFESSION_P_4</LocID>        <Text>Okos leány. Kedvellek, de ez nem jelenti azt, hogy barátok vagyunk... van még egy ok is. Elmagyarázom, amint biztonságban leszünk a hajón.</Text>  </GameDBLocalizedString>
            
            <!--At the surface, our heroes encounter Long Molly a Fossorian main commander of the area.  -->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SHIP_FOSS_BASES_MOLLY_1</LocID>   <Text>Ti ketten, idióták, mindent tönkretettetek! Lángokban áll a földalatti bázisom! A Földtúróim által összegyűjtött ereklyék értéktelenek, ráadásul hírek érkeztek arról, hogy ENN-hajók tartózkodnak a fejünk felett, geostacionárius pályán! A Pörölyömet merném rátenni, hogy ez is a ti művetek.!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SHIP_FOSS_BASES_P_1</LocID>       <Text>Az ENN?! Soha nem dolgoznék nekik!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SHIP_FOSS_BASES_MOLLY_2</LocID>   <Text>Ez a hazugság akkora, mint a Pörölyöm! De nem vagyok ám hülye! Tudom, hogy valahol a közelben rejtegetsz egy űrhajót! Ha felszállsz, a légvédelmi ágyúim leszednek!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SHIP_FOSS_BASES_P_2</LocID>       <Text>A légvédelmi ágyúk problémát fognak jelenteni, és azok az ENN-hajók is.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SHIP_FOSS_BASES_W_2</LocID>       <Text>ENN? </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SHIP_FOSS_BASES_P_3</LocID>       <Text>A legnagyobb idióták gyülekezete, akik azt hiszik, ők irányítanak itt mindent. De a Hercegnő rövid pórázon tartja őket. Legalábbis egyelőre. </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SHIP_FOSS_BASES_W_3</LocID>       <Text>Ki ez a Hercegnő?? </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SHIP_FOSS_BASES_P_4</LocID>       <Text>Egy hatalmas erejű idegen Pszí-használó... akárcsak a ti Altárijaitok! De ne aggódj, túl kicsi halak vagyunk az ő horgára. Elég a fecsegésből! Azok a légvédelmi ágyúk nem fogják magukat hatástalanítani. </Text>  </GameDBLocalizedString>

            <!--Both Fossorian bases are conquered.  -->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SHIP_FLY_RH_1</LocID>             <Text>A bázisok a mieink! A légvédelmi ágyúk harcképtelenek! Most már felszállhatunk! </Text>  </GameDBLocalizedString>

            <!--Long Molly is defeated. -->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_MOLLY_AF_MOLLY_1</LocID>          <Text>Valahányszor kiépítek magamnak egy pozíciót, megjelennek valami idióták, és mindent tönkretesznek!</Text>  </GameDBLocalizedString>

            <!--The first Fossorian base is conquered. -->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_LAST_BASE_RH_1</LocID>            <Text>Már csak egy bázis maradt.</Text>  </GameDBLocalizedString>

            <!--Molly spawns before the remaining Fossorian base to face our heroes. -->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_MOLLY_SPAWN_RH_1</LocID>          <Text>Az utolsó bázis! Ha a légvédelem elhallgat, kirepülhetünk! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_MOLLY_SPAWN_MOLLY_1</LocID>       <Text>Nem, amíg a Pörölyömnek is van ebbe beleszólása! </Text>  </GameDBLocalizedString>
            
            <!--The Pick's ship was reached by one of the heroes before the both Fossorian bases were conquered.  -->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_CANNOT_BOARD_RH_1</LocID>         <Text>Még nem lehet megkezdeni a fedélzetre szállást. A Földtúró bázisok légvédelmi ágyúi még mindig aktívak. </Text>  </GameDBLocalizedString>
            
            <!--The Pick's ship was reached by one of the heroes after the both Fossorian bases were conquered.  -->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_NEAR_SHIP_RH_1</LocID>            <Text>Eljutottam a hajóhoz.. </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_NEAR_SHIP_RH_2</LocID>            <Text>Rendben, szállj fel, és várj meg.</Text>  </GameDBLocalizedString>

            <!--End, our heroes speaks on board of the Pick's ship. Freddi and Alfa are also present on board. -->
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_P_1</LocID>                   <Text>Hé, kölykök! Itthon van Pick bácsi... Vedd le a koszos lábad a navigációs számítógépről, Freddie!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_FREDDIE_1</LocID>             <Text>Igen, kapitányom, admirálisom, mindenható főnököm.!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_ALFA_1</LocID>                <Text>Jó, ti ketten megcsináltátok. Amíg vártunk, rengeteg Ereklyét gyűjtöttünk össze a Xenauri hajó roncsaiból. De... </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_FREDDIE_2</LocID>             <Text>...basszus, nincs gomb, amivel csavarozhatna, főnök!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_ALFA_2</LocID>                <Text>De hát éppen ezért hoztad el a Xenaurit, nem?</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_P_2</LocID>                   <Text>Felejtsd el egyelőre a Xenauri-ügyet! Előbb ki kell derítenünk, mi történt a húgával. Északra kell jutnom....  </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_FREDDIE_3</LocID>             <Text>Igen, hát... NEM. Ez nem történik meg, főnök. </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_P_3</LocID>                   <Text>Nos, Freddie, világosíts fel, hogy miért!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_ALFA_3</LocID>                <Text>Az ENN erői átvették az egész északi partot...</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_FREDDIE_4</LocID>             <Text>A Chiquita! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_P_4</LocID>                   <Text>A Chiquita, mi a fene?! Rohadt banánok?! Hagyd abba a találomra történő kiabálást, és tégy úgy, mintha elvégezted volna az óvodát!! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_FREDDIE_5</LocID>             <Text>A Chiquita velük szállt le. És találjátok ki, ki vezette azt a hajót? A kibaszott Hercegnő! Három méter magas, kitinnel, pszionikus erőkkel! Egyszer találkoztam vele, és......</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_ALFA_4</LocID>                <Text>...A nadrágod sosem lehet már a régi. Ezt mindannyian tudjuk, Freddie. De a Hercegnő nem sokkal később távozott.! </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_W_2</LocID>                   <Text>A Hercegnő bizonyára megérezte Se-Tri pszionikus képességeit, és elfogta őt!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_P_5</LocID>                   <Text>Ezt először ellenőriznünk kell. De attól tartok, telibe találtál, leányom. Ki kell derítenünk, hová vitte őt a Hercegnő. </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_FREDDIE_6</LocID>             <Text>Micsoda?! Miért?!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_P_6</LocID>                   <Text>Fogd be, Freddie... A húga egy Altári, ami azt jelenti, hogy hatalmas Pszí-képességekkel rendelkezik! Eddig a Hercegnőé volt a „mágia” monopóliuma! Ezen változtatni kell!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_W_3</LocID>                   <Text>Szóval ez az igazi ok! Ezért kérdezgetett folyton az Altáriakról és a nővéremről!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_P_7</LocID>                   <Text>Pszionikus képességeinek köszönhetően a Hercegnő teljes körű ellenőrzést gyakorol a távolsági űrutazás felett. Így hatalma van a rendszer minden jelentős frakciója felett. </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_ALFA_5</LocID>                <Text>Én sem kedvelem őt, de a frakciók beszüntettek minden jelentősebb harcot, miután átvette az irányítást.</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_P_8</LocID>                   <Text>De hogy meddig tart a béke, csak rajta múlik! Képzeld el, mindenki oda utazhat, ahová csak akar! Új világok várnak felfedezésre odafent! Az lenne......  </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_FREDDIE_7</LocID>            <Text>A legcsillogóbb Szuverén Flotta-béli álom, amely valóra vált!</Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_ALFA_6</LocID>                <Text>És a Xenauri Pszí-használók jelentik a kulcsot. </Text>  </GameDBLocalizedString>
            <GameDBLocalizedString>         <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_W_4</LocID>                   <Text>Pick, Én ...   </Text>  </GameDBLocalizedString>
