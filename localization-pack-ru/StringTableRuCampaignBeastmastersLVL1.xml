<?xml version="1.0" encoding="utf-8"?>
<Database>
  <GameDBStringTable ID="LOC_RU_CAMPAIGN_BEASTMASTERS_LVL1">
    <LanguageRef>LANG_RU</LanguageRef>
    <Contributors>
      <Name>Rewalon</Name>
    </Contributors>
    <LocalizedStrings>
      <!--OBJECTIVES MAIN QUESTS-->
      <GameDBLocalizedString>
        <LocID>OBJECTIVE_CAMPAIGN_BEASTMASTERS_LVL1_START</LocID>
        <Text>Начать наступление</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>OBJECTIVE_CAMPAIGN_BEASTMASTERS_LVL1_SECOND_BASE_1</LocID>
        <Text>Атаковать опорные пункты Детей Источника 0/2</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>OBJECTIVE_CAMPAIGN_BEASTMASTERS_LVL1_SECOND_BASE_2</LocID>
        <Text>Атаковать опорные пункты Детей Источника 1/2</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>OBJECTIVE_CAMPAIGN_BEASTMASTERS_LVL1_GET_SETRI_TO_ELEVATOR</LocID>
        <Text>Добраться до орбитального телепорта</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>OBJECTIVE_CAMPAIGN_BEASTMASTERS_LVL1_RETAKE_X_BASE</LocID>
        <Text>Захватить базу Ксенаури</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>OBJECTIVE_CAMPAIGN_BEASTMASTERS_LVL1_RETAKE_X_BASE_DONE</LocID>
        <Text><![CDATA[<color=SOTS_COLOR_MOVEMENT>Захватить базу Ксенаури - ВЫПОЛНЕНО</color>]]></Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>OBJECTIVE_CAMPAIGN_BEASTMASTERS_LVL1_FIND_WAY_SURFACE</LocID>
        <Text>Выбраться из подземелья</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>OBJECTIVE_CAMPAIGN_BEASTMASTERS_LVL1_FIND_WAY_SURFACE_DONE</LocID>
        <Text><![CDATA[<color=SOTS_COLOR_MOVEMENT>Выбраться из подземелья - ВЫПОЛНЕНО</color>]]></Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>OBJECTIVE_CAMPAIGN_BEASTMASTERS_LVL1_INBARK_1</LocID>
        <Text>Посадить командиров на корабль 0/2</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>OBJECTIVE_CAMPAIGN_BEASTMASTERS_LVL1_INBARK_2</LocID>
        <Text>Посадить командиров на корабль 1/2</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>OBJECTIVE_CAMPAIGN_BEASTMASTERS_LVL1_FOS_BASE_1</LocID>
        <Text>Захватить базы Фоссорианцев 0/3</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>OBJECTIVE_CAMPAIGN_BEASTMASTERS_LVL1_FOS_BASE_2</LocID>
        <Text>Захватить базы Фоссорианцев 1/3</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>OBJECTIVE_CAMPAIGN_BEASTMASTERS_LVL1_FOS_BASE_3</LocID>
        <Text>Захватить базы Фоссорианцев 2/3</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>OBJECTIVE_CAMPAIGN_BEASTMASTERS_LVL1_FOS_BASE_4</LocID>
        <Text><![CDATA[<color=SOTS_COLOR_MOVEMENT>Захватить базы Фоссорианцев 3/3 - ВЫПОЛНЕНО</color>]]></Text>
      </GameDBLocalizedString>
      <!--DIALOGUES-->
      <!--Se-Wari and Se-Tri are standing near their base.   -->
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_START_NARRATOR_0</LocID>
        <Text>События DLC "Всадники Ксенаури" происходят после кампании оригинальной игры "Молчание Сирены"</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_START_NARRATOR_1</LocID>
        <Text>Планета Сцилла, неподалёку от только что развёрнутой передовой базы десанта Ксенаури. </Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_START_T_1</LocID>
        <Text>Бросайте инструменты! Мы переходим в наступление! Буря началась!</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_START_W_1</LocID>
        <Text>Это безумие! Мы только начали строить лагерь! Мы не готовы!</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_START_T_2</LocID>
        <Text>Молчать! Ты говоришь с гвардией Альтари Следопыта!</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_START_W_2</LocID>
        <Text>Разве я могла бы забыть, сестра?</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_START_T_3</LocID>
        <Text>Что это сейчас было?</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_START_W_3</LocID>
        <Text>Ничего, Владыка.</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_START_T_4</LocID>
        <Text>Нам поручено захватить опорные пункты Железного Насекомого...</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_START_T_5</LocID>
        <Text>... и здесь. Я поведу атаку. Потерпеть неудачу - значит предать Следопыта!</Text>
      </GameDBLocalizedString>
<!--
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_START_T_5</LocID>
        <Text>... и здесь. Я поведу атаку. Ты займёшься логистикой! Потерпеть неудачу - значит предать Следопыта!</Text>
      </GameDBLocalizedString>
-->
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_START_W_4</LocID>
        <Text>[ШЁПОТОМ ПРО СЕБЯ] Прямо как настоящие фанатики.</Text>
      </GameDBLocalizedString>
      <!--First encounter with the Iron Insect warrior (Children of the Source) hero.-->
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_CHILDREN_ENC_RH_1</LocID>
        <Text>Это воин Железного Насекомого!</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_CHILDREN_ENC_KNIGHT_1</LocID>
        <Text>[ГОВОРИТ НА НЕЗНАКОМОМ ЯЗЫКЕ, С ЛЕГКИМ МЕТАЛЛИЧЕСКИМ ИСКАЖЕНИЕМ]</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_CHILDREN_ENC_W_1</LocID>
        <Text>Он пытается вести переговоры? Может, мы могли бы найти способ договориться!</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_CHILDREN_ENC_T_2</LocID>
        <Text>Это просто безмозглые роботы! Следопыт приказал их истребить!</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_CHILDREN_ENC_W_2</LocID>
        <Text>И с того самого дня, как ты вступила в гвардию Следопыта, его слово стало законом. [ШЁПОТОМ ПРО СЕБЯ] Каким бы абсурдным он ни был.</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_CHILDREN_ENC_KNIGHT_2</LocID>
        <Text>[РЕЗКИЙ ЛЯЗГ МЕТАЛЛА]</Text>
      </GameDBLocalizedString>
      <!--Iron Insect warrior is defeated.-->
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_ARTAR_DEFEATED_W_1</LocID>
        <Text>Покойся с миром, воин Железного Насекомого. Надеюсь, ты найдёшь покой.</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_ARTAR_DEFEATED_T_1</LocID>
        <Text>Железным Насекомым не устоять против гвардии Альтари Следопыта!</Text>
      </GameDBLocalizedString>
      <!--First base of the Children of the Source is conquered.  -->
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_FIRST_FORTRESS_IS_CONQUERED_RH_1</LocID>
        <Text>Первый опорный пункт наш!</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_FIRST_FORTRESS_IS_CONQUERED_T_2</LocID>
        <Text>Первый опорный пункт был взят именем Следопыта. Как только мы захватим второй, берег будет наш!</Text>
      </GameDBLocalizedString>
      <!--At the start of the next game turn, Se-Wari notise a bright flash in the sky. -->
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_EXPLOSION_FORESHADOWED_W_1</LocID>
        <Text>Я вижу яркие вспышки в облаках над нами! Но я никогда не видел такой бури!</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_EXPLOSION_FORESHADOWED_T_1</LocID>
        <Text>Это не буря, болван! Это Материнский Корабль! Он бьёт по соседнему сектору! </Text>
      </GameDBLocalizedString>
      <!--At the start of the next game turn, flashes intensifies. -->
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SETRI_SUMMONED_W_</LocID>
        <Text>Вспышки усилились!</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SETRI_SUMMONED_T_1</LocID>
        <Text>Материнский Корабль атакуют!</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SETRI_SUMMONED_W_2</LocID>
        <Text>Как ты это понял отсюда?!</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SETRI_SUMMONED_T_3</LocID>
        <Text>Связь... Мне нужно вернуться на корабль... к Кристальной Святыне!</Text>
      </GameDBLocalizedString>
      <!--Se-Tri arrives to the teleport but befor she can enter and debris from the Mothership struck the place. She teleports Se-Wari out of harms way just in time.  -->
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_TELEPORT_CRASH_RH_1</LocID>
        <Text>Мы почти на месте... ЧТО?! ЭТА ВСПЫШКА СЛИШКОМ ЯРКАЯ ДЛЯ ЛЮБОГО ОРУЖИЯ!</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_TELEPORT_CRASH_T_1</LocID>
        <Text>Материнский Корабль! Связь с Кристальной Святыней! ... Мне что-то нехорошо.</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_TELEPORT_CRASH_W_1</LocID>
        <Text>Се-Три?... Ты в порядке?</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_TELEPORT_CRASH_T_3</LocID>
        <Text>Нет... Я не... Где я?! Не приближайся!</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_TELEPORT_CRASH_W_3</LocID>
        <Text>Се-Три, я... что это там свистит?!</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_TELEPORT_CRASH_W_4</LocID>
        <Text>Что-то падает прямо на нас!</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_TELEPORT_CRASH_T_4</LocID>
        <Text>Нет!</Text>
      </GameDBLocalizedString>
      <!--Se-Wari appears in the underground and is immediately surrounded by Fossorians.-->
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEWARI_CAPTURED_W_1</LocID>
        <Text>Она что, только что телепортировала меня в безопасное место?</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEWARI_CAPTURED_FOSSORIAN_2</LocID>
        <Text>[ГОВОРИТ НА ЧУЖОМ ЯЗЫКЕ, СЛЕГКА ИСКАЖЁННОМ НЕЧЕЛОВЕЧЕСКОЙ ФОРМОЙ РТА]</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEWARI_CAPTURED_W_2</LocID>
        <Text>Или, возможно, прямо в другую передрягу.</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEWARI_CAPTURED_W_3</LocID>
        <Text>Большие неприятности!</Text>
      </GameDBLocalizedString>
      <!--In a small cave Se-Wari chat with Captain Pick (the only Sovereign fleet hero of Fossorain descend). In the middle of the conversation the Fossorian hero Bokas arrives. -->
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PICK_AND_SEWARI_NARRATOR_1</LocID>
        <Text>Несколько дней спустя. Глубоко под землёй.</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PICK_AND_SEWARI_P_1.5</LocID>
        <Text>...ты быстро учишься, девочка, но...</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PICK_AND_SEWARI_BOKAS_1</LocID>
        <Text>Я плачу тебе не за разговоры, Пик! Ты должен выпытать у неё всё об артефактах!</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PICK_AND_SEWARI_W_2</LocID>
        <Text>Артефакты?      </Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PICK_AND_SEWARI_P_3</LocID>
        <Text>Технологии Ксенаури, обнаруженные среди обломков твоего Материнского Корабля...</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PICK_AND_SEWARI_W_5</LocID>
        <Text>Обломки! Значит, Материнский Корабль уничтожен?!..  </Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PICK_AND_SEWARI_BOKAS_2</LocID>
        <Text>Заткнитесь, вы двое! Меня интересуют только артефакты! Никто не знает, как ими пользоваться!</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PICK_AND_SEWARI_W_6</LocID>
        <Text>Но я ничем не могу помочь...</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PICK_AND_SEWARI_BOKAS_3</LocID>
        <Text>Боль развяжет тебе язык!!!</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PICK_AND_SEWARI_W_7</LocID>
        <Text>ПРЕКРАТИ! МНЕ БОЛЬНО!</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PICK_AND_SEWARI_BOKAS_4</LocID>
        <Text>Ты сама во всём виновата!</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PICK_AND_SEWARI_P_9</LocID>
        <Text>Довольно, Бокас! Остановись!</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PICK_AND_SEWARI_P_10</LocID>
        <Text>Я сказал СТОП!</Text>
      </GameDBLocalizedString>
      <!--Pick decide to help Se-Wari and they defeat Bokas.  -->
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEWARI_LIBERATED_BOKAS_1</LocID>
        <Text>[В РАЦИЮ] Друзья, на помощь! Заключённые сбегают!</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEWARI_LIBERATED_TOTT_1</LocID>
        <Text>Кого это ты называешь другом, ублюдок?!</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEWARI_LIBERATED_MOLTAIR_1</LocID>
        <Text>Да, ты, вонючая куча червячного навоза!</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEWARI_LIBERATED_BENI_1</LocID>
        <Text>Я иду к тебе на помощь, Бокас, мой дражайший друг!</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEWARI_LIBERATED_BOKAS_3</LocID>
        <Text>А вот хрен тебе! Лучше сдохнуть, чем принять помощь от уродливого полукровки!</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEWARI_LIBERATED_P_1</LocID>
        <Text>[ЩЕЛЧОК ОТКЛЮЧАЕМОГО ПЕРЕГОВОРНИКА] ...Так-то лучше.</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEWARI_LIBERATED_W_1</LocID>
        <Text>Пик, я...</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEWARI_LIBERATED_P_2</LocID>
        <Text>Оставь благодарности, девочка. Ты мне нравишься, но это не значит, что мы друзья... Я тоже охочусь за артефактами Ксенаури. Я вытащу тебя, ты научишь меня ими пользоваться. Идёт?  </Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEWARI_LIBERATED_W_2</LocID>
        <Text>Я расскажу тебе всё, что знаю... при одном условии: ты поможешь мне найти мою сестру. Она Альтари, так что с ней всё будет в порядке... Но я должна быть уверена.</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEWARI_LIBERATED_P_3</LocID>
        <Text>Альтари?</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEWARI_LIBERATED_W_3</LocID>
        <Text>Это нечто вроде псайкера. К тому же она из гвардии Альтари Следопыта, так что талант у неё исключительный.</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEWARI_LIBERATED_P_4</LocID>
        <Text>Псайкер, говоришь... Ладно! Договорились... Мои пушистые сородичи вытащили столько обломков с твоего Материнского Корабля, что мы можем начать строить базу прямо здесь!</Text>
      </GameDBLocalizedString>
      <!--At the start of the next game turn, Se-Wari asks Pick how he joined Fossorians. -->
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PICK_REASONING_W_1</LocID>
        <Text>Погоди, ты ведь говорил, что тебя наняли меня обучать?</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PICK_REASONING_P_1</LocID>
        <Text>Они поймали меня, когда я вынюхивал вокруг обломков. Так что я сказал, что хочу к ним присоединиться, и ждал удобного момента, чтобы тихо исчезнуть.</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PICK_REASONING_W_2</LocID>
        <Text>Кажется, тихо свалить не получится.</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PICK_REASONING_P_2</LocID>
        <Text>Да, но не волнуйся. Старина Пик знает, каким концом держать молоток.</Text>
      </GameDBLocalizedString>
      <!--First Fossorian hero defeated -->
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_ELEVATOR_INFO_P_1</LocID>
        <Text>Теперь, когда база наша, мы можем попробовать пробиться с боем к лифту, что ведёт на поверхность.</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_ELEVATOR_INFO_W_1</LocID>
        <Text>А что потом, когда выберемся на поверхность?</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_ELEVATOR_INFO_P_2</LocID>
        <Text>Проще не станет, девочка, но у меня в скалах припрятаны пара товарищей по экипажу и быстроходный корабль.</Text>
      </GameDBLocalizedString>
      <!-- After they escape the underground, Se-Wari disscus with Pick their nex move.-->
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SURFACE_RH_1</LocID>
        <Text>Поверхность!</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SURFACE_W_1</LocID>
        <Text>Чёрт, это довольно далеко от того места, где мы с сестрой расстались.</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SURFACE_P_1</LocID>
        <Text>Не так уж и далеко. К тому же я знаю эти края, а добраться туда можно только на корабле.</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SURFACE_P_2</LocID>
        <Text>Что ж, пора связаться с командой. Надеюсь, они не удрали, пока я застрял здесь внизу.</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SURFACE_P_3</LocID>
        <Text>Фредди, Альфа, вы ленивые, жалкие придурки! Слышите меня?</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SURFACE_FREDDIE_1</LocID>
        <Text>Слышим тебя, босс! Мы бы никогда не ушли без тебя!</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SURFACE_ALFA_1</LocID>
        <Text>Так что, мне удалить недельную запись того, как ты ноешь о желании улететь, Фредди?</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SURFACE_FREDDIE_2</LocID>
        <Text>Эй, Альфа! Да пошёл ты!</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SURFACE_P_4</LocID>
        <Text>Заткнитесь, имбецилы! Мы направляемся к вам.</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SURFACE_ALFA_2</LocID>
        <Text>Мы?  </Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SURFACE_P_5</LocID>
        <Text>Ага, я тут не один. Со мной Ксенаури.</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SURFACE_FREDDIE_3</LocID>
        <Text>Ксенаури?   </Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SURFACE_ALFA_3</LocID>
        <Text>Пришельцы, Фредди! Сеть Суверенов уже неделю только о них и гудит. Может, если бы ты не играл в Тетрис целыми днями напролёт...</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SURFACE_FREDDIE_4</LocID>
        <Text>...тебе просто обязательно меня позорить, Альфа...</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SURFACE_P_6</LocID>
        <Text>[ЩЕЛЧОК ОТКЛЮЧАЕМОГО ПЕРЕГОВОРНИКА]... Я взял этих двоих со скидкой... бракованный товар.</Text>
      </GameDBLocalizedString>
      <!--Our heroes discover a second Xenauri base. -->
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SURFACE_BASE_RH_1</LocID>
        <Text>Ещё одно место, где Фоссорианцы свалили обломки. Идеальная точка, чтобы основать очередную базу.</Text>
      </GameDBLocalizedString>
      <!--Suddenly, a radio transmission starts. The Pathfinder briefly appears on screen.-->
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PATH_CALL_PATHFINDER_1</LocID>
        <Text>[ПОМЕХИ]... Моя гвардия Альтари ... [ПОМЕХИ] ... растеряна ... [ПОМЕХИ] ... седьмая планета системы ... [ПОМЕХИ] ... координаты 0-6-0-3...</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PATH_CALL_P_1</LocID>
        <Text>Седьмая планета. Значит, Химера! Но кто это был?</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PATH_CALL_W_1</LocID>
        <Text>Следопыт. Хранитель Кристальной Святыни. Он и его гвардия Альтари объединили кланы моего родного мира.   </Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PATH_CALL_P_2</LocID>
        <Text>Выходит, он чуть ли не сильнейший из Альтари?</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PATH_CALL_W_3</LocID>
        <Text>Нет, вовсе нет. Зато его гвардия Альтари предана ему фанатично.</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_PATH_CALL_P_3</LocID>
        <Text>Интересно.</Text>
      </GameDBLocalizedString>
      <!--Suddenly, a radio transmission starts. The Se-Tri briefly appears on screen.-->
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SETRI_CALL_SETRI_1</LocID>
        <Text>...[ПОМЕХИ]...</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SETRI_CALL_W_1</LocID>
        <Text>Се-Три?!.. Чёрт! Снова тишина! Она, должно быть, всё ещё застряла где-то на северном берегу!</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SETRI_CALL_P_1</LocID>
        <Text>Ты выглядишь обеспокоенной. Разве ты не говорила, что она Альтари?</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SETRI_CALL_W_2</LocID>
        <Text>Да, но после уничтожения нашего Материнского Корабля в ней что-то изменилось.</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SETRI_CALL_P_2</LocID>
        <Text>Как будто она потеряла свои псионические способности?</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SETRI_CALL_W_3</LocID>
        <Text>Нет, но она казалась растерянной, даже напуганной... С тех пор как она вступила в гвардию, я почти забыла, что она может бояться... Она так изменилась... Почему так много вопросов о ней?</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SETRI_CALL_P_4</LocID>
        <Text>Просто любопытно, вот и всё.</Text>
      </GameDBLocalizedString>
      <!--Se-Wari approach a crystal biom part of the map.-->
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_CRYSTALS_W_1</LocID>
        <Text>Эти кристаллы напоминают мне мою планету. Кристальные горы, кристальные пустыни, кристальные пещеры... вот, собственно, и всё. Кристаллы и ящерицы Ссаари.</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_CRYSTALS_P_2</LocID>
        <Text>Твой мир, похоже, суровое место для жизни.</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_CRYSTALS_W_2</LocID>
        <Text>Да, он практически мёртв. Но старые картины похожи на то, что я вижу здесь. Деревья, трава, камни, вода... даже странные монолиты, на которые мы сейчас смотрим.    </Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_CRYSTALS_P_3</LocID>
        <Text>Руины древних Предтеч? На твоей планете?</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_CRYSTALS_W_3</LocID>
        <Text>Но только на тех картинах. Кристаллы, куда ни глянь... это единственный мир, который я знаю.</Text>
      </GameDBLocalizedString>
      <!--Near the Pick's ship.-->
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEW_CONFESSION_P_1</LocID>
        <Text>Корабль! Он совсем рядом!</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEW_CONFESSION_W_1</LocID>
        <Text>Пик, я была не совсем честна с тобой. Артефакты с Материнского Корабля Ксенаури...</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEW_CONFESSION_P_2</LocID>
        <Text>Они бесполезны...</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEW_CONFESSION_W_2</LocID>
        <Text>Откуда ты знаешь?</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEW_CONFESSION_P_3</LocID>
        <Text>То, что мы не видим интерфейса, ещё не значит, что его нет. А псайкер... то есть Альтари, может видеть то, что другим недоступно, верно?</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEW_CONFESSION_W_3</LocID>
        <Text>Да... так почему ты помогаешь мне?</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SEW_CONFESSION_P_4</LocID>
        <Text>Умна, девочка. Ты мне по душе, но это ещё не делает нас друзьями... И есть ещё одна причина. Расскажу, когда доберёмся до корабля и окажемся в безопасности.</Text>
      </GameDBLocalizedString>
      <!--At the surface, our heroes encounter Long Molly a Fossorian main commander of the area.  -->
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SHIP_FOSS_BASES_MOLLY_1</LocID>
        <Text>Это вы, два идиота, всё разрушили! Моя подземная база объята пламенем! Артефакты, что собрали мои Фоссорианцы, теперь бесполезны, и вдобавок приходят донесения о кораблях UNSS на геостационарной орбите над нами! Готова поставить свой молот, что это тоже ваша работа!</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SHIP_FOSS_BASES_P_1</LocID>
        <Text>UNSS?! Я бы никогда на них не работал!</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SHIP_FOSS_BASES_MOLLY_2</LocID>
        <Text>Эта ложь не меньше моего молота! Но я не дура! Мне известно, что где-то рядом у тебя припрятан корабль! Если ты взлетишь, мои зенитки собьют тебя!</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SHIP_FOSS_BASES_P_2</LocID>
        <Text>Зенитки будут проблемой, да и те корабли UNSS тоже.</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SHIP_FOSS_BASES_W_2</LocID>
        <Text>UNSS? </Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SHIP_FOSS_BASES_P_3</LocID>
        <Text>Самая большая свора идиотов, которые думают, что всем тут управляют. Но Принцесса держит их на коротком поводке. По крайней мере, пока.</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SHIP_FOSS_BASES_W_3</LocID>
        <Text>Кто такая эта Принцесса?</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SHIP_FOSS_BASES_P_4</LocID>
        <Text>Могущественный псайкер-чужеземка... вроде ваших Альтари! Но не волнуйся, мы слишком мелкая рыбка для её крючка. Хватит болтать. Эти зенитки сами себя не обезвредят.</Text>
      </GameDBLocalizedString>
      <!--Both Fossorian bases are conquered.  -->
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_SHIP_FLY_RH_1</LocID>
        <Text>Базы наши! Зенитки обезврежены! Теперь мы можем улетать!</Text>
      </GameDBLocalizedString>
      <!--Long Molly is defeated. -->
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_MOLLY_AF_MOLLY_1</LocID>
        <Text>Каждый раз, когда я строю для себя позицию, появляются какие-то идиоты и всё разрушают!</Text>
      </GameDBLocalizedString>
      <!--The first Fossorian base is conquered. -->
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_LAST_BASE_RH_1</LocID>
        <Text>Осталась только одна база.</Text>
      </GameDBLocalizedString>
      <!--Molly spawns before the remaining Fossorian base to face our heroes. -->
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_MOLLY_SPAWN_RH_1</LocID>
        <Text>Последняя база! Как только ПВО будет подавлено, мы сможем улететь!</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_MOLLY_SPAWN_MOLLY_1</LocID>
        <Text>Не в мою смену, пока мой Молот ещё не сказал своего слова!</Text>
      </GameDBLocalizedString>
      <!--The Pick's ship was reached by one of the heroes before the both Fossorian bases were conquered.  -->
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_CANNOT_BOARD_RH_1</LocID>
        <Text>Пока не можем подняться на борт. Зенитки на базах Фоссорианцев всё ещё активны.</Text>
      </GameDBLocalizedString>
      <!--The Pick's ship was reached by one of the heroes after the both Fossorian bases were conquered.  -->
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_NEAR_SHIP_RH_1</LocID>
        <Text>Я добрался до корабля.</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_NEAR_SHIP_RH_2</LocID>
        <Text>Хорошо, поднимайся на борт и жди меня.</Text>
      </GameDBLocalizedString>
      <!--End, our heroes speaks on board of the Pick's ship. Freddi and Alfa are also present on board. -->
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_P_1</LocID>
        <Text>Эй, ребятня! Дядя Пик явился... Фредди, убери свои грязные лапы с навигационного компьютера!</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_FREDDIE_1</LocID>
        <Text>Да, мой капитан, адмирал, всемогущий босс!</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_ALFA_1</LocID>
        <Text>Отлично, вы оба добрались. Пока ждали, мы натаскали кучу артефактов из обломков корабля Ксенаури. Но...</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_FREDDIE_2</LocID>
        <Text>...чёрт, тут нет кнопок, чтоб понажимать, босс!</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_ALFA_2</LocID>
        <Text>Но для этого ты и притащил Ксенаури, так?</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_P_2</LocID>
        <Text>Забудьте на время про ксенаурское барахло! Сначала нам нужно выяснить, что случилось с её сестрой. Мне нужно попасть на север...</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_FREDDIE_3</LocID>
        <Text>Ага, ну... НЕТ. Так дело не пойдёт, босс.</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_P_3</LocID>
        <Text>И почему же, Фредди? Просвети меня, будь так добр!</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_ALFA_3</LocID>
        <Text>Силы UNSS заняли весь северный берег...</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_FREDDIE_4</LocID>
        <Text>Чикита!</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_P_4</LocID>
        <Text>Чикита что?! Грёбаные бананы?! Хватит выкрикивать случайные слова и строить из себя детсадовца!</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_FREDDIE_5</LocID>
        <Text>Чикита приземлилась вместе с ними. И знаешь, кто вёл корабль? Сама чёртова Принцесса! Три метра ростом, панцирь, псионические силы! Я видел её один раз и...</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_ALFA_4</LocID>
        <Text>...штаны твои, в общем, уже не отстирать. Это мы все помним, Фредди. Но Принцесса вскоре после этого улетела!</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_W_2</LocID>
        <Text>Должно быть, Принцесса почувствовала псионические силы Се-Три и взяла её в плен!</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_P_5</LocID>
        <Text>Сначала мы должны это проверить. Но боюсь, ты попала в точку, девочка. Нам нужно выяснить, куда Принцесса её увезла.</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_FREDDIE_6</LocID>
        <Text>Что?! Почему?!</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_P_6</LocID>
        <Text>Заткнись, Фредди... Её сестра - Альтари, а значит, могущественный псайкер! До сих пор у Принцессы была монополия на "магию"! Пора это изменить!</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_W_3</LocID>
        <Text>Так вот в чём настоящая причина! Вот почему ты всё расспрашивал об Альтари и моей сестре!</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_P_7</LocID>
        <Text>Благодаря своим псионическим способностям Принцесса имеет абсолютный контроль над дальними космическими перелётами. Так она держит власть над каждой крупной фракцией системы.</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_ALFA_5</LocID>
        <Text>Она мне тоже не нравится, но фракции прекратили все крупные бои после того, как она взяла власть.</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_P_8</LocID>
        <Text>Но сколько продлится этот мир зависит только от неё! Представь, если бы все могли путешествовать куда захотят! Там, наверху, новые миры, ждущие своего открытия! Это было бы...</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_FREDDIE_7</LocID>
        <Text>Самая блестящая мечта Суверена, ставшая явью!</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_ALFA_6</LocID>
        <Text>И псайкеры Ксенаури ключ к этому.</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_W_4</LocID>
        <Text>Пик, я...</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_END_P_9</LocID>
        <Text>Оставь благодарности, девочка. Мы только что решили пойти против самого опасного существа в Системе Сирены. Возможно, мы ещё пожалеем об этом, прежде чем всё закончится. </Text>
      </GameDBLocalizedString>
      <!--Enemy FOSSORIAN COMMANDERS - QOUTES-->
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_BENNI_BF_BENNI_1</LocID>
        <Text>Я уничтожу тебя во имя моего друга Бокаса!</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_MOLTAIR_BF_MOLTAIR_1</LocID>
        <Text>Я Молтаир! Бывший командир Дивизии Освободителей! Победитель несметных сражений...</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_MOLTAIR_BF_P_1</LocID>
        <Text>... о котором никто никогда не слышал.</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_MOLTAIR_BF_X_1</LocID>
        <Text>Ты слишком громкая для такого маленького существа!</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_MOLTAIR_BF_MOLTAIR_2</LocID>
        <Text>Аргх!!! Солнца тебе больше не видать!</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_TOTT_BF_QUETIN_1</LocID>
        <Text>Привет, я Кветин из Молетаргиса!</Text>
      </GameDBLocalizedString>
      <GameDBLocalizedString>
        <LocID>MESSAGE_CAMPAIGN_BEASTMASTERS_LVL1_TOTT_BF_TOTT_1</LocID>
        <Text>Твой маленький побег на этом заканчивается!</Text>
      </GameDBLocalizedString>
    </LocalizedStrings>
  </GameDBStringTable>
